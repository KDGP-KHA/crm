@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_InvoicesModel

@Html.AntiForgeryToken()
<div id="Invoices">
    @Html.HiddenFor(model => model.ContractID)
    @Html.HiddenFor(model => model.InvoiceID)
    @Html.HiddenFor(model => model.TotalAmount)
    @Html.HiddenFor(model => model.VAT_Amount)
    @Html.HiddenFor(model => model.TotalPayment)

    <div class="row form-group">
        <div class="col-md-6">
            @Html.TitleFor(model => model.Serial, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.Serial, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Serial_Label") })
            @Html.ValidationMessageFor(model => model.Serial, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
            @Html.TitleFor(model => model.Number, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.Number, new { @class = "form-control int-number", placeholder = AppProcessor.Messagor.GetMessage("Number_Label") })
            @Html.ValidationMessageFor(model => model.Number, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-8">
            @Html.TitleFor(model => model.Buyer, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.Buyer, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Buyer_Label") })
            @Html.ValidationMessageFor(model => model.Buyer, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            @Html.TitleFor(model => model.TaxCode, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.TaxCode, new { @class = "form-control int-number", placeholder = AppProcessor.Messagor.GetMessage("TaxCode_Label") })
            @Html.ValidationMessageFor(model => model.TaxCode, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-4">
            @Html.TitleFor(model => model.VAT_Rate, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.VAT_Rate, new
            {
                @class = "form-control",
                placeholder = "0 – 100",
            })
            @Html.ValidationMessageFor(model => model.VAT_Rate, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-8">
            @Html.TitleFor(model => model.TotalPayment, new { @class = "font-bold" })
            <div class="input-group">
                @Html.TextBox("TotalPayment_View", Model.TotalPayment > 0 ? Model.TotalPayment.ToString("N0") : "", new { @onchange = "fnFormatPayment(); fnTinhToan();", @class = "form-control invoice-amount text-right", inputmode = "numeric", autocomplete = "off", placeholder = AppProcessor.Messagor.GetMessage("TotalPayment_Label") })
                <div class="input-group-append">
                    <span class="input-group-text">VNĐ</span>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.TotalPayment, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-12">
            <label class="font-bold">
                @AppProcessor.Messagor.GetMessage("FileAttach_Label") <span class="text-danger">(*)</span>
            </label>
            @Html.FileFor(model => model.Files, ".pdf,.jpeg,.png,.gif,.jpg,.doc,.docx,.xlsx,.xls", true, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("FileUpload") })
            @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger d-block" })
            <div id="contractFileList" class="mt-2"></div>
            <div id="lstFileUploaded"></div>
        </div>
    </div>
</div>
<script src="~/Contents/Base/plugins/ace_v4/node_modules/bootbox/bootbox.all.js"></script>
<script src="~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-touchspin/dist/jquery.bootstrap-touchspin.js"></script>
<script>
var contractFilesList = [];
var contractDataTransfer = new DataTransfer();
jQuery(function ($) {
    if ($('#TotalPayment_View').val() != '') {
        $('#TotalPayment_View').val(formatInvoiceAmount($('#TotalPayment_View').val()));
    }
    fnTinhToan();

    // input spinner
    $("#VAT_Rate").TouchSpin({
        min: 0,
        max: 100,
        step: 1,
        maxboostedstep: 10,
        postfix: "%",
        buttondown_class: "btn btn-primary",
        buttonup_class: "btn btn-primary",
        buttondown_txt: '<i class="fa fa-minus"></i>',
        buttonup_txt: '<i class="fa fa-plus"></i>',
    }).on('touchspin.on.startspin change keyup', fnTinhToan);

    if ($('#InvoiceID').val() != '') {
        ReloadListFileUploaded();
    }
});

$(document).on("input", ".int-number", function (e) {
    this.value = this.value.replace(/[^0-9]/g, '');
});

$(document).on("input", "#Invoices .invoice-amount", function () {
    this.value = removeNonNumericChars(this.value);
    fnTinhToan();
});

$(document).on("change", "#Files", function (e) {
    var newFiles = Array.from(e.target.files);
    newFiles.forEach(function (file) {
        if (!contractFilesList.some(function (f) { return f.name === file.name && f.size === file.size; })) {
            contractFilesList.push(file);
        }
    });
    contractSyncInputFiles();
    contractRenderFileList();
});

function contractSyncInputFiles() {
    contractDataTransfer = new DataTransfer();
    contractFilesList.forEach(function (file) { contractDataTransfer.items.add(file); });
    var input = document.getElementById("DinhKemFile");
    if (input) input.files = contractDataTransfer.files;
}

function contractRenderFileList() {
    var html = "";
    contractFilesList.forEach(function (file, index) {
        html += '<div class="d-flex justify-content-between align-items-center border rounded px-2 py-1 mb-1">'
            + '<span><i class="fa fa-file text-grey-l4 mr-1"></i>' + file.name + '</span>'
            + '<button type="button" class="btn-sm p-0 btn px-2 border-0 btn-outline-danger" onclick="contractRemoveFile(' + index + ')">'
            + '<i class="fa fa-times"></i></button></div>';
    });
    $("#contractFileList").html(html);
}

function contractRemoveFile(index) {
    contractFilesList.splice(index, 1);
    contractSyncInputFiles();
    contractRenderFileList();
}

function fnFormatPayment() {
    var rawPayment = $('#Invoices #TotalPayment_View').val();
    if (rawPayment != '' && rawPayment != null) {
        $('#Invoices #TotalPayment_View').val(formatInvoiceAmount(rawPayment));
    }
}

function fnTinhToan() {
    var rawPayment = $('#Invoices #TotalPayment_View').val();
    var tongCongThToan = (rawPayment == '' || rawPayment == null) ? 0 : parseFloat(removeNonNumericChars(rawPayment));
    $('#Invoices #TotalPayment').val(tongCongThToan);

    var phanTramThue = $('#Invoices #VAT_Rate').val() == '' ? 0 : parseFloat($('#Invoices #VAT_Rate').val());
    var tienHang = phanTramThue > 0 ? Math.round(tongCongThToan / (1 + (phanTramThue / 100))) : tongCongThToan;
    var tienThue = tongCongThToan - tienHang;

    $('#Invoices #TotalAmount').val(tienHang);
    $('#Invoices #VAT_Amount').val(tienThue);
}

function removeNonNumericChars(inputString) {
    return String(inputString || '').replace(/\D/g, '');
}

function formatInvoiceAmount(value) {
    var amount = parseFloat(removeNonNumericChars(value));
    return isNaN(amount) ? '' : amount.toLocaleString('vi-VN', { maximumFractionDigits: 0 });
}

function ReloadListFileUploaded() {
    $.ajax({
        url: "/Cate/Invoices/GetFilePathsByInvoiceID/@Model.InvoiceID",
        type: "GET",
        dataType: "html",
        success: function (response) {
            $('#lstFileUploaded').html(response);
        },
        error: function (xhr, status, error) {
            $('#lstFileUploaded').html('');
        }
    });
}

function fnDeleteFile(fileId, filename) {
    bootbox.confirm({
        message: `Bạn có muốn xóa tập tin <span class="text-danger text-600 text-95">${filename}</span>`,
        onEscape: true,
        callback: function (result) {
            if (result) {
                $.ajax({
                    url: "/Cate/Invoices/DeleteFilePaths/" + fileId,
                    type: "GET",
                    success: function (response) {
                        eval(response.message);
                        ReloadListFileUploaded();
                        response.status = undefined;
                    }
                });
            }
        },
        buttons: {
            confirm: {
                label: '<i class="fas fa-check"></i> Có',
                className: 'btn px-4 btn-outline-danger'
            },
            cancel: {
                label: '<i class="fas fa-ban"></i> Không',
                className: 'btn px-4 btn-outline-lightgrey'
            },
        },
    });
}
</script>
@Html.RenderScripts(ScriptPosition.BodyInside)
