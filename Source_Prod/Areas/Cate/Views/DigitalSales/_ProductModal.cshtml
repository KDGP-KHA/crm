@using System.Web
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesProductModel
@{
    var titleKey = Model.SalesProductID > 0 ? "DigitalSalesProduct_Edit_Title" : "DigitalSalesProduct_Add_Title";
}
<div class="modal fade" id="modalProduct" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" style="max-width: 800px;" role="document">
        @using (Html.BeginForm("SaveProduct", "DigitalSales", new { area = "Cate" }, FormMethod.Post, new { id = "frmProductModal", @class = "modal-content border-0 shadow-lg radius-2 overflow-hidden" }))
        {
            <div class="modal-header bgc-purple-d1 text-white">
                <h5 class="modal-title text-110"><i class="fa fa-cubes mr-1"></i>@AppProcessor.Messagor.GetMessage(titleKey)</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body bgc-grey-l5 p-3" id="bodyForm">@Html.Partial("_ProductForm", Model)</div>
            <div class="modal-footer bgc-grey-l4">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal"><i class="fa fa-times mr-1"></i>@AppProcessor.Messagor.GetMessage("Button_Cancel")</button>
                <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-save mr-1"></i>@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Save_Button")</button>
            </div>
        }
    </div>
</div>
<!-- Hành vi modal sản phẩm được khởi tạo tập trung từ DigitalSalesDetail.js. -->
