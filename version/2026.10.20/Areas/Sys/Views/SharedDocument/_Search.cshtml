@using TSFramework.Libs.Processors
@model Core.Sys.Models.SharedDocumentSearchModel

<div class="Search card bcard border-0 shadow-sm radius-0" id="SearchSharedDocument">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>

    <div class="card-body p-2">
        <div class="form-row align-items-end">
            <div class="col-xl-3 col-lg-6 col-md-6 col-12 mb-2">
                <label class="font-bold text-90 mb-1" for="Keyword_Search">@AppProcessor.Messagor.GetMessage("Label_TuKhoa")</label>
                @Html.TextBoxFor(m => m.Keyword, new { id = "Keyword_Search", @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("SharedDoc_Search_Keyword") })
            </div>

            <div class="col-xl-3 col-lg-6 col-md-6 col-12 mb-2">
                <label class="font-bold text-90 mb-1" for="CategoryId_Search">@AppProcessor.Messagor.GetMessage("SharedDoc_Category_Label")</label>
                @Html.DropDownListFor(m => m.CategoryId, Model.Categories, new { id = "CategoryId_Search", @class = string.Concat("form-control none-", "select", "2") })
            </div>

            <div class="col-xl-2 col-lg-3 col-md-6 col-6 mb-2">
                <label class="font-bold text-90 mb-1" for="FromDate_Search">@AppProcessor.Messagor.GetMessage("Label_TuNgay")</label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-calendar-alt"></i></span>
                    </div>
                    @Html.TextBoxFor(m => m.FromDate, "{0:dd/MM/yyyy}", new { id = "FromDate_Search", @class = "form-control datepicker", placeholder = AppProcessor.Messagor.GetMessage("SharedDoc_Search_FromDate"), autocomplete = "off" })
                </div>
            </div>

            <div class="col-xl-2 col-lg-3 col-md-6 col-6 mb-2">
                <label class="font-bold text-90 mb-1" for="ToDate_Search">@AppProcessor.Messagor.GetMessage("Label_DenNgay")</label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-calendar-alt"></i></span>
                    </div>
                    @Html.TextBoxFor(m => m.ToDate, "{0:dd/MM/yyyy}", new { id = "ToDate_Search", @class = "form-control datepicker", placeholder = AppProcessor.Messagor.GetMessage("SharedDoc_Search_ToDate"), autocomplete = "off" })
                </div>
            </div>

            <div class="Search_button col-xl-auto col-lg-6 col-md-12 col-12 mb-2 d-flex align-items-end">
                <button type="button" class="btn btn-primary mr-2" id="btnSearchSharedDoc" onclick="SearchSharedDoc()">
                    <i class="fa fa-search mr-1"></i>@AppProcessor.Messagor.GetMessage("Button_Search")
                </button>
                <button type="button" class="btn btn-secondary" id="btnResetSharedDoc" onclick="ResetSearchSharedDoc()">
                    <i class="fa fa-undo mr-1"></i>@AppProcessor.Messagor.GetMessage("Button_Reset")
                </button>
            </div>
        </div>
    </div>
</div>
