@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesProcessModel

@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.ProcessID)
@Html.HiddenFor(m => m.StatusID)
@Html.HiddenFor(m => m.BusinessType)

<div class="form-group row">
    @Html.TitleFor(m => m.StatusID, new { @class = "col-sm-3 col-form-label text-sm-right font-bold text-secondary-d1" })
    <div class="col-sm-8 pt-2">
        <span class="badge badge-lg bgc-blue-l2 text-blue-d2 border-1 brc-blue-m3 px-3 py-1">
            <i class="fa fa-tag mr-1"></i>@(string.IsNullOrEmpty(Model.StatusName) ? "Trạng thái #" + Model.StatusID : Model.StatusName)
        </span>
        @Html.ValidationMessageFor(m => m.StatusID, "", new { @class = "text-danger text-90 d-block" })
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(m => m.ProcessCode, new { @class = "col-sm-3 col-form-label text-sm-right font-bold text-secondary-d1" })
    <div class="col-sm-8">
        @Html.TextBoxFor(m => m.ProcessCode, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesWorkflow_ProcessCode_Placeholder"), required = "required", maxlength = 50 })
        @Html.ValidationMessageFor(m => m.ProcessCode, "", new { @class = "text-danger text-90" })
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(m => m.ProcessName, new { @class = "col-sm-3 col-form-label text-sm-right font-bold text-secondary-d1" })
    <div class="col-sm-8">
        @Html.TextBoxFor(m => m.ProcessName, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesWorkflow_ProcessName_Placeholder"), required = "required", maxlength = 250 })
        @Html.ValidationMessageFor(m => m.ProcessName, "", new { @class = "text-danger text-90" })
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(m => m.SortOrder, new { @class = "col-sm-3 col-form-label text-sm-right font-bold text-secondary-d1" })
    <div class="col-sm-4">
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text"><i class="fa fa-sort-numeric-down"></i></span>
            </div>
            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-control", type = "number", min = "1", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesWorkflow_SortOrder_Placeholder") })
        </div>
        @Html.ValidationMessageFor(m => m.SortOrder, "", new { @class = "text-danger text-90" })
    </div>
    <div class="col-sm-4 pt-2">
        <label class="cursor-pointer">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "ace-switch ace-switch-check input-lg" })
            <span class="ml-1 text-95 font-600 text-success-d1">@AppProcessor.Messagor.GetMessage("DigitalSalesWorkflow_ProcessIsActive_Label")</span>
        </label>
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(m => m.Description, new { @class = "col-sm-3 col-form-label text-sm-right font-bold text-secondary-d1" })
    <div class="col-sm-8">
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesWorkflow_ProcessDescription_Placeholder") })
        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger text-90" })
    </div>
</div>
