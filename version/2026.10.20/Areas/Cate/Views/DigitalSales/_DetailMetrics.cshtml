@model Core.Cate.Models.RM_DigitalSalesModel
@{
    var totalTasks = Model.TrackingTasks?.Count ?? 0;
    var completedTasks = Model.TrackingTasks?.Count(t => t.Status == 3) ?? 0;
    var progressPercent = totalTasks > 0 ? (int)Math.Round((double)completedTasks * 100 / totalTasks) : 0;

    decimal expMil = (Model.TotalExpectedRevenue ?? 0) / 1000000m;
    decimal actMil = (Model.TotalActualRevenue ?? 0) / 1000000m;
    string expFormatted = expMil % 1 == 0 ? expMil.ToString("N0") : expMil.ToString("#,##0.##");
    string actFormatted = actMil % 1 == 0 ? actMil.ToString("N0") : actMil.ToString("#,##0.##");
}

<!-- THẺ CHỈ SỐ NHANH (METRIC TILES) -->
<div class="row ds-metrics-row mb-3">
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12 mb-2">
        <div class="card ds-metric-card ds-metric-blue h-100">
            <div class="d-flex align-items-center">
                <div class="ds-metric-icon">
                    <i class="fa fa-money-bill-wave fa-fw"></i>
                </div>
                <div class="flex-grow-1 min-width-0">
                    <div class="ds-metric-title text-truncate" title="Doanh thu dự kiến">Doanh thu dự kiến</div>
                    <div class="ds-metric-value text-truncate" title="@((Model.TotalExpectedRevenue ?? 0).ToString("N0")) VNĐ">
                        @expFormatted<span class="ds-metric-unit">triệu đồng</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12 mb-2">
        <div class="card ds-metric-card ds-metric-green h-100">
            <div class="d-flex align-items-center">
                <div class="ds-metric-icon">
                    <i class="fa fa-file-invoice-dollar fa-fw"></i>
                </div>
                <div class="flex-grow-1 min-width-0">
                    <div class="ds-metric-title text-truncate" title="Doanh thu thực tế (Ký HĐ)">Doanh thu thực tế (Ký HĐ)</div>
                    <div class="ds-metric-value text-truncate" title="@((Model.TotalActualRevenue ?? 0).ToString("N0")) VNĐ">
                        @actFormatted<span class="ds-metric-unit">triệu đồng</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12 mb-2">
        <div class="card ds-metric-card ds-metric-purple h-100">
            <div class="d-flex align-items-center">
                <div class="ds-metric-icon">
                    <i class="fa fa-cubes fa-fw"></i>
                </div>
                <div class="flex-grow-1 min-width-0">
                    <div class="ds-metric-title text-truncate" title="Sản phẩm / Dịch vụ số">Sản phẩm / Dịch vụ số</div>
                    <div class="ds-metric-value text-truncate">
                        @(Model.Products?.Count ?? 0)<span class="ds-metric-unit">sản phẩm</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12 mb-2">
        <div class="card ds-metric-card ds-metric-orange h-100">
            <div class="d-flex align-items-center">
                <div class="ds-metric-icon">
                    <i class="fa fa-tasks fa-fw"></i>
                </div>
                <div class="flex-grow-1 min-width-0">
                    <div class="ds-metric-title text-truncate" title="Tiến trình thực hiện">Tiến trình thực hiện</div>
                    <div class="ds-metric-value text-truncate">
                        @completedTasks/@totalTasks<span class="ds-metric-unit">công việc</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
