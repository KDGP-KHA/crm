@using System.Web
@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesTrackingModel
@{
    var isEdit = Model.TrackingID > 0;
    var modalTitle = isEdit ? "Cập nhật Tiến trình" : "Thêm mới Tiến trình";
}

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_TrackingModal.css?v=@DateTime.Now.Ticks" />

<div class="modal fade" id="modalTracking" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white">
                    <i class="fa fa-tasks mr-1"></i> @modalTitle
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("SaveTracking", "DigitalSales", new { area = "Cate" }, FormMethod.Post, new { id = "frmTrackingModal", enctype = "multipart/form-data" }))
            {
                <div class="modal-body" id="bodyForm">
                    @Html.Partial("_TrackingForm", Model)
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 radius-1" data-dismiss="modal">
                        <i class="fa fa-times mr-1"></i> @AppProcessor.Messagor.GetMessage("Button_Cancel")
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary px-3 radius-1 shadow-sm font-weight-bold">
                        <i class="fa fa-save mr-1"></i> Lưu tiến trình
                    </button>
                </div>
            }
        </div>
    </div>
</div>
