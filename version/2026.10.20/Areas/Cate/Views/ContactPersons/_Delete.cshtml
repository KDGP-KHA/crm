@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ContactPersonsModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ContactPersonal_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "ContactPersons", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ContactPersons_OnProcessSuccess(data, 'DeleteContactPersons')"
    }, new { @class = "form-horizontal", id = "DeleteContactPersons" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ContactPerson_ID)
        @Html.HiddenFor(model => model.FullName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}