@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_LogTaskFilePathModel

@{
    ViewBag.Title = "Xoá file đính kèm";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{ danger }
@section FormIcon{ <i class="far fa-trash-alt"></i> }

@section FormBody{
    @using (Html.BeginForm("DeleteFile", "LogTask", new { area = "Cate" }, FormMethod.Post, new { id = "DeleteFileLogTaskForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.FilePathID)
        @Html.HiddenFor(m => m.LogTaskID)
        @Html.HiddenFor(m => m.TaskManagementID)

        <div class="text-center py-3">
            <i class="fas fa-exclamation-triangle text-warning fa-3x mb-3"></i>
            <p>@ViewBag.ConfirmMessage</p>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-danger mr-2">
                <i class="fas fa-trash mr-1"></i> Xoá
            </button>
        </div>
    }
}
