@using TSFramework.Libs.Processors
@model CenIT.Solution.TOC.WebApp.Models.ResetPasswordModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.UserName)
@{
    <div class="col-12" id="UserInfo">
        <hr class="text-danger-d2" />

        @if (!Model.IsPermit)
        {
            <div class="col-12 mb-5" id="UserInfo">
                <h3 class="text-danger-d3">@Model.ErrMessage</h3>
            </div>
            <div class="col-12 d-flex flex-column align-items-center justify-content-center mt-3">
                <hr class="brc-default-l2 mt-0 mb-2 w-100">
                <div class="p-0 px-md-2 text-dark-tp4 my-3">
                    <a class="text-blue-d1 text-600 btn-text-slide-x active" href="@Url.Action("Login")">
                        <i class="btn-text-2 fa fa-arrow-left text-110 align-text-bottom mr-2"></i>Đăng nhập
                    </a>
                </div>
            </div>
        }
        else
        {
                <p class="text-blue text-150 offset-2">@AppProcessor.Messagor.GetMessage("Authorize_Reset_Password")</p>
                <div class="form-group col-sm-12 offset-sm-1 col-md-10 offset-md-2 col-lg-8 offset-lg-2 mt-1">
                    <div class="d-flex align-items-center input-floating-label text-success brc-success-m2">
                        @Html.TextBoxFor(model => model.NewPassword, new { type = "password", @class = "form-control form-control-lg pr-4 shadow-none", placeholder = @AppProcessor.Messagor.GetMessage("Authorize_New_Password") })
                        <i class="fa fa-key text-grey-m2 ml-n4"></i>
                        @Html.LabelFor(model => model.NewPassword, new { @class = "floating-label text-grey-l1 text-100 ml-n3" })
                    </div>
                    @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
                </div>

                <div class="form-group col-sm-12 offset-sm-1 col-md-10 offset-md-2 col-lg-8 offset-lg-2 mt-1">
                    <div class="d-flex align-items-center input-floating-label text-success brc-success-m2">
                        @*<input placeholder="Confirm Password" type="password" class="form-control form-control-lg pr-4 shadow-none" id="id-signup-password2" />*@
                        @Html.TextBoxFor(model => model.ConfirmPassword, new { type = "password", @class = "form-control form-control-lg pr-4 shadow-none", placeholder = @AppProcessor.Messagor.GetMessage("Authorize_Confirm_Password") })
                        <i class="fas fa-sync-alt text-grey-m2 ml-n4"></i>
                        @Html.LabelFor(model => model.ConfirmPassword, new { @class = "floating-label text-grey-l1 text-100 ml-n3" })
                    </div>
                    @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                </div>

                <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2">
                    <label class="col-12 px-0">
                        <input id="chkShowPassword" type="checkbox" aria-label="Hiển thị mật khẩu" onchange="_showPassword();">
                        Hiển thị mật khẩu
                    </label>
                </div>

                <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2">
                    <button type="submit" class="btn btn-primary px-4 btn-bold mt-2 mb-4">
                        <i class="fas fa-save"></i>
                        @AppProcessor.Messagor.GetMessage("Button_Save")
                    </button>
                </div>
                }
            </div>
        }
