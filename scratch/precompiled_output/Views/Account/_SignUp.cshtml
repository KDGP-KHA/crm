@using TSFramework.Libs.Processors
@model CenIT.Solution.TOC.WebApp.Models.SignUpModel

@using (Html.BeginForm("SignUp", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { autocomplete = "off", @class = "form-row mt-4", id = "SignUpForm", role = "form" }))
{
    <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2">
      <div class="d-flex align-items-center input-floating-label text-success brc-success-m2">
        @Html.TextBoxFor(model => model.Email, new { @class = "form-control form-control-lg pr-4 shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Authorize_Email") })
        <i class="fa fa-envelope text-grey-m2 ml-n4"></i>
        @Html.LabelFor(model => model.Email, new { @class = "floating-label text-grey-l1 text-100 ml-n3" })
      </div>
    </div>

    <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2 mt-1">
      <div class="d-flex align-items-center input-floating-label text-success brc-success-m2">
        @Html.TextBoxFor(model => model.UserName, new { @class = "form-control form-control-lg pr-4 shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Authorize_UserName") })
        <i class="fa fa-user text-grey-m2 ml-n4"></i>
        @Html.LabelFor(model => model.UserName, new { @class = "floating-label text-grey-l1 text-100 ml-n3" })
      </div>
    </div>

    <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2 mt-1">
      <div class="d-flex align-items-center input-floating-label text-success brc-success-m2">
        @Html.TextBoxFor(model => model.Password, new { type = "Password", @class = "form-control form-control-lg pr-4 shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Authorize_Password") })
        <i class="fa fa-key text-grey-m2 ml-n4"></i>
        @Html.LabelFor(model => model.Password, new { @class = "floating-label text-grey-l1 text-100 ml-n3" })
      </div>
    </div>

    <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2 mt-1">
      <div class="d-flex align-items-center input-floating-label text-success brc-success-m2">
        @Html.TextBoxFor(model => model.ConfirmPassword, new { type = "Password", @class = "form-control form-control-lg pr-4 shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Authorize_Password") })
        <i class="fas fa-sync-alt text-grey-m2 ml-n4"></i>
        @Html.LabelFor(model => model.ConfirmPassword, new { @class = "floating-label text-grey-l1 text-100 ml-n3" })
      </div>
    </div>

    <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2 mt-2">
      <label class="d-inline-block mt-3 mb-0 text-secondary-d2">
        <input type="checkbox" class="mr-1" id="id-agree">
        <span class="text-dark-m3">I have read and agree to <a href="#" class="text-blue-d2">terms</a></span>
      </label>
      <button type="button" class="btn btn-success btn-block px-4 btn-bold mt-2 mb-3">
        Sign Up
      </button>
    </div>
}
<form autocomplete="off" class="form-row mt-4"></form>