@using TSFramework.Libs.Processors
@model CenIT.Solution.TOC.WebApp.Models.ChangePasswordModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.UserName)

<style>
    @@font-face {
        font-family: 'password';
        /*  font-style: normal;
        font-weight: 800;*/
        src: url(https://jsbin-user-assets.s3.amazonaws.com/rafaelcastrocouto/password.ttf);
    }

    input.key {
        font-family: 'password';
    }
</style>



<div id="User">
    <div class="form-group row">
        @Html.TitleFor(model => model.CurrentPassword, new { @class = "col-form-label text-sm-right pr-0 font-bold col-md-4" })
        <div class="col-md-8">
            <div class="input-group col-md-8">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.CurrentPassword, new { @autocomplete = "off", @class = "form-control" @*, placeholder = AppProcessor.Messagor.GetMessage("Authorize_Current_Password")*@ })
                <div class="input-group-append">
                    <a class="input-group-text btn text-blue" href="javascript:void(0);" onclick="togglePasswordVisibility('CurrentPassword', this);">
                        <i class="fa fa-eye-slash"></i>
                    </a>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.CurrentPassword, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.NewPassword, new { @class = "col-form-label text-sm-right pr-0 font-bold col-md-4" })
        <div class="col-md-8">
            <div class="input-group col-md-8">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.NewPassword, new { @autocomplete = "off", @class = "form-control"@*, placeholder = AppProcessor.Messagor.GetMessage("Authorize_New_Password")*@ })
                <div class="input-group-append">
                    <a class="input-group-text btn text-blue" href="javascript:void(0);" onclick="togglePasswordVisibility('NewPassword', this);">
                        <i class="fa fa-eye-slash"></i>
                    </a>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.ConfirmPassword, new { @class = "col-form-label text-sm-right pr-0 font-bold col-md-4" })
        <div class="col-md-8">
            <div class="input-group col-md-8">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.ConfirmPassword, new { @autocomplete = "off", @class = "form-control"@*, placeholder = AppProcessor.Messagor.GetMessage("User_Label_ConfirmPassword")*@ })
                <div class="input-group-append">
                    <a class="input-group-text btn text-blue" href="javascript:void(0);" onclick="togglePasswordVisibility('ConfirmPassword', this);">
                        <i class="fa fa-eye-slash"></i>
                    </a>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, element) {
        var passwordInput = $('#' + inputId);
        var icon = $(element).find('i');
        if (passwordInput.hasClass('key')) {
            //passwordInput.attr('type', 'text');
            passwordInput.removeClass('key');
            icon.removeClass('fa-eye-slash');
            icon.addClass('fa-eye');
        } else {
            passwordInput.addClass('key');
            //passwordInput.attr('type', 'password');
            icon.removeClass('fa-eye');
            icon.addClass('fa-eye-slash');
        }
    }
</script>