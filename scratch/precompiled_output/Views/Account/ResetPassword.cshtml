@using TSFramework.Libs.Processors
@model CenIT.Solution.TOC.WebApp.Models.ResetPasswordModel

@{
    Layout = "~/Views/Shared/_Login.cshtml";
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Authorize_Reset_Password");
}

@section HeadCss{

}

<div class="body-container">
    <div class="body-container">
        <div class="main-container container bgc-transparent">
            <div class="main-content minh-100 justify-content-center">
                <div class="p-2 p-md-4">
                    <div class="row justify-content-center" id="row-1">
                        <div class="bgc-white shadow radius-1 overflow-hidden col-12 col-lg-6 col-xl-5">
                            <div class="row" id="row-2">
                                <div style="background-image: url(/Contents/Base/plugins/ace_v4/assets/image/login-bg-1.svg);" id="id-col-main" class="col-12 py-lg-4 bgc-white px-0">
                                    <div class="tab-content tab-sliding border-0 p-0" data-swipe="right">
                                        <div class="tab-pane active show px-3 px-lg-0" id="id-tab-login">
                                            <!-- show this in desktop -->
                                            <!-- show this in mobile device -->
                                            <div class="text-secondary-m1 text-center">
                                                <a href="/">
                                                    @*<i class="fa fa-id-card text-success-m2 text-200 mb-4"></i>*@
                                                    <img class="w-25" src="/Contents/Base/imgs/app.ico">
                                                </a>
                                                <h1 class="text-170">
                                                    <span class="text-80 text-danger-d1 text-upcase font-bold">Quản lý định mức </span> <span class="text-80 text-blue-d1 text-upcase font-bolder">cấp phát nhiên liệu</span>
                                                </h1>
                                            </div>
                                            @using (Html.BeginForm("ResetPassword", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-row mt-4", id = "ResetPassword", role = "form" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <div class="col-12" id="bodyForm">
                                                    @Html.Partial("_ResetPassword")
                                                </div>
                                            }

                                        </div><!-- /.col -->
                                    </div><!-- /.col -->
                                </div><!-- /.col -->
                            </div><!-- /.col -->
                        </div><!-- /.col -->
                    </div><!-- /.row -->
                </div>
            </div>
        </div>
    </div>

</div>

@section BottomScript
{
    <script type="text/javascript">

        $('#ResetPassword').ajaxForm({
            beforeSubmit: function (arr, $form, options) {
                $('form#ResetPassword input, form#ResetPassword button, form#ResetPassword a').attr("disabled", true);
                $('form#ResetPassword a').addClass("disabled");
                return true;
            },
            success: function (response) {
                if (response.status != undefined) {
                    eval(response.message);
                    if (response.status) {
                        setTimeout(function () {
                            window.location = "@Url.Action("Login")";
                        }, 3500);
                    }
                    response.status = undefined;
                } else {
                    $("#ResetPassword #bodyForm").html(response);
                    $('form#ResetPassword input, form#ResetPassword button, form#ResetPassword a').removeAttr("disabled");
                    $('form#ResetPassword a').removeClass("disabled");
                }
            }
        });

        function _showPassword() {
            $("#UserInfo input:not([type='checkbox'])").each(function (idx, inpt) {
                if ('password' == $(inpt).attr('type')) {
                    $(inpt).prop('type', 'text');
                } else {
                    $(inpt).prop('type', 'password');
                }
            });
        }
    </script>

    <script src="@Url.Content("~/Views/Account/PasswordValid.js")"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            var confirmPassValid = "#ConfirmPassword";
            $("#NewPassword").passwordValidation({ "confirmField": confirmPassValid, "minLength": 3 },
                function (element, valid, match, failedCases) {
                    $("span[data-valmsg-for='NewPassword']").empty();
                    $.each(failedCases,
                        function (idx, msg) {
                            $("span[data-valmsg-for='NewPassword']").append(' <p class="text-red">' + msg + "</p>");
                        });
                    if (valid) $(element).css("border", "1px solid #00a65a");
                    if (!valid) $(element).css("border", "1px solid #dd4b39");
                    if (valid && match) $(confirmPassValid).css("border", "1px solid #00a65a");
                    if (!valid || !match) $(confirmPassValid).css("border", "1px solid #dd4b39");
                });
        });
    </script>
}