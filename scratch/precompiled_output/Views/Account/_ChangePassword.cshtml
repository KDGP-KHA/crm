@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("Authorize_Password"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-key"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("ChangePassword", "Account", new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Account_OnProcessSuccess(data, 'ChangePassword')"
    }, new { @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_PasswordModel")
        </div>
    }

    <script src="@Url.Content("~/Views/Account/PasswordValid.js")"></script>

    <script type="text/javascript">
        
        $(document).ready(function () {
            var confirmPassValid = "#ConfirmPassword";
            $("#NewPassword").passwordValidation({ "confirmField": confirmPassValid, "minLength": 8 },
                function (element, valid, match, failedCases) {
                    $("span[data-valmsg-for='NewPassword']").empty();
                    $.each(failedCases,
                        function (idx, msg) {
                            $("span[data-valmsg-for='NewPassword']").append(' <p class="text-red">' + msg + "</p>");
                        });
                    if (valid) $(element).css("border", "1px solid #00a65a");
                    if (!valid) $(element).css("border", "1px solid #dd4b39");
                    if (valid && match) $(confirmPassValid).css("border", "1px solid #00a65a");
                    if (!valid || !match) $(confirmPassValid).css("border", "1px solid #dd4b39");
                });
        });

        function Account_OnProcessSuccess(response, formId) {
            if (response.status != undefined && response.status === true) {
                $("#ModalContent #modal_" + formId).modal("hide");
                $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                    function () {
                        if (response.status != undefined) {
                            eval(response.message);
                            response.status = undefined;
                            setTimeout(function () {
                                window.location.href = "@Url.Action("Logout")";
                            }, 3000);
                        }
                    });
            } else if (response.status != undefined && response.status === false) {
                eval(response.message);
                response.status = undefined;
            } else {
                $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
            }
        }
    
    </script>
}