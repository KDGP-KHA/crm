@using TSFramework.Libs.Processors
@model CenIT.Solution.TOC.WebApp.Models.LoginModel
@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "";
}
@using (Ajax.BeginForm("ForgotPassword", "Account", new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "Account_OnProcessSuccess(data, 'ForgotPassword')"
}, new { @class = "form-row mt-4", id = "ForgotPassword", autocomplete = "off" }))
{
    <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2">
        <label class="text-secondary-d3 mb-3">
            Nhập địa chỉ email của bạn và chúng tôi sẽ gửi cho bạn hướng dẫn:
        </label>
        <div class="d-flex align-items-center">
            @Html.TextBoxFor(model => model.Email, new {  @class = "form-control form-control-lg pr-4 shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Authorize_Email") })
            <i class="fa fa-envelope text-grey-m2 ml-n4"></i>
        </div>
        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
    </div>
    <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2 mt-1">
        <button type="submit" class="btn btn-orange btn-block px-4 btn-bold mt-2 mb-4">
            Tiếp tục
        </button>
        <a id="btn-info-sent" href="#" class="text-primary-m1 text-95" data-toggle="tab" data-target="#id-tab-sent-info">
        </a>
    </div>
}