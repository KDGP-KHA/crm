@using TSFramework.Libs.Processors
<div class="modal-header py-2 bgc-@(RenderSection("FormType", false).ToHtmlString().ToLower().Replace("\n", "").Replace("\r", "").Trim())-tp1 border-0  radius-t-1">
	<h5 class="modal-title text-white-tp1 text-110 pl-2 font-bolder my-auto" id="modalTitle">
		@RenderSection("FormIcon", false)&nbsp;@Html.Raw(ViewBag.Title)
	</h5>
	<button type="button" class="btn btn-outline-white btn-h-danger btn-a-danger mt-1px mr-1px btn-brc-tp" data-dismiss="modal" aria-label="Close" title="Đóng" data-rel="tooltip">
        <i class="fas fa-times"></i>
	</button>
</div>

<div class="modal-body">
	<div class="content-body">
		@RenderSection("FormBody", true)
	</div>
</div>

<div class="modal-footer">
    @RenderSection("ContinueForm", false)
    @if (IsSectionDefined("ContinueForm"))
    {
        <label class="col-4 text-right">
            <input id="chkNotDismissModal" name="ContinueForm" type="checkbox" aria-label="@AppProcessor.Messagor.GetMessage("Modal_ContinueForm")">
            @AppProcessor.Messagor.GetMessage("Modal_ContinueForm")
        </label>
    }
    @RenderSection("SubmitControl", false)
    @if (!IsSectionDefined("SubmitControl"))
    {
        <button type="submit" id="btnSave" class="btn px-4 btn-outline-primary mb-1"><i class="fa fa-save"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Save")</button>
    }
    <button type="button" class="btn px-4 btn-outline-danger mb-1" data-dismiss="modal"><i class="fas fa-times"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Cancel")</button>
</div>

@section BottomScript{
    @RenderSection("BottomScript", false)

}