    @RenderSection("BottomScript", false)

    <script type="text/javascript">

        var clicked = false;
        $("#messages a.msg").on("click", function (event) {
            if (clicked) {
                clicked = false;
            } else {
                event.preventDefault();
                var msgId = $(this).attr('msg-id');
                _maskAsRead(msgId, $(this).attr('href'));
            }
        });

        function _maskAsRead(msgId, href) {
            var urlMaskAsReadMessage = "@Url.Action("MaskAsRead","Notification", new{area=""})/" + msgId;

            $.ajax({
                type: "GET",
                url: urlMaskAsReadMessage,
                async: false,
                dataType: "JSON",
                success: function (response) {
                    if (response != undefined && response.status) {
                        window.location = href;
                        clicked = true;
                    }
                }
            });
        }

    </script>

    <script type="text/javascript">
        // Tạo một thẻ <i> để chứa biểu tượng tìm kiếm
        var icon = $('<i>', {
            class: 'fas fa-search' // Lớp CSS để sử dụng biểu tượng tìm kiếm từ Font Awesome
        });

        // Tạo một <span> mới chứa cả biểu tượng và văn bản "Tìm kiếm menu..."
        var placeholder = $('<span>', {
            class: 'select2-selection__placeholder',
            title: 'Tìm kiếm menu...'
        }).append(icon).append(' Tìm kiếm menu...');

        //console.log(placeholder)
        //console.log($('#select2-search-menu-container'));

        // Thay thế nội dung của span có ID là select2-search-menu-container bằng placeholder mới
        //$('#navbarSearch span#select2-search-menu-container').empty().append(placeholder);

        $(document).ready(function () {

            $.ajax({
                url: 'Sys/Menu/LoadTreeView',
                type: 'POST',
                dataType: 'json',
                success: function (response) {
                    if (response.status) {
                        // Xử lý dữ liệu nhận được từ máy chủ
                        var appMenus = response.data;
                        //console.log(appMenus);

                        // Xóa tất cả các option hiện có trong dropdown list
                        $('#search-menu').empty();
                        // Add a placeholder option at the beginning of the dropdown
                        $('#search-menu').append('<option disabled selected value="">Select an option</option>');

                        function appendMenuOptions(menuItems, parent) {
                            $.each(menuItems, function (index, item) {
                                var hasChild = item.Childs && item.Childs.length > 0;
                                var hasGrandChild = false;

                                // Kiểm tra xem mục con có mục con không
                                if (hasChild) {
                                    for (var i = 0; i < item.Childs.length; i++) {
                                        if (item.Childs[i].Childs && item.Childs[i].Childs.length > 0) {
                                            hasGrandChild = true;
                                            break;
                                        }
                                    }
                                }

                                // Nếu mục không có mục con hoặc mục con của nó không có mục con
                                if (!hasChild || !hasGrandChild) {
                                    // Tạo option cho mục
                                    var option = $('<option>', {
                                        value: item.Link,
                                        text: item.TitleView
                                    });

                                    // Nếu mục không có mục con hoặc mục con của nó không có mục con
                                    if (!hasChild || !hasGrandChild) {
                                        if (item.Link === "#") {
                                            // Nếu là một mục cha không có mục con hoặc mục con của nó không có mục con
                                            var optgroup = $('<optgroup>', {
                                                label: item.TitleView
                                            });
                                            parent.append(optgroup);
                                            appendMenuOptions(item.Childs, optgroup);
                                        } else {
                                            // Nếu là một mục lá
                                            // nếu như đã có trong optgroup rồi thì không append nữa chứ
                                            if (!parent.find('option[value="' + item.Link + '"]').length) {
                                                parent.append(option);
                                            }

                                        }
                                    }
                                }

                                // Nếu mục có con, thực hiện đệ quy
                                if (hasChild) {
                                    appendMenuOptions(item.Childs, parent);
                                }
                            });
                        }

                        // Gọi hàm đệ quy để thêm các mục vào dropdown list
                        appendMenuOptions(appMenus, $('#search-menu'));
                    } else {
                        console.error(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                }
            });
        });


        $('#search-menu').on('change', function () {
            var selectedValue = $(this).val(); // Lấy giá trị của mục đã chọn
            // Chuyển hướng người dùng đến trang được chỉ định trong thuộc tính Link của mục đó
            if (selectedValue) {
                //console.log("running...");
                $('#loading-modal').modal('show');
                window.location.href = selectedValue
            }
        });

    </script>

