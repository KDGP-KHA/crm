  <TiSunService defaultProvider="CenIT.Provider.Sys" enableTrace="false" templateDirectory="">
    <providers>
      <clear />
      <add name="CenIT.Provider.Sys" type="TiSun.SqlDataProvider, TiSun" connectionStringName="TOC.Conn.Sys" generatedNamespace="CenIT.Solutions.Models" generateLazyLoads="true" />
      <add name="CenIT.Provider.Major" type="TiSun.SqlDataProvider, TiSun" connectionStringName="TOC.Conn.Major" generatedNamespace="CenIT.Solutions.Models" generateLazyLoads="true" />
