  <system.web>
	<customErrors mode="Off"/>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" maxRequestLength="1048576" />
    <!--<membership defaultProvider="AppMembership">
