@using System.Linq
@using TSFramework.Libs.Processors
@model List<Core.Cate.Models.ProjectDashboardModel>

<div class="db-section-title mt-2">
    <i class="fa fa-table mr-1 text-blue"></i>
    Danh sách dự án
    <a class="btn btn-sm btn-success float-right dashboard-export" style="margin-top: -5px"
       href="@Url.Action("ExportProjects", "Dashboard", new { area = "Dashboard" })">
        <i class="fa fa-file-excel mr-1"></i>Xuất Excel
    </a>
</div>

<div class="table-responsive mt-2">
    <table class="table table-bordered table-hover table-striped mb-0" id="projectsTable">
        <thead class="thead-light">
            <tr>
                <th width="40">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                <th>@AppProcessor.Messagor.GetMessage("Info_Project_Label")</th>
                <th class="text-left">@AppProcessor.Messagor.GetMessage("Project_Cost_Label")</th>
                <th class="text-left">@AppProcessor.Messagor.GetMessage("Project_Revenue_Label")</th>
                <th class="text-left">@AppProcessor.Messagor.GetMessage("Members_Title")</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var item in Model)
                {
                    var members = (item.Members ?? "")
                        .Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
                        .Select(x => x.Trim())
                        .OrderByDescending(x => x.Contains("(AM") || x.Contains(", AM") || x.EndsWith("AM)"))
                        .ToList();
                    <tr>
                        <td>@index</td>
                        <td>
                            <div>
                                <span class="badge @item.StatusClass">
                                    @item.StatusName
                                </span>
                            </div>

                            <div class="font-weight-bold text-primary">
                                <a href="/Cate/ProjectOverview/Index/@item.ProjectID">
                                    @item.ProjectName
                                </a>
                            </div>

                            <div class="text-muted small">
                                <i class="fa fa-building mr-1"></i> @item.CustomerName
                            </div>

                            <div class="small text-muted">
                                <i class="far fa-clock mr-1"></i>
                                @(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "")
                            </div>

                            <div class="text-muted small">
                                @AppProcessor.Messagor.GetMessage("Managing_Entity_Label") <b>@item.TenBoPhan</b>
                            </div>
                        </td>

                        <td class="text-right text-danger font-weight-bold">
                            @item.TotalCost.ToString("N0")
                        </td>
                        <td class="text-right text-success font-weight-bold">
                            @item.TotalRevenue.ToString("N0")
                        </td>
                        <td>
                            @{
                                var maxShow = 3;
                                var total = members.Count();
                                var displayMembers = members.Take(maxShow).ToList();
                            }

                            @foreach (var m in displayMembers)
                            {
                                var text = m.Trim();
                                var isAM = text.Contains("(AM") || text.Contains(", AM") || text.EndsWith("AM)");
                                <div>
                                    - @Html.Raw(isAM
                                    ? $"<span class='text-danger font-weight-bold'>{text}</span>"
                                    : text)
                                </div>
                            }

                            @if (total > maxShow)
                            {
                                <div style="color:#0d6efd; cursor:pointer;" onclick="this.nextElementSibling.style.display='block'; this.style.display='none';">
                                    + Xem thêm (@(total - maxShow))
                                </div>

                                <div style="display:none;">
                                    @foreach (var m in members.Skip(maxShow))
                                    {
                                        var text = m.Trim();
                                        var isAM = text.Contains("(AM") || text.Contains(", AM") || text.EndsWith("AM)");
                                        <div>
                                            - @Html.Raw(isAM
                                            ? $"<span class='text-danger font-weight-bold'>{text}</span>"
                                            : text)
                                        </div>
                                    }
                                </div>
                            }
                            <div class="text-left">
                                @Html.Button(
                                    true,
                                    "ViewHistory",
                                    Url.Action("ViewHistory", "Project", new { area = "Cate", id = item.ProjectID }),
                                    "<i class='far fa-clock'></i>",
                                    "Nhật ký trao đổi",
                                    new { @class = "btn btn-sm btn-primary p-1", style = "font-size:9px;" }
                                )
                            </div>
                        </td>
                    </tr>

                    index++;
                }
            }
            else
            {
                <tr class="dt-empty">
                    <td colspan="7" class="text-center text-muted dt-no-data">
                        <div class="alert alert-info text-center">
                            <i class="fa fa-info-circle mr-1"></i> @AppProcessor.Messagor.GetMessage("Dashboard_NoData")
                        </div>
                    </td>
                    <td style="display:none"></td>
                    <td style="display:none"></td>
                    <td style="display:none"></td>
                    <td style="display:none"></td>
                </tr>
            }
        </tbody>
    </table>
</div>
