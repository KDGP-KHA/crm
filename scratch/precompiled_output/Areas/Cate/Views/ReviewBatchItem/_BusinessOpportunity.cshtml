@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ReviewBusinessOpportunitySearchModel

@{
    var BusinessOpportunityId = ViewData["BusinessOpportunityID"];
}

<div class="container-fluid">
    @Html.Partial("_SearchBusinessOpportunity")
    <div class="mt-3">
        <div class="card dcard">
            <div class="col-sm-12 table-responsive-md">
                <table id="DSBusinessOpportunity" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                    <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                        <tr>
                            <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                            <th>@AppProcessor.Messagor.GetMessage("OpportunityName_Label")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Customer_Title")</th>
                            <th>@AppProcessor.Messagor.GetMessage("ClosingProbability_Label")</th>
                            <th>@AppProcessor.Messagor.GetMessage("AMName_Label")</th>
                            <th>Thông tin rà soát</th>
                            <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    var _boReviewOrder = '@(ViewBag.BusinessOrder ?? "1")';
    var _boReviewOrderDir = '@(ViewBag.BusinessOrderDir ?? "desc")';
    var _boReviewStart = @(ViewBag.BusinessStartIndex ?? 0);
    var _boReviewLength = @(ViewBag.BusinessPageSize ?? 10);
</script>