@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ReviewBusinessOpportunitySearchModel

<style>
    #SearchBusinessOpportunity .Search_Box {
        flex: 1;
        min-width: 180px;
    }

    #SearchBusinessOpportunity .button-box {
        flex: 0 0 150px;
        min-width: 150px;
    }

    #SearchBusinessOpportunity .radio-group {
        height: 34px;
        display: flex;
        align-items: center;
    }
</style>

<div class="Search card bcard border-0 shadow-sm radius-0" id="SearchBusinessOpportunity">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>
            &nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>

    <div class="card-body p-2">
        <div class="d-flex flex-wrap align-items-end mb-2 search-row">
            <!-- KEYWORD -->
            <div class="Search_Box keyWord">
                <label class="font-bold">
                    @AppProcessor.Messagor.GetMessage("Label_TuKhoa")
                </label>
                <input type="text"
                       id="BusinessOpportunityKeyword"
                       class="form-control"
                       value="@Model.Keyword"
                       placeholder="@AppProcessor.Messagor.GetMessage("Customer_Keyword")" />
            </div>
            <!-- REVIEW BATCH -->
            <div class="Search_Box">
                <label class="font-bold">
                    @AppProcessor.Messagor.GetMessage("ReviewBatch_Title")
                </label>
                @Html.DropDownListFor(
                    model => model.ReviewBatchID,
                    new SelectList(Model.ListReviewPatch, "ReviewBatchID", "BatchName", Model.ReviewBatchID),
                    "",
                    new {id = "BusinessOpportunityReviewBatchID", @class = "form-control", data_placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select")})
            </div>
            <!-- STATUS -->
            <div class="Search_Box">
                <label class="font-bold">
                    @AppProcessor.Messagor.GetMessage("BO_Overview_Label_Status")
                </label>
                @Html.DropDownListFor(
                    model => model.StatusID,
                    new SelectList(Model.ListStatus, "ID", "StatusName", Model.StatusID),
                    "",
                    new {id = "BusinessOpportunityStatusID", @class = "form-control", data_placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select")})
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-end search-row">
            <!-- DEPARTMENT -->
            <div class="Search_Box">
                <label class="font-bold">
                    @AppProcessor.Messagor.GetMessage("Department_Search_Label")
                </label>
                @Html.DropDownListFor(
                    model => model.BoPhanID,
                    new SelectList(Model.Departments, "BoPhan_ID", "TenBoPhanView"),
                    "-- Chọn phòng ban --",
                    new {id = "BusinessOpportunityBoPhanID", @class = "form-control"})
            </div>
            <!-- EMPLOYEE -->
            <div class="Search_Box">
                <label class="font-bold">
                    @AppProcessor.Messagor.GetMessage("Employee_Search_Label")
                </label>
                @Html.DropDownListFor(
                    model => model.EmployeeID,
                    Enumerable.Empty<SelectListItem>(),
                    "-- Chọn nhân viên --",
                    new {id = "BusinessOpportunityEmployeeID", @class = "form-control"})
            </div>
            <!-- IS REVIEWED -->
            <div class="Search_Box review-box">
                <label class="font-bold d-block">
                    @AppProcessor.Messagor.GetMessage("ReviewBatch_IsReviewed_Label")
                </label>
                <div class="d-flex align-items-center radio-group">
                    <div class="custom-control custom-radio mr-3">
                        <input type="radio"
                               id="BusinessOpportunityIsReviewed_No"
                               name="BusinessOpportunityIsReviewed"
                               class="custom-control-input"
                               value="false"
                               @(!Model.IsReviewed ? "checked" : "") />
                        <label class="custom-control-label"
                               for="BusinessOpportunityIsReviewed_No">
                            @AppProcessor.Messagor.GetMessage("IsReviewed_No_Label")
                        </label>
                    </div>
                    <div class="custom-control custom-radio">
                        <input type="radio"
                               id="BusinessOpportunityIsReviewed_Yes"
                               name="BusinessOpportunityIsReviewed"
                               class="custom-control-input"
                               value="true"
                               @(Model.IsReviewed ? "checked" : "") />
                        <label class="custom-control-label"
                               for="BusinessOpportunityIsReviewed_Yes">
                            @AppProcessor.Messagor.GetMessage("IsReviewed_Yes_Label")
                        </label>
                    </div>
                </div>
            </div>
            <!-- BUTTON -->
            <div class="Search_Box button-box">
                <button type="button" class="btn btn-primary w-100" onclick="SearchBusinessOpportunity()">
                    <i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // =========================================
        // LOAD EMPLOYEE BY DEPARTMENT
        // =========================================
        $("#BusinessOpportunityBoPhanID").on("change", function () {

            var departmentId = $(this).val();
            var $employee = $("#BusinessOpportunityEmployeeID");

            $employee.empty().append('<option value="">-- Chọn nhân viên --</option>');

            if (!departmentId) {

                $employee.trigger("chosen:updated");
                return;
            }

            $.get('/Cate/RM_BusinessOpportunity/GetEmployeesByDepartment', {
                departmentId: departmentId
            }, function (data) {

                $.each(data, function (i, item) {
                    $employee.append($('<option>').val(item.Value).text(item.Text));
                });

                // restore employee
                const businessFilter =
                    JSON.parse(localStorage.getItem("review_business_filter"));

                if (businessFilter && businessFilter.EmployeeID) {
                    $employee.val(businessFilter.EmployeeID);
                }

                $employee.trigger("chosen:updated");

                // search AFTER restore employee
                SearchBusinessOpportunity();
            });
        });

        // =========================================
        // RESTORE FILTER
        // =========================================

        const reviewBatchID = '@Model.ReviewBatchID';

        if (!reviewBatchID || reviewBatchID === "0") {

            const businessFilter =
                JSON.parse(localStorage.getItem("review_business_filter"));

            if (businessFilter) {

                $("#BusinessOpportunityKeyword")
                    .val(businessFilter.Keyword || "");

                $("#BusinessOpportunityReviewBatchID")
                    .val(businessFilter.ReviewBatchID || "")
                    .trigger("chosen:updated");

                $("#BusinessOpportunityStatusID")
                    .val(businessFilter.StatusID || "")
                    .trigger("chosen:updated");

                $("#BusinessOpportunityBoPhanID")
                    .val(businessFilter.BoPhanID || "")
                    .trigger("chosen:updated");

                $('input[name="BusinessOpportunityIsReviewed"][value="' + businessFilter.IsReviewed + '"]')
                    .prop("checked", true);

                // trigger AFTER bind
                if (businessFilter.BoPhanID) {

                    $("#BusinessOpportunityBoPhanID")
                        .trigger("change");
                }
            }
        }

        // =========================================
        // EVENTS
        // =========================================

        $('#SearchBusinessOpportunity').on(
            'keydown',
            'input, select',
            function (e) {

                if (e.key === 'Enter') {

                    e.preventDefault();
                    SearchBusinessOpportunity();
                }
            });

        // bind riêng từng control
        $("#BusinessOpportunityReviewBatchID").change(SearchBusinessOpportunity);
        $("#BusinessOpportunityStatusID").change(SearchBusinessOpportunity);
        $("#BusinessOpportunityEmployeeID").change(SearchBusinessOpportunity);
        $('input[name="BusinessOpportunityIsReviewed"]').change(SearchBusinessOpportunity);
    });

    function saveBusinessOpportunityFilter() {

        const filter = {
            Keyword: $("#BusinessOpportunityKeyword").val(),
            ReviewBatchID: $("#BusinessOpportunityReviewBatchID").val(),
            StatusID: $("#BusinessOpportunityStatusID").val(),
            BoPhanID: $("#BusinessOpportunityBoPhanID").val(),
            EmployeeID: $("#BusinessOpportunityEmployeeID").val(),
            IsReviewed: $('input[name="BusinessOpportunityIsReviewed"]:checked').val()
        };

        localStorage.setItem(
            "review_business_filter",
            JSON.stringify(filter)
        );
    }

    function SearchBusinessOpportunity() {

        saveBusinessOpportunityFilter();

        if (_tableBusinessOpportunity) {
            _tableBusinessOpportunity.ajax.reload();
        }
    }
</script>