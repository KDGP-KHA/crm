@using TSFramework.Libs.Processors
@model List<Core.Cate.Models.RM_OpportunityPlanModel>

@{
    var boId = ViewData["BusinessOpportunityID"];
    var addUrl = Url.Action("AddPlan", "BusinessOpportunityOverview", new { area = "Cate", businessOpportunityId = boId });
    var editRelatedPersonText = AppProcessor.Messagor.GetMessage("OpportunityPlanRelatedPerson_Edit_Button");
    editRelatedPersonText = string.IsNullOrWhiteSpace(editRelatedPersonText)
        ? "Ch\u1ec9nh s\u1eeda ng\u01b0\u1eddi li\u00ean quan"
        : editRelatedPersonText;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="mb-0 font-weight-bold text-dark">
        <i class="fas fa-calendar-alt text-purple mr-2"></i>
        @AppProcessor.Messagor.GetMessage("OpportunityPlan_Title")
    </h6>
    @if (addUrl != null)
    {
        @Html.Button(
                           true,
                           "AddOpportunityPlan",
                           addUrl,
                           "<i class='fa fa-plus'></i>",
                           AppProcessor.Messagor.GetMessage("Button_Add"),
                           new { @class = "btn btn-sm btn-light-blue btn-h-blue border-0 radius-3 py-2 text-600 text-90", data_width = "600" }
                       )
    }
</div>

<style>
    .plan-table-wrapper {
        overflow-x: auto;
        overflow-y: visible;
        padding-bottom: 8px;
    }

    .plan-table-wrapper .dropdown,
    .plan-table-wrapper td,
    .plan-table-wrapper tr {
        position: static;
    }

    .plan-table-wrapper .dropdown-menu {
        margin-top: 2px;
    }

    .plan-related-person-line + .plan-related-person-line {
        margin-top: 8px;
    }

    .plan-related-person-name {
        line-height: 1.35;
    }

    .plan-related-person-unit {
        font-size: 0.78rem;
        color: #8a94a6;
        line-height: 1.3;
        margin-top: 1px;
    }

    .plan-truncate {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        max-height: 3em;
        transition: max-height 0.3s ease;
    }

        .plan-truncate.expanded {
            display: block;
            max-height: none;
        }

    .btn-toggle-more {
        background: none;
        border: none;
        padding: 0;
        font-size: 0.8em;
        color: #5b8def;
        cursor: pointer;
        white-space: nowrap;
    }

        .btn-toggle-more:hover {
            text-decoration: underline;
        }
</style>

@if (Model != null && Model.Any())
{
    <div class="table-responsive plan-table-wrapper">
        <table class="table table-hover table-bordered table-sm mb-0">
            <thead class="bgc-secondary-l1 text-uppercase text-85">
                <tr>
                    <th class="text-center" style="width:40px;">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                    <th style="width:160px;">@AppProcessor.Messagor.GetMessage("OpportunityPlan_PlanName_Label")</th>
                    <th style="width:145px;">@AppProcessor.Messagor.GetMessage("OpportunityPlan_WorkingDate_Label")</th>
                    <th style="width:22%;">@AppProcessor.Messagor.GetMessage("OpportunityPlan_AddressMeeting_Label")</th>
                    <th style="width:18%;">@AppProcessor.Messagor.GetMessage("OpportunityPlanRelatedPerson_Title")</th>
                    <th>@AppProcessor.Messagor.GetMessage("OpportunityPlan_Content_Label")</th>
                    <th class="text-center" style="width:60px;">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var plan in Model)
                {
                    var canEdit = plan.WorkingDate.HasValue && DateTime.Now <= plan.WorkingDate.Value;
                    var relatedPersonUrl = Url.Action("List", "OpportunityPlanRelatedPerson", new { area = "Cate", id = plan.Id });
                    var editUrl = Url.Action("EditPlan", "BusinessOpportunityOverview", new { area = "Cate", id = plan.Id });
                    var deleteUrl = Url.Action("DeletePlan", "BusinessOpportunityOverview", new { area = "Cate", id = plan.Id });
                    var contentId = "planContent_" + plan.Id;
                    var hasLongContent = !string.IsNullOrEmpty(plan.Content) && plan.Content.Length > 100;

                    <tr>
                        <td class="text-center">@idx</td>
                        <td class="font-weight-bold">@plan.PlanName</td>
                        <td class="text-center">
                            @(plan.WorkingDate.HasValue
                                ? plan.WorkingDate.Value.ToString("dd/MM/yyyy HH:mm")
                                : "--")
                        </td>
                        <td>@(string.IsNullOrEmpty(plan.AddressMeeting) ? "--" : plan.AddressMeeting)</td>
                        <td>
                            @if (plan.RelatedPersons == null || !plan.RelatedPersons.Any())
                            {
                                <span class="text-muted">--</span>
                            }
                            else
                            {
                                foreach (var person in plan.RelatedPersons)
                                {
                                    <div class="plan-related-person-line">
                                        <div class="plan-related-person-name">
                                            @(string.IsNullOrEmpty(person.FullName) ? person.Username : person.FullName)
                                        </div>
                                        <div class="plan-related-person-unit">
                                            @(string.IsNullOrEmpty(person.TenBoPhan) ? "--" : person.TenBoPhan)
                                        </div>
                                    </div>
                                }
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(plan.Content))
                            {
                                <span class="text-muted">--</span>
                            }
                            else
                            {
                                <div id="@contentId" class="plan-truncate@(hasLongContent ? "" : " expanded")">@plan.Content</div>
                                if (hasLongContent)
                                {
                                    <button type="button" class="btn-toggle-more mt-1"
                                            onclick="togglePlanContent('@contentId', this)">
                                        <i class="fas fa-chevron-down mr-1"></i>Xem thêm
                                    </button>
                                }
                            }
                        </td>
                        <td class="text-center">
                            @if (canEdit)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border"
                                            type="button"
                                            data-toggle="dropdown"
                                            aria-haspopup="true"
                                            aria-expanded="false">
                                        <i class="fa fa-ellipsis-h"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        @if (relatedPersonUrl != null)
                                        {
                                            @Html.Button(
                                                true,
                                                "OpportunityPlanRelatedPerson",
                                                relatedPersonUrl,
                                                "<i class='fa fa-users mr-2 text-info'></i>",
                                                editRelatedPersonText,
                                                new
                                                {
                                                    @class = "dropdown-item",
                                                    title = editRelatedPersonText,
                                                    data_width = "1024"
                                                }
                                            )
                                        }
                                        @if (editUrl != null)
                                        {
                                            @Html.Button(
                                                true,
                                                "EditOpportunityPlan",
                                                editUrl,
                                                "<i class='fa fa-edit mr-2 text-primary'></i>",
                                                "Chỉnh sửa",
                                                new
                                                {
                                                    @class = "dropdown-item",
                                                    title = AppProcessor.Messagor.GetMessage("Button_Edit"),
                                                    data_width = "600"
                                                }
                                            )
                                        }
                                        @if (deleteUrl != null)
                                        {
                                            @Html.Button(
                                                true,
                                                "DeleteOpportunityPlan",
                                                deleteUrl,
                                                "<i class='fa fa-trash mr-2'></i>",
                                                "Xóa",
                                                new
                                                {
                                                    @class = "dropdown-item text-danger",
                                                    title = AppProcessor.Messagor.GetMessage("Button_Delete")
                                                }
                                            )
                                        }
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                    idx++;
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center">
        <i class="fas fa-calendar-times mr-2"></i>
        @AppProcessor.Messagor.GetMessage("OpportunityPlan_NoData")
    </div>
}

<script>
    if (CONVERTED == 1) {
        $('a[data-modal-id=AddOpportunityPlan]')
            .removeAttr('href')
            .removeAttr('data-modal')
            .removeAttr('data-modal-id')
            .attr('onclick', "$('a[data-modal-id=Notification]').click()")
    }
    function togglePlanContent(id, btn) {
        var el = document.getElementById(id);
        if (el.classList.contains('expanded')) {
            el.classList.remove('expanded');
            btn.innerHTML = '<i class="fas fa-chevron-down mr-1"></i>Xem thêm';
        } else {
            el.classList.add('expanded');
            btn.innerHTML = '<i class="fas fa-chevron-up mr-1"></i>Thu gọn';
        }
    }
</script>