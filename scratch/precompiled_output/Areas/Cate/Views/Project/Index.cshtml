@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ProjectSearchModel
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Project_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddProject", Url.Action("Add", new { area = "Cate" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right mr-1", data_width = "1024px" })

}

@Html.Partial("_Search", Model)

<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSProject" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Project_ProjectName_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("SuccessRate_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Title")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Project_StartDate_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Project_Status_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Cate/Views/Project/Project.js")?v=2"></script>
    <script type="text/javascript" src="@Url.Content("~/Contents/Modules/Major/ckeditor4/ckeditor.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Contents/Modules/Major/ckfinder/ckfinder.js")"></script>
}
