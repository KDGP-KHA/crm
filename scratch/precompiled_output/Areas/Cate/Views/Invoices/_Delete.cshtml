@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_InvoicesModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Invoices_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Invoices", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Invoices_OnProcessSuccess(data, 'DeleteInvoices')"
    }, new { @class = "form-horizontal", id = "DeleteInvoices" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.InvoiceID)
        @Html.HiddenFor(model => model.ContractID)
        @Html.HiddenFor(model => model.Serial)
        @Html.HiddenFor(model => model.Number)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}