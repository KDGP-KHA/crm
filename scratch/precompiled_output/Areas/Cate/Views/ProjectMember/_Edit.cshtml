@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ProjectMemberModel
@{
    ViewBag.Title = "Điều chỉnh " + AppProcessor.Messagor.GetMessage("ProjectMember_Title");
    Layout = "~/Views/Shared/_Form.cshtml";
}


@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Edit", "ProjectMember", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ProjectMember_OnProcessSuccess(data, 'EditProjectMember')"
    }, new { @class = "form-horizontal", id = "EditProjectMember" }))
    {
        <div id="bodyForm">
            @Html.Partial("_ProjectMember")
        </div>

    }
}