@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_BusinessPlanModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("RM_BusinessPlan_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "RM_BusinessPlan", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "BusinessPlan_OnProcessSuccess(data, 'DeleteBusinessPlan')"
    }, new { @class = "form-horizontal", id = "DeleteBusinessPlan" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.BusinessPlanID)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}