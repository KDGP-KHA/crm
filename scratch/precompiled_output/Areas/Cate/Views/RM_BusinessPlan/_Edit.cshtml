@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_BusinessPlanModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("RM_BusinessPlan_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{

    @using (Html.BeginForm("Edit", "RM_BusinessPlan", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "EditBusinessPlan", @class = "form-horizontal" }))
    {
        <div id="bodyFormEdit">
            @Html.Partial("_BusinessPlan")
        </div>

    }

    <script type="text/javascript">
        $('form#EditBusinessPlan').ajaxForm({
            success: function (response) {
                if (response.status != undefined) {
                    if ($("#ModalContent #modal_EditBusinessPlan #chkNotDismissModal").is(":checked")) {
                        if (response.status != undefined) {
                            eval(response.message);
                            _tableBusinessPlan.ajax.reload(null, false);
                            response.status = undefined;
                            $("#ModalContent #modal_EditBusinessPlan form")[0].reset();
                        }
                    } else {
                        if (!response.status && response.errorCode == 1) {
                            eval(response.message);
                            response.status = undefined;
                        } else {
                            $("#ModalContent #modal_EditBusinessPlan").modal("hide");
                            $("#ModalContent #modal_EditBusinessPlan").on('hidden.bs.modal',
                                function () {
                                    if (response.status != undefined) {
                                        eval(response.message);
                                        _tableBusinessPlan.ajax.reload(null, false);
                                        response.status = undefined;
                                    }
                                });
                        }
                    }
                } else {
                    $("#ModalContent #modal_EditBusinessPlan" + " #bodyForm").html(response);
                }
            }
        });
    </script>
}