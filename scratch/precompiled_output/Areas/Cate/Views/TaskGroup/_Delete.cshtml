@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_TaskGroupModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("TaskGroup_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}
@section FormType{
    danger
}
@section FormBody{
    @using (Ajax.BeginForm("Delete", "TaskGroup", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "TaskGroup_OnProcessSuccess(data, 'DeleteTaskGroup')"
    }, new { @class = "form-horizontal", id = "DeleteTaskGroup" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.TaskGroupID)
        @Html.HiddenFor(m => m.TaskGroupName)
        <h5>@Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}
