@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_AnniversaryTypeModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("AnniversaryType_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "AnniversaryType", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "AnniversaryType_OnProcessSuccess(data, 'DeleteAnniversaryType')"
    }, new { @class = "form-horizontal", id = "DeleteAnniversaryType" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.AnniversaryType_ID)
        @Html.HiddenFor(model => model.NameAnniversaryType)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}