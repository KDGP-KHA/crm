@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("BusinessOpportunity_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{

    @using (Html.BeginForm("Edit", "RM_BusinessOpportunity", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "EditBusinessOpportunity", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_CHKD_View")
        </div>
    }

    <script type="text/javascript">
        $('form#EditBusinessOpportunity').ajaxForm({
            success: function (response) {
                BusinessOpportunity_OnProcessSuccess(response, "EditBusinessOpportunity");
            }
        });
    </script>
}