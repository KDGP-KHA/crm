@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("ProjectTask_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}
@section FormType{
    primary
}
@section FormIcon{
    <i class="far fa-edit"></i>
}
@section FormBody{
    @using (Ajax.BeginForm("Edit", "ProjectTask", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnBegin = "ProjectTask_BeforeSubmit()",
        OnSuccess = "ProjectTask_OnProcessSuccess(data, 'EditProjectTask')"
    }, new { @class = "form-horizontal", id = "EditProjectTask" }))
    {
        <div id="bodyForm">
            @{ Html.RenderPartial("_ProjectTask", (Core.Cate.Models.RM_ProjectTaskModel)Model); }
        </div>
    }
    <script>
        function ProjectTask_BeforeSubmit() {
            var selected = $('#AssignedEmployeeIDs_Multi').val();
            if (selected && selected.length > 0) {
                $('#hiddenAssignedEmployeeIDs').val(selected.join(','));
            } else {
                $('#hiddenAssignedEmployeeIDs').val('');
            }
        }
    </script>
}