@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ProjectTaskModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ProjectTask_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}
@section FormType{
    danger
}
@section FormBody{
    @using (Ajax.BeginForm("Delete", "ProjectTask", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ProjectTask_OnProcessSuccess(data, 'DeleteProjectTask')"
    }, new { @class = "form-horizontal", id = "DeleteProjectTask" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ProjectTaskID)
        @Html.HiddenFor(model => model.TaskManagementID)
        @Html.HiddenFor(model => model.IsTaskManagementSource)
        @Html.HiddenFor(model => model.TaskName)
        <h5>@Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}
