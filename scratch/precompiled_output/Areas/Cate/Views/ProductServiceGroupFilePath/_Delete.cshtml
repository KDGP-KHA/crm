@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ProductServiceGroupFilePathModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ProductServiceGroupFilePath_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "ProductServiceGroupFilePath", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ProductServiceGroupFilePath_OnProcessSuccess(data, 'DeleteProductServiceGroupFilePath')"
    }, new { @class = "form-horizontal", id = "DeleteProductServiceGroupFilePath" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ProductServiceID)
        @Html.HiddenFor(model => model.GroupFilePathID)
        @Html.HiddenFor(model => model.Title)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}