@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("ProductServiceGroupFilePath_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Html.BeginForm("Add", "ProductServiceGroupFilePath", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "AddProductServiceGroupFilePath", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_ProductServiceGroupFilePath")
        </div>

    }
    <script type="text/javascript">
        $(document).ready(function () {
            $('#modal_AddProductServiceGroupFilePath .modal-dialog').addClass('modal-dialog-scrollable');
            $('#modal_AddProductServiceGroupFilePath .modal-body').addClass('ace-scrollbar');
        });

        $('form#AddProductServiceGroupFilePath').ajaxForm({
            success: function (response) {
                ProductServiceGroupFilePath_OnProcessSuccess(response,'AddProductServiceGroupFilePath')
            }
        });
    </script>
}

