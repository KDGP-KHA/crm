@using System.Collections.Generic
@using System.Linq
@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_ProductServiceModel

@{
    List<Core.Cate.Models.Cate_ProductServiceModel> treeItems =
        (Model.selectListItems ?? new List<Core.Cate.Models.Cate_ProductServiceModel>())
        .OrderBy(item => item.SortPath)
        .ToList();
}

@Html.AntiForgeryToken()
<div id="Language">
    @Html.HiddenFor(model => model.ProductServiceID)
    @Html.HiddenFor(model => model.GroupServiceID, new { id = "ProductService_GroupServiceID" })
    @Html.HiddenFor(model => model.ParentProductID, new { id = "ProductService_ParentProductID" })

    <div class="row">
        <label class="col-sm-12 col-form-label text-sm-left pr-0 font-bold">
            Nhóm dịch vụ / sản phẩm cha
        </label>
        <div class="col-md-12">
            <select id="ProductService_HierarchySelection"
                    class="form-control col-md-12">
                <option value="">-- Chọn nhóm dịch vụ / sản phẩm cha --</option>
                @foreach (Core.Cate.Models.Cate_ProductServiceModel item in treeItems)
                {
                    bool isGroup = string.Equals(item.NodeType, "G", System.StringComparison.OrdinalIgnoreCase);
                    bool isCurrentProduct = !isGroup && item.ProductServiceID == Model.ProductServiceID;
                    string optionValue = isGroup
                        ? string.Format("G_{0}", item.GroupServiceID)
                        : string.Format("P_{0}", item.ProductServiceID);
                    string optionText = !string.IsNullOrWhiteSpace(item.NameProductView)
                        ? item.NameProductView
                        : item.NameProduct;

                    <option value="@optionValue"
                            data-node-type="@item.NodeType"
                            data-group-id="@item.GroupServiceID"
                            data-parent-product-id="@(isGroup ? 0 : item.ProductServiceID)"
                            @(isCurrentProduct ? "disabled=\"disabled\"" : string.Empty)>
                        @optionText
                    </option>
                }
            </select>
            <small class="form-text text-muted">
                Chọn nhóm dịch vụ để tạo sản phẩm cấp gốc, hoặc chọn sản phẩm để gán làm sản phẩm cha.
            </small>
            @Html.ValidationMessageFor(model => model.GroupServiceID, "", new { @class = "text-danger d-block mt-1" })
        </div>
    </div>

    <div class="row">
        @Html.TitleFor(model => model.NameProduct, new { @class = "col-sm-12 col-form-label text-sm-left pr-0 font-bold" })
        <div class="col-md-12">
            @Html.TextBoxFor(model => model.NameProduct, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_Code") })
            @Html.ValidationMessageFor(model => model.NameProduct, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="row">
                @Html.TitleFor(model => model.CodeProduct, new { @class = "col-sm-12 col-form-label text-sm-left pr-0 font-bold" })
                <div class="col-md-12">
                    @Html.TextBoxFor(model => model.CodeProduct, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_Code") })
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="row">
                @Html.TitleFor(model => model.ShortNameProduct, new { @class = "col-sm-12 col-form-label text-sm-left pr-0 font-bold" })
                <div class="col-md-12">
                    @Html.TextBoxFor(model => model.ShortNameProduct, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_ShortNameProduct") })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <label>
                @Html.CheckBoxFor(model => model.IsActived)
                @Html.LabelFor(model => model.IsActived, new { @class = "col-form-label pr-0 font-bold" })
            </label>
        </div>
    </div>

