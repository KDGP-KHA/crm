@using TSFramework.Libs.Processors
@model Core.Cate.Models.Cate_ProductServiceModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("RM_ProductService_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-Add"></i>
}

@section FormBody{

    @using (Html.BeginForm("Add", "ProductService", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "AddProductService", @class = "form-horizontal" }))
    {
        <div id="bodyFormAdd">
            @Html.Partial("_ProductService")
        </div>

    }

    <script type="text/javascript">
        $('form#AddProductService').ajaxForm({
            success: function (response) {
                if (response.status != undefined) {
                    if ($("#ModalContent #modal_AddProductService #chkNotDismissModal").is(":checked")) {
                        if (response.status != undefined) {
                            eval(response.message);
                            ProductService_LoadData();
                            response.status = undefined;
                            $("#ModalContent #modal_AddProductService form")[0].reset();
                        }
                    } else {
                        if (!response.status && response.errorCode == 1) {
                            eval(response.message);
                            response.status = undefined;
                        } else {
                            $("#ModalContent #modal_AddProductService").modal("hide");
                            $("#ModalContent #modal_AddProductService").on('hidden.bs.modal',
                                function () {
                                    if (response.status != undefined) {
                                        eval(response.message);
                                        ProductService_LoadData();
                                        response.status = undefined;
                                    }
                                });
                        }
                    }
                } else {
                    $("#ModalContent #modal_AddProductService" + " #bodyForm").html(response);
                }
            }
        });
    </script>
}