@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_SalesTeamMembersFormModel
@{
    ViewBag.Title = "Thêm " + AppProcessor.Messagor.GetMessage("SalesTeamMembers_Title");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Add", "SalesTeamMembers", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "SalesTeamMembers_OnProcessSuccess(data, 'AddSalesTeamMembers')"
    }, new { @class = "form-horizontal", id = "AddSalesTeamMembers" }))
    {
        <div id="bodyForm">
            @Html.Partial("_AddSalesTeamMembers")
        </div>
    }
}
