@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_SalesTeamMembersModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("SalesTeamMembers_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "SalesTeamMembers", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "SalesTeamMembers_OnProcessSuccess(data, 'DeleteSalesTeamMembers')"
    }, new { @class = "form-horizontal", id = "DeleteSalesTeamMembers" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.MemberID)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}