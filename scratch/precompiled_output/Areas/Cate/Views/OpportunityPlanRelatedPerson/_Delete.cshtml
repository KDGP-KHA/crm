@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_OpportunityPlanRelatedPersonModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("OpportunityPlanRelatedPerson_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "OpportunityPlanRelatedPerson", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "OpportunityPlanRelatedPerson_OnProcessSuccess(data, 'DeleteOpportunityPlanRelatedPerson')"
    }, new { @class = "form-horizontal", id = "DeleteOpportunityPlanRelatedPerson" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        <h5>@Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}
