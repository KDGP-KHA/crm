@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_Employee_BusinessPlanModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("EmployeeBusinessPlan_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "EmployeeBusinessPlan", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "EmployeeBusinessPlan_OnProcessSuccess(data, 'DeleteEmployeeBusinessPlan')"
    }, new { @class = "form-horizontal", id = "DeleteEmployeeBusinessPlan" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.EmployeeBusinessPlanID)
        @Html.HiddenFor(model => model.FullName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}