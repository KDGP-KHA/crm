@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("EmployeeBusinessPlan_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Edit", "EmployeeBusinessPlan", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "EmployeeBusinessPlan_OnProcessSuccess(data, 'EditEmployeeBusinessPlan')"
    }, new { @class = "form-horizontal", id = "EditEmployeeBusinessPlan" }))
    {
        <div id="bodyForm">
            @Html.Partial("_EmployeeBusinessPlan")
        </div>
    }
}