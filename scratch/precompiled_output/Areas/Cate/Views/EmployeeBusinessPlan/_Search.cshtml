<div class="Search card mb-2" id="card-1" draggable="false">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>

    <div class="card-body p-2 d-flex align-items-end">
        <div class="Search_Box">
            @Html.TitleFor(model => model.Year, new { @class = "text-sm-right pr-0 font-bold" })
            @Html.TextBoxFor(model => model.Year, new { @class = "form-control", type = "number", min = "1900", max = "2100", step = "1", oninput = "this.value = this.value.slice(0,4)", placeholder = AppProcessor.Messagor.GetMessage("Year_Label") })
        </div>

        <div class="Search_Box w-50 dropdownList">
            @Html.TitleFor(model => model.BoPhanID, new { @class = "text-sm-right pr-0 font-bold" })
            @Html.DropDownListFor(model => model.BoPhanID, new SelectList(Model.ListBoPhan, "BoPhan_ID", "TenBoPhanDisplay"), "", new { @class = "form-control" })
        </div>

        <div class="Group Group_button">
            <div class="Search_button">
                <button type="button" class="btn btn-primary" onclick="SearchEmployeeBusiness()">
                    <i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>
            <div class="Search_button">
                <button type="button" class="btn btn-warning ml-2" id="btnExportEmployeeBusinessPlan" title="Xuất danh sách ra Excel">
                    <i class="fa fa-download"></i>&nbsp;Tải danh sách
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#Year").datetimepicker({
            "format": "YYYY",
        });
        $('#Year').on('change keyup', function (e) {
            if (e.key === 'Enter' || e.type === 'change') {
                SearchEmployeeBusiness();
            }
        });
        $('#BoPhanID').on('change', function () {
            SearchEmployeeBusiness();
        });
    });
</script>