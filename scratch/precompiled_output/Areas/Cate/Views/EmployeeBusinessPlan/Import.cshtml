@using TSFramework.Libs.Processors
@model Core.Cate.Models.Import_Employee_BusinessPlanModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Import"), AppProcessor.Messagor.GetMessage("EmployeeBusinessPlan_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fas fa-file-import"></i>
}

@section SubmitControl{}

@section FormBody{
    <div class="btn-right">
        @Html.Button(true, "ImportData", Url.Action("ImportData", new { area = "Cate", key = Model.Key }), "<i class='fas fa-file-import'></i>", AppProcessor.Messagor.GetMessage("Button_ImportBusinessPlan"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right float-right" })
        @Html.Button(true, "Clear", Url.Action("Clear", new { area = "Cate", key = Model.Key }), "<i class='fas fa-trash'></i>", AppProcessor.Messagor.GetMessage("Button_Clear"), new { @class = "btn btn-light-danger btn-h-danger btn-a-danger border-0 radius-3 py-2 text-600 text-90" })
        @Html.Button(true, "SaveImport", Url.Action("SaveImport", new { area = "Cate", key = Model.Key }), "<i class='fas fa-save'></i>", AppProcessor.Messagor.GetMessage("Button_Save"), new { @class = "btn btn-light-success btn-h-success btn-a-success border-0 radius-3 py-2 text-600 text-90" })
    </div>
    <div class="mt-3" id="box">
        @Html.HiddenFor(m => m.Key)
        <div class="card dcard">
            <div class="col-sm-12 table-responsive-md">
                <table id="DSImportEmployeeBusinessPlan" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table">
                    <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                        <tr>
                            <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                            <th>@AppProcessor.Messagor.GetMessage("BoPhan_Title")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Employee_Title")</th>
                            <th>@AppProcessor.Messagor.GetMessage("RevenueTarget_Label")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Responsibility_Revenue_Label")</th>
                            <th>@AppProcessor.Messagor.GetMessage("BusinessPlan_Note_Label")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Column_Error")</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
    <script src="@Url.Content("~/Areas/Cate/Views/EmployeeBusinessPlan/ImportEmployeeBusinessPlan.js")"></script>
}