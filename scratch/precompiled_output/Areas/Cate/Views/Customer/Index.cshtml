@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Customer_Title");
}
@section PageTitle { @ViewBag.Title }
@section PageAction {
    @Html.Button(true, "AddCustomer", Url.Action("Add", new { area = "Cate" }),
                        "<i class='fa fa-plus'></i>",
                        AppProcessor.Messagor.GetMessage("Button_Add"),
                        new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 mr-2 text-600 text-90 pull-right", data_width = "1024px" })

    @Html.Button(true, "ImportCustomer", Url.Action("Import", new { area = "Cate" }),
                        "<i class='fa fa-upload'></i>",
                        AppProcessor.Messagor.GetMessage("Button_Import"),
                        new { @class = "btn btn-light-green btn-h-green btn-a-green border-0 radius-3 py-2 text-600 text-90 pull-right mr-1", data_width = "1024px" })

}
@Html.Partial("_Search")
<div class="mt-1">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSCustomer" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_ShortName_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_CustomerName_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("CustomerType_Title")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Email_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Phone_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Status_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section BottomScript {
    <script src="@Url.Content("~/Areas/Cate/Views/Customer/Customer.js")"></script>

}
