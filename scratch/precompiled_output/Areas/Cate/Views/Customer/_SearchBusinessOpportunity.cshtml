@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_BusinessOpportunitySearchModel

<div class="card bcard border-0 shadow-sm radius-0" id="SearchBusinessOpportunity">
    <div class="card-header bgc-primary-d1">
        <h5 class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </h5>
        <div class="card-toolbar">
            <a href="#" data-action="toggle" class="card-toolbar-btn text-white">
                <i class="fa fa-chevron-up"></i>
            </a>
        </div>
    </div>
    <div class="col-md-12 mt-3">
        <div class="form-group row">
            <label class="col-md-1 col-form-label font-bold text-sm-right pr-0">Sản phẩm dịch vụ</label>
            <div class="col-sm-11">
                @Html.DropDownListFor(model => model.ProductServiceID, new SelectList(Model.ProductServices.Where(p => p.NodeType == "P").ToList(), "pID", "DisplayName"), "", new { @class = "form-control", data_placeholder = "Tìm theo sản phẩm dịch vụ" })
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-1 col-form-label font-bold text-sm-right pr-0">Trạng thái</label>
            <div class="col-sm-4">
                @Html.DropDownListFor(model => model.StatusID, new SelectList(Model.StatusList, "ID", "StatusName"), "", new { @class = "form-control", data_placeholder = "Tìm theo trạng thái" })
            </div>
            <label class="col-md-2 col-form-label font-bold text-sm-right pr-0">Nhân viên</label>
            <div class="col-sm-5">
                @Html.DropDownListFor(model => model.EmployeeID, new SelectList(Model.Employees, "Employee_ID", "FullName"), "", new { @class = "form-control", data_placeholder = "Tìm theo nhân viên" })
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="col-md-12 text-center">
            <button type="button" class="btn btn-primary" onclick="Search()"><i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")</button>
        </div>
    </div>
</div>

<style>
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-left.datepicker-orient-bottom {
        z-index: 1000 !important;
    }

    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-right.datepicker-orient-bottom {
        z-index: 1000 !important;
    }
</style>

<script>
    // Lặp qua tất cả các option của dropdown (ví dụ dùng thư viện select2 hoặc select thông thường)
    $('select option').each(function () {
        var text = $(this).text();
        // Thay thế tất cả cụm &nbsp; thành rỗng
        $(this).text(text.replace(/&nbsp;/g, "\u00A0"));
    });
</script>