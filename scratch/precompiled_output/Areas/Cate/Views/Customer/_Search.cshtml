@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_CustomerSearchModel

<div class="Search card dcard" id="SearchCustomer">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>

    <div class="card-body p-2 d-flex align-items-end">
        <div class="Search_Box w-25 keyWord">
            <label class="font-bold text-sm-right">@AppProcessor.Messagor.GetMessage("Label_TuKhoa")</label>
            @Html.TextBoxFor(model => model.Keyword, new { @class = "form-control", placeholder = @AppProcessor.Messagor.GetMessage("Customer_Keyword") })
        </div>

        <div class="Group">
            <div class="Search_Box">
                @Html.TitleFor(model => model.CustomerTypeID, new { @class = "font-bold text-sm-right" })
                <div class="">
                    @Html.DropDownListFor(model => model.CustomerTypeID, new SelectList(Model.ListCustomerType, "Value", "Text"), "", new { @class = "form-control", data_placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                </div>
            </div>

            <div class="Search_Box">
                @Html.TitleFor(model => model.CustomerStatusID, new { @class = "font-bold text-sm-right" })
                <div class="">
                    @Html.DropDownListFor(model => model.CustomerStatusID, new SelectList(Model.ListStatus, "Value", "Text"), "", new { @class = "form-control", data_placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                </div>
            </div>
        </div>

        <div class="Group Group_button">
            <div class="Search_button">
                <button type="button" class="btn btn-primary" style="width: max-content" onclick="_tableCustomer.ajax.reload(null, false);">
                    <i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>

            <div class="Search_button">
                <button type="button" id="btnExportCustomer" class="btn btn-warning border-0 ml-2" style="width: max-content">
                    <i class="fa fa-download"></i>
                    <span>@AppProcessor.Messagor.GetMessage("Button_Export")</span>
                </button>
            </div>
        </div>

    </div>
</div>

<script>
    $(document).ready(function () {
        $('#SearchCustomer').on('keydown', 'input, select', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                _tableCustomer.ajax.reload(null, false);
            }
        });
        $('#SearchCustomer').on('change', 'select', function () {
            _tableCustomer.ajax.reload(null, false);
        });
    });
</script>