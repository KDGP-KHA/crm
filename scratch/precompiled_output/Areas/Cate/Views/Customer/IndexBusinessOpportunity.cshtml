@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_BusinessOpportunitySearchModel
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("BusinessOpportunity_Title");
}

@section PageTitle
{
    @ViewBag.Title
}


<div style="text-align: right; margin-bottom: 4px;">
    @Html.Button(
        true,
        "AddBusinessOpportunity",
        Url.Action("AddCHKD", new { area = "Cate", CustomerID = Model.CustomerID }),
        "<i class='fa fa-plus'></i>",
        AppProcessor.Messagor.GetMessage("Button_Add"),
        new
            {
            @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90",
            data_width = "1024px"
        }
    )
</div>
@Html.Partial("_SearchBusinessOpportunity")
<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSBusinessOpportunity" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_CustomerName_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ProductService_Title")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Employee_Title")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ExpectedValue_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ClosingProbability_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Status_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ExpectedDate_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<script type="text/javascript">
    var _BusinessOpportunityActionURLs = {
        BusinessOpportunity_GetData: "/Cate/Customer/GetBusinessOpportunity"
    };
    var _tableBusinessOpportunity;
    $(document).ready(function () {
        initTableBusinessOpportunity();
    });

    function Search() {
        _tableBusinessOpportunity.ajax.reload(null, false);
    }

    function initTableBusinessOpportunity() {
        _tableBusinessOpportunity = $("#DSBusinessOpportunity").DataTable({
            "Responsive": true,
            "BusinessOpportunity": {
                "processing":
                    "<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
            },
            "lengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax":
            {
                "url": _BusinessOpportunityActionURLs.BusinessOpportunity_GetData,
                "type": "POST",
                "dataType": "JSON",
                "data": {
                    "CustomerID": '@Model.CustomerID',
                    "ProductServiceID": function () { return $("#SearchBusinessOpportunity #ProductServiceID").val(); },
                    "EmployeeID": function () { return $("#SearchBusinessOpportunity #EmployeeID").val(); },
                    "StatusID": function () { return $("#SearchBusinessOpportunity #StatusID").val(); }

                }
            },
            "columns": [
                {
                    "data": "",
                    "defaultContent": "1",
                    "render": function (data, type, row, meta) {
                        return meta.settings._iDisplayStart + meta.row + 1;
                    }
                },
                {
                    "data": "CustomerName",
                    "defaultContent": "",
                    "render": function (data, type, row, meta) {
                        return data;
                    }
                },
                {
                    "data": "ProductServiceNames",
                    "defaultContent": "",
                    "render": function (data, type, row, meta) {
                        return data ? data.split(";").map(v => `<p class="mb-0">${v}</p>`).join("") : "";
                    }
                },
                {
                    "data": "EmployeeNames",
                    "defaultContent": "",
                    "render": function (data, type, row, meta) {
                        return data ? data.split(";").map(v => `<p class="mb-0 text-left">- ${v}</p>`).join("") : "";
                    }
                },
                {
                    "data": "ExpectedValue",
                    "defaultContent": "",
                    "render": function (data, type, row, meta) {
                        return data;
                    }
                },
                {
                    "data": "ClosingProbability",
                    "defaultContent": "",
                    "render": function (data, type, row, meta) {
                        return data;
                    }
                },
                {
                    "data": "StatusName",
                    "defaultContent": "",
                    "render": function (data, type, row, meta) {
                        return `<span class="badge ${row.StatusClass} text-white mr-1"> ${data} </span>`;
                    }
                },
                {
                    "data": "ExpectedDate",
                    "defaultContent": "",
                    "render": function (data, type, row, meta) {
                        return data != null ? moment(data).format("DD/MM/YYYY") : "";
                    }
                },
                {
                    "data": "BusinessOpportunityID",
                    "defaultContent": "",
                    "render": function (data, type, row, meta) {
                        var html = '<span class="">';
                        if (type === "display") {
                            html += '<div class="dropdown d-inline-block"><button class="btn btn-lighter-primary mr-1 dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa fa-ellipsis-h text-120"></i></button><div class="dropdown-menu dropdown-menu-right">';
                            html += _renderButton(true,
                                "EditBusinessOpportunity",
                                "btn btn-lighter-primary mr-1 btn-a-outline-primary dropdown-item",
                                "/Cate/Customer/EditCHKD/" + data,
                                '<i class="far fa-edit text-primary text-120 mr-1"></i> Cập nhật',
                                "Cập nhật", 1024);
                            html += _renderButton(true,
                                "DeleteBusinessOpportunity",
                                "btn btn-lighter-danger mr-1 btn-a-outline-danger dropdown-item",
                                "/Cate/Customer/DeleteCHKD/" + data,
                                '<i class="far fa-trash-alt text-danger text-120 mr-1"></i> Xoá',
                                "Xoá");
                            html += '</div></div>';
                        }
                        html += "</span>";
                        return html;
                    }
                }
            ]
        });
    }


    function BusinessOpportunity_OnProcessSuccess(response, formId) {
        if (response.status != undefined) {
            if ($("#ModalContent #modal_" + formId + " #chkNotDismissModal").is(":checked")) {
                if (response.status != undefined) {
                    eval(response.message);
                    _tableBusinessOpportunity.ajax.reload(null, false);
                    response.status = undefined;
                    //$("#ModalContent #modal_" + formId + " form")[0].reset();
                    var urlAction = $("#ModalContent #modal_" + formId + " form").attr("action");
                    $("#ModalContent #modal_" + formId + " #modal-content").load(urlAction, function (data, textStatus, xhr) {
                        _initElement();
                    });
                }
            } else {
                $("#ModalContent #modal_" + formId).modal("hide");
                $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                    function () {
                        if (response.status != undefined) {
                            eval(response.message);
                            _tableBusinessOpportunity.ajax.reload(null, false);
                            response.status = undefined;
                        }
                    });
            }
        } else {
            $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
        }
    }

</script>