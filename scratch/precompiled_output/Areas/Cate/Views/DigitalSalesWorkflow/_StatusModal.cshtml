@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesStatusModel

@{
    var isNew = Model.StatusID == 0;
    ViewBag.Title = (isNew ? "Thêm mới" : "Cập nhật") + " Trạng thái " + (Model.BusinessType == 1 ? "Cơ hội" : "Dự án");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-@(isNew ? "plus" : "pencil-alt")"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("SaveStatus", "DigitalSalesWorkflow", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "DigitalSalesWorkflow.onStatusSaveSuccess(data)"
    }, new { @class = "form-horizontal", id = "formStatusModal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_StatusForm", Model)
        </div>
    }
}
