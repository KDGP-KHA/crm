@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("Task_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}
@section FormType { primary }
@section FormIcon { <i class="far fa-edit"></i> }
@section FormBody {
    @using (Ajax.BeginForm("Edit", "Comment", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Comment_OnProcessSuccess(datam 'EditComment')"
    }, new { @class = "form-horizontal", id = "EditComment", enctype = "multipart/form-data" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Comment")
        </div>
    }
}
