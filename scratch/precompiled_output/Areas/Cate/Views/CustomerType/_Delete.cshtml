@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_CustomerTypeModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("GroupCustomerType_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "CustomerType", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "CustomerType_OnProcessSuccess(data, 'DeleteCustomerType')"
    }, new { @class = "form-horizontal", id = "DeleteCustomerType" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CustomerTypeID)
        @Html.HiddenFor(model => model.CustomerTypeName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}