@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ExchangeHistoryModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("RM_ExchangeHistory_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "RM_ExchangeHistory", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ExchangeHistory_OnProcessSuccess(data, 'DeleteExchangeHistory')"
    }, new { @class = "form-horizontal", id = "DeleteExchangeHistory" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ExchangeHistoryID)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}