@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("RM_ExchangeHistory_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{

}

<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSExchangeHistory" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ExchangeDate_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Status_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Contact_Content")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Cate/Views/RM_ExchangeHistory/ExchangeHistory.js"></script>
}