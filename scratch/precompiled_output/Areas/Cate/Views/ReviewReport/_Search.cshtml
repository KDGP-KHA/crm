@using TSFramework.Libs.Processors
@model Core.Cate.Models.ReviewReportSearchModel

<div class="Search card dcard" id="SearchOpportunityProjectWithoutPGP">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>

    <div class="card-body p-2 d-flex align-items-end">
        <div class="Search_Box year-box ">
            <label class="font-bold">@AppProcessor.Messagor.GetMessage("ReviewBatch_Title")</label>
            @Html.DropDownListFor(model => model.ReviewBatchID, new SelectList(Model.ListReviewPatch, "ReviewBatchID", "BatchName"), "", new { @class = "form-control", id = "ReviewBatchID" })
        </div>

        <div class="Group Group_button">
            <div class="Search_button">
                <button type="button" class="btn btn-primary" style="width: max-content" onclick="_tableReviewReport.ajax.reload(null, false);">
                    <i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>

            <div class="Search_button">
                <button type="button" id="btnExportReport" class="btn btn-warning border-0 ml-2" style="width: max-content" onclick="ExportReviewReport()">
                    <i class="fa fa-download"></i>
                    <span>@AppProcessor.Messagor.GetMessage("Button_ExportExcel")</span>
                </button>
            </div>
        </div>

    </div>
</div>