@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_TaskManagementModel

<div class="p-3 border rounded">
    <div class="d-flex justify-content-between">
        <p><b>@AppProcessor.Messagor.GetMessage("Task_Type_Label"):</b> @Model.TaskTypeName</p>
        <div class="text-right">
            @Html.Button(false, "EditTaskManagement",
            Url.Action("Edit", "TaskManagement", new { area = "Cate", id = Model.TaskManagementID }),
            " <i class='fa fa-edit'></i>",
            AppProcessor.Messagor.GetMessage("LogTask_Edit_Label"),
            new
            {
                @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 ml-2",
                data_width = "700px",
            })

            @Html.Button(false, "AddTaskManagement",
                Url.Action("Add", "TaskManagement", new { area = "Cate", id = Model.ProjectID, parentTaskId = Model.TaskManagementID }),
                "<i class='fa fa-plus'></i>",
                AppProcessor.Messagor.GetMessage("Button_AddChild_Task"),
                new
                {
                    @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 ml-2",
                    data_width = "700px",
                })
        </div>
    </div>
    <div >
        <h4 class="text-primary mb-1 font-weight-bold">#@Model.TaskManagementID - @Model.TaskName</h4>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <p><b>@AppProcessor.Messagor.GetMessage("Task_Status_Label"):</b>
                <span class="badge @Model.StatusClass text-white mr-1">
                    @Model.StatusName
                </span>
            </p>
            <p><b>@AppProcessor.Messagor.GetMessage("Priority_Label"):</b>
               <span class="badge badge-@Model.PriorityClass @(string.IsNullOrEmpty(Model.PriorityClass) ? "" : "text-white") mr-1">
                   @Model.PriorityName
               </span>
            </p>
            <p class="d-flex"><b>@AppProcessor.Messagor.GetMessage("Task_Assignee_Label"):</b>
               <span class="d-flex flex-wrap ml-1">
                   @{
                       var assignees = (Model.AssigneeNames ?? "")
                           .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);

                       foreach (var item in assignees)
                       {
                           <span class="badge badge-info text-white mr-1 mb-1 px-2 py-1">
                               <i class="fa fa-user mr-1"></i>
                               @item.Trim()
                           </span>
                       }
                   }
               </span>
            </p>
            <p><b>@AppProcessor.Messagor.GetMessage("TaskManagement_EstimatedHours_Label"):</b> @(Model.EstimatedHours != 0 ? Model.EstimatedHours : 0)</p>
        </div>

        <div class="col-md-6">
            <p>
                <b>@AppProcessor.Messagor.GetMessage("Task_StartDate_Label"):</b>
                @(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "—")
            </p>
            <p>
                <b>@AppProcessor.Messagor.GetMessage("Task_EndDate_Label"):</b>
                @(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd/MM/yyyy") : "—")
            </p>
            <p>
                <b>% @AppProcessor.Messagor.GetMessage("ProjectTask_CompletedDate"):</b>
                @(Model.CompletionPercentage ?? 0) %
            </p>
            <p>
                <b>@AppProcessor.Messagor.GetMessage("TaskManagement_ActualHours_Label"):</b>
                @(Model.ActualHours ?? 0)
            </p>
        </div>
    </div>

    <div class="mt-3">
        <b>@AppProcessor.Messagor.GetMessage("TaskManagement_Description_Label"):</b>
            @Html.Raw(Model.Description)
    </div>
    <div class="mt-3">
        <b>
            @AppProcessor.Messagor.GetMessage("TaskManagement_Files_Label"):
        </b>

        @if (Model.FilePaths != null && Model.FilePaths.Any())
        {
            <div class="mt-2">

                @foreach (var file in Model.FilePaths)
                {
                    var ext = System.IO.Path
                        .GetExtension(file.FilePath)?
                        .ToLower();

                    var icon = "fa-file text-secondary";

                    if (new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" }.Contains(ext))
                    {
                        icon = "fa-file-image text-success";
                    }
                    else if (ext == ".pdf")
                    {
                        icon = "fa-file-pdf text-danger";
                    }
                    else if (new[] { ".doc", ".docx" }.Contains(ext))
                    {
                        icon = "fa-file-word text-primary";
                    }
                    else if (new[] { ".xls", ".xlsx" }.Contains(ext))
                    {
                        icon = "fa-file-excel text-success";
                    }

                    var fileName = System.IO.Path.GetFileName(file.FilePath);

                    <div class="d-flex justify-content-between align-items-center border rounded px-3 py-2 mb-2">

                        <div>
                            <i class="fa @icon mr-2"></i>

                            <a href="@file.FilePath"
                               target="_blank">
                                @fileName
                            </a>

                            <small class="text-muted ml-2">
                                @(file.CreatedDate?.ToString("dd/MM/yyyy HH:mm"))
                            </small>
                        </div>

                        @Html.Button(true, "DeleteFileComment",
                           Url.Action("DeleteFile", "Comment", new { area = "Cate", id = file.FilePathID }),
                           "<i class='fa fa-trash'></i>",
                           "",
                           new
                           {
                               @class = "btn btn-sm btn-outline-danger",
                           })

                    </div>
                }

            </div>
        }
        else
        {
            <div class="text-muted mt-2">
                Chưa có file đính kèm
            </div>
        }
    </div>
</div>