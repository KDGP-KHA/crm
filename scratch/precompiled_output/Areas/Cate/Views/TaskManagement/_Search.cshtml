@using TSFramework.Libs.Processors
@{
    var taskGroups = ViewBag.TaskGroups as List<Core.Cate.Models.RM_TaskGroupModel> ?? new List<Core.Cate.Models.RM_TaskGroupModel>();
}
<div class="Search w-50" id="SearchTaskManagement">
    <div class="d-flex align-items-end">

        <div class="Search_Box w-75 keyWord">
            <label class="font-bold text-sm-right">
                @AppProcessor.Messagor.GetMessage("Label_TuKhoa")
            </label>
            <div>
                <input type="text" id="filterKeyword" class="form-control"
                       placeholder="@AppProcessor.Messagor.GetMessage("Task_Name_Label")" />
            </div>
        </div>

        <div class="Group Group_button">
            <div class="Search_button">
                <button type="button" class="btn btn-primary" onclick="Search()">
                    <i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>
        </div>
    </div>
</div>