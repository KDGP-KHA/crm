@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ReviewBatchModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ReviewBatch_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "ReviewBatch", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ReviewBatch_OnProcessSuccess(data, 'DeleteReviewBatch')"
    }, new { @class = "form-horizontal", id = "DeleteReviewBatch" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ReviewBatchID)
        @Html.HiddenFor(model => model.BatchName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}