@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ContractsModel
@{
    int slNgayNhac = Model.ListContractReminders != null ? Model.ListContractReminders.Count : 0;
}
@Html.AntiForgeryToken()
<style>
    #hide_remove_select2-selection__clear button.select2-selection__clear {
        display: none !important;
    }

    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-left.datepicker-orient-bottom,
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-left.datepicker-orient-top {
        z-index: 9999 !important;
    }
</style>
<div id="CHKD">
    @Html.HiddenFor(model => model.ContractID)
    @Html.HiddenFor(model => model.ProjectID)
    @Html.HiddenFor(model => model.ProductProjectID)
    @Html.HiddenFor(model => model.CustomerID)
    @Html.Hidden("SLDeXuat", slNgayNhac)

    <div class="form-group row">
        <div class="col-md-3">
            @Html.TitleFor(model => model.ContractCode, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.ContractCode, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("ContractCode_Label_Name") })
            @Html.ValidationMessageFor(model => model.ContractCode, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-9">
            @Html.TitleFor(model => model.ContractName, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.ContractName, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("ContractName_Label") })
            @Html.ValidationMessageFor(model => model.ContractName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            @Html.TitleFor(model => model.StatusContract, new { @class = "font-bold" })
            @Html.DropDownListFor(model => model.StatusContract,
                                                                                                                                                                                                    new SelectList(Model.ListStatus ?? new List<System.Web.Mvc.SelectListItem>(), "Value", "Text", Model.StatusContract),
                                                                                                                                                                                                    "-- Chọn trạng thái --",
                                                                                                                                                                                                    new { @class = "form-control select2" })
            @Html.ValidationMessageFor(model => model.StatusContract, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-4">
            @Html.TitleFor(model => model.BillingCycleID, new { @class = "font-bold" })
            @Html.DropDownListFor(model => model.BillingCycleID, new SelectList(Model.ListBillingCycles, "Value", "Text"), "", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.BillingCycleID, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-3">
            @Html.TitleFor(model => model.SignDate, new { @class = " font-bold" })
            @Html.TextBoxFor(model => model.SignDate, "{0:dd/MM/yyyy}", new { id = "SignDate", @class = "form-control dateinput", placeholder = "dd/mm/yyyy" })
            @Html.ValidationMessageFor(model => model.SignDate, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.TitleFor(model => model.StartDate, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.StartDate, "{0:dd/MM/yyyy}", new { id = "StartDate", @class = "form-control dateinput", placeholder = "dd/mm/yyyy" })
            @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.TitleFor(model => model.EndDate, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.EndDate, "{0:dd/MM/yyyy}", new { id = "EndDate", @class = "form-control dateinput", placeholder = "dd/mm/yyyy" })
            @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
        </div>
    </div>



    <div class="form-group row">
        <div class="col-md-3">
            @Html.TitleFor(model => model.ContractValue, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.ContractValue, new
            {
                @class = "form-control text-right",

                placeholder = "0"
            })
            @Html.ValidationMessageFor(model => model.ContractValue, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.TitleFor(model => model.VAT, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.VAT, new
            {
                @class = "form-control",
                type = "number",
                min = "0",
                max = "100",
                step = "0.01",
                placeholder = "0 – 100",
                data_format = "percent"
            })
            @Html.ValidationMessageFor(model => model.VAT, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.TitleFor(model => model.TotalAmount, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.TotalAmount, new
            {
                @class = "form-control text-right",

                placeholder = "0"
            })
            @Html.ValidationMessageFor(model => model.TotalAmount, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-9">
            <label class="font-bold">
                @AppProcessor.Messagor.GetMessage("FileAttach_Label")
            </label>
            @Html.FileFor(model => model.DinhKemFile, ".*", true, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("FileUpload") })
            <div id="oldFileList" class="mt-2">
                @if (Model.ExistingFiles != null && Model.ExistingFiles.Any())
                {
                    foreach (var file in Model.ExistingFiles)
                    {
                        var fileName = Path.GetFileName(file.FilePath);

                        <div class="old-file d-flex justify-content-between align-items-center border rounded px-2 py-1 mb-1">
                            <a class="js-file-preview text-decoration-none text-dark"
                               href="@file.FilePath"
                               data-file-path="@file.FilePath"
                               data-file-name="@fileName"
                               data-preview-title="Tệp đính kèm"
                               onclick="return openBusinessOpportunityFilePreviewLink(this);">
                                <i class="fa fa-file text-success mr-1"></i>
                                @fileName
                            </a>

                            <button type="button" class="btn btn-sm btn-danger"
                                    onclick="removeOldFile(this, @file.FilePathID)">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                    }
                }
            </div>
            <div id="fileList" class="mt-2"></div>
            <div id="deletedFilesContainer"></div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card border-0">
                <div class="card-header bg-transparent py-1 border-0 pl-1">
                    <div class="card-title mb-2 mb-md-0 text-600 text-blue">
                        <i class="fas fa-cog mr-1  text-90"></i>
                        Cấu hình nhắc hợp đồng đến hạn xuất hóa đơn
                    </div>
                    <div class="card-toolbar align-self-center">
                        <a href="#" data-action="toggle" class="card-toolbar-btn text-grey text-110">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>

                <div class="card-body p-3 ccard collapse show" id="hide_remove_select2-selection__clear">
                    <div class="row">
                        <div class="col-md-6">
                            @Html.TitleFor(model => model.ReminderType, new { @class = " font-bold" })
                            @Html.DropDownListFor(model => model.ReminderType, new SelectList(new List<SelectListItem>
                                                                                                                                                                                                       {
                                         new SelectListItem { Text = "Không nhắc", Value = "NONE" },
                                         new SelectListItem { Text = "Nhắc vào ngày cụ thể", Value = "SPECIFIC_DATE" },
                                         new SelectListItem { Text = "Nhắc theo định kỳ xuất hóa đơn", Value = "RECURRING" },
                                                        }, "Value", "Text"), new { @class = "form-control", onchange = "fnChonKieuNhac()" })
                            @Html.ValidationMessageFor(model => model.ReminderType, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3" id="div_ReminderDayOfMonth">
                            @Html.TitleFor(model => model.ReminderDayOfMonth, new { @class = "font-bold" })
                            @Html.TextBoxFor(model => model.ReminderDayOfMonth, new { @type = "number", @min = "0", @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("ReminderDayOfMonth_Label") })
                            @Html.ValidationMessageFor(model => model.ReminderDayOfMonth, "", new { @class = "text-danger" })
                        </div>
                        @*<div class="col-md-3 d-flex align-items-end">
                                <button type="button" class="btn btn-lighter-primary" onclick="fnTaoLichNhac()">
                                    Xác nhận
                                </button>
                            </div>*@
                    </div>
                    <div class="row" id="rowLichNhac">
                        <div class="col-md-12">

                            <div class="form-group row mt-3">
                                <div class="col-md-12">
                                    <div style="border-top: 3px double #3C90D6;" class="pt-2 ">
                                    </div>
                                    <table id="tbl_DeXuats" class="table table-bordered">
                                        <thead class="bgc-blue-l4 text-600 text-blue-d1 text-uppercase text-center text-80">
                                            <tr>
                                                <th class="">Ngày</th>
                                                <th style="width:1% !important;">
                                                    <button type="button" class="btn btn-blue text-600 text-90 text-nowrap" onclick="addRow()"><i class="fa fa-plus"></i> Thêm</button>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody id="table-body">
                                            @for (int i = 0; i < slNgayNhac; i++)
                                            {
                                                <tr id="row-@i">
                                                    <td class="">
                                                        <input id="ReminderDate_@i" name="ReminderDate_@i" class="date_pk form-control" value="@Model.ListContractReminders[i].ReminderDate.GetValueOrDefault().ToString("dd/MM/yyyy")" />
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(@i)"><i class="fas fa-trash-alt"></i></button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>


    function set_datepicker(classPath) {
        $(classPath).datepicker({
            viewMode: "days",
            minViewMode: "days",
            format: "dd/MM/yyyy",
            autoclose: true,
            todayhighlight: true,
            todaybtn: true,
            minDate: null,
            maxDate: null,
            weekStart: 1,
            orientation: "top",
            language: "vi"
        })
    }


    // ✅ PATCH: Load FormUtils.js nếu chưa có
    (function () {
        if (typeof initFormUtils === 'undefined') {
            var s = document.createElement('script');
            s.src = '@Url.Content("~/Areas/Cate/Views/FormUtils.js")';
            s.onload = function () { initFormUtils('#CHKD'); };
            document.head.appendChild(s);
        } else {
            $(function () { initFormUtils('#CHKD'); });
        }
    })();
    $(document).ready(function () {
        $(".dateinput").datetimepicker({
            format: "DD/MM/YYYY",
            icons: {
                previous: "fa fa-chevron-left",
                next: "fa fa-chevron-right"
            },
            locale: "vi"
        });
        fnChonKieuNhac();
        set_datepicker('.date_pk');
        let rowCounter = @slNgayNhac;

         // Hàm để thêm một hàng mới
         window.addRow = function() {
             let tableBody = document.getElementById('table-body');
             let newRow = document.createElement('tr');
             newRow.id = 'row-' + rowCounter;

             // Tạo một hàng mới với DropDownList, TextBox và Nút Xóa
             newRow.innerHTML = `
                <td class="">
                    <input name="ReminderDate_${rowCounter}" id="ReminderDate_${rowCounter}" class="form-control date_pk"/>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(${rowCounter})"><i class="fas fa-trash-alt"></i></button>
                </td>`;

             tableBody.appendChild(newRow);
             rowCounter++;

             //console.log('addRow: ' + rowCounter);
             $('#SLDeXuat').val(rowCounter)

             set_datepicker('.date_pk');
         }

         // Hàm để xóa một hàng
        window.removeRow = function(rowId) {
            let row = document.getElementById('row-' + rowId);
            if (row) {
                row.remove();

                // Cập nhật các ID và tên của các hàng còn lại
                let tableBody = document.getElementById('table-body');
                let rows = tableBody.getElementsByTagName('tr');
                for (let i = 0; i < rows.length; i++) {
                    rows[i].id = 'row-' + i;
                    debugger
                    let cells = rows[i].getElementsByTagName('td');
                    if (cells.length > 0) {
                        let input = cells[0].getElementsByTagName('input')[0];
                        let button = cells[1].getElementsByTagName('button')[0];
                        input.name = `ReminderDate_${i}`;
                        button.setAttribute('onclick', `removeRow(${i})`);
                    }
                }

                // Cập nhật rowCounter
                rowCounter = rows.length;
            }
            //console.log('removeRow: ' + rowCounter);
            $('#SLDeXuat').val(rowCounter)
        }
    });
</script>
<script>
    var filesList = [];
    var dataTransfer = new DataTransfer();
    var kieuNhac;

    // CHỌN FILE MỚI
    $(document).on("change", "#DinhKemFile", function (e) {
        let newFiles = Array.from(e.target.files);

        newFiles.forEach(file => {
            // check trùng (name + size cho chắc)
            if (!filesList.some(f => f.name === file.name && f.size === file.size)) {
                filesList.push(file);
            }
        });

        syncInputFiles();
        renderFileList();
    });

    // SYNC FILE VÀO INPUT
    function syncInputFiles() {
        dataTransfer = new DataTransfer();

        filesList.forEach(file => {
            dataTransfer.items.add(file);
        });

        document.getElementById("DinhKemFile").files = dataTransfer.files;
    }

    // RENDER FILE MỚI
    function renderFileList() {
        let html = "";

        filesList.forEach((file, index) => {
            html += `
                        <div class="d-flex justify-content-between align-items-center border rounded px-2 py-1 mb-1 new-file">
                            <span>
                                <i class="fa fa-file text-primary mr-1"></i>
                                ${file.name}
                            </span>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeFile(${index})">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                        `;
        });

        $("#fileList").html(html);
    }

    // XÓA FILE MỚI
    function removeFile(index) {
        filesList.splice(index, 1);
        syncInputFiles();
        renderFileList();
    }

    // XÓA FILE CŨ (EDIT)
    function removeOldFile(btn, fileId) {
        $(btn).closest(".old-file").remove();
        $("#deletedFilesContainer").append(
            `<input type="hidden" name="DeletedFileIds" value="${fileId}" />`
        );
    }

    function fnChonKieuNhac() {
        kieuNhac = $('#ReminderType').val();
        if (kieuNhac == 'NONE') {
            $('#div_ReminderDayOfMonth').addClass('d-none');
            $('#rowLichNhac').addClass('d-none');
        } else if (kieuNhac == 'SPECIFIC_DATE') {
            $('#div_ReminderDayOfMonth').addClass('d-none');
            $('#rowLichNhac').removeClass('d-none');
            rowLichNhac
        } else if (kieuNhac == 'RECURRING') {
            $('#div_ReminderDayOfMonth').removeClass('d-none');
            $('#rowLichNhac').addClass('d-none');
        }
    }

</script>
@Html.RenderScripts(ScriptPosition.BodyInside)