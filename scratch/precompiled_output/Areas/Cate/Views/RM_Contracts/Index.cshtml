@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ContractsSearchModel
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Contracts_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
}

<div class="mt-3">
    @Html.Partial("_Search", Model)
</div>

<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSContracts" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ContractCode_Label_Name")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ContractName_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_CustomerName_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ProductService_Title")</th>
                        <th>@AppProcessor.Messagor.GetMessage("SignDate_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ContractValue_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("TotalAmount_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Status_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Contract_UserCreated_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Cate/Views/RM_Contracts/RM_Contracts.js"></script>
    <script>
        const vnFormatter = new Intl.NumberFormat("vi-VN", {
            style: "decimal",
            currency: "VND",
        });
    </script>
}
