@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_CostTypeModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("CostType_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "CostType", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "CostType_OnProcessSuccess(data, 'DeleteCostType')"
    }, new { @class = "form-horizontal", id = "DeleteCostType" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CostTypeID)
        @Html.HiddenFor(model => model.CostTypeName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}