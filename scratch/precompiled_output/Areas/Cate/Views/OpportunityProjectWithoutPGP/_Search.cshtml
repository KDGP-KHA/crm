@using TSFramework.Libs.Processors
@model Core.Cate.Models.OpportunityProjectWithoutPGSearchPModel

<div class="Search card dcard" id="SearchOpportunityProjectWithoutPGP">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>

    <div class="card-body p-2 d-flex align-items-end">
        <div class="Search_Box year-box ">
            <label class="font-bold">@AppProcessor.Messagor.GetMessage("ProjectRevenueReport_Year") <span class="text-danger">*</span></label>
            @Html.TextBoxFor(
                model => model.Year,
                new
                {
                    @class = "form-control",
                    id = "Year",
                    type = "number",
                    min = "2000",
                    max = "2100",
                    autocomplete = "off"
                })
        </div>

        <div class="Group Group_button">
            <div class="Search_button">
                <button type="button" class="btn btn-primary" style="width: max-content" onclick="_tableOpportunityProjectWithoutPGP.ajax.reload(null, false);">
                    <i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>

            @*<div class="Search_button">
                <button type="button" id="btnExportCustomer" class="btn btn-warning border-0 ml-2" style="width: max-content">
                    <i class="fa fa-download"></i>
                    <span>@AppProcessor.Messagor.GetMessage("Button_Export")</span>
                </button>
            </div>*@
        </div>

    </div>
</div>

<script>
    $(document).ready(function () {
        $('#SearchCustomer').on('keydown', 'input, select', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                _tableOpportunityProjectWithoutPGP.ajax.reload(null, false);
            }
        });
        $('#SearchCustomer').on('change', 'select', function () {
            _tableOpportunityProjectWithoutPGP.ajax.reload(null, false);
        });
    });
</script>