@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ProductCostModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ProductCost_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "ProductCost", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ProductCost_OnProcessSuccess(data, 'DeleteProductCost')"
    }, new { @class = "form-horizontal", id = "DeleteProductCost" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ProductCostID)
        @Html.HiddenFor(model => model.NameProduct)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}