@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("ProductCost_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Add", "ProductCost", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ProductCost_OnProcessSuccess(data, 'AddProductCost')"
    }, new { @class = "form-horizontal", id = "AddProductCost" }))
    {
        <div id="bodyForm">
            @Html.Partial("_ProductCost")
        </div>
    }
}

@section ContinueForm{

}