@using TSFramework.Libs.Processors
@model Core.Cate.Models.ProductProjectOverviewModel

@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("ProjectOverview_Title");
}

@section PageTitle {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent px-0 py-2 mb-2">
            <li class="breadcrumb-item">
                <a href="/Dashboard/Dashboard" class="no-underline text-primary-d2"><i class="fa fa-home fa-1x"></i> <span>Trang chủ</span></a>
            </li>
            <li class="breadcrumb-item">
                <a class="no-underline text-primary-d2" href="/Dashboard/Manager?menu=45">@AppProcessor.Messagor.GetMessage("BO_Overview_Breadcrumb_DanhMuc")</a>
            </li>
            <li class="breadcrumb-item">
                <a class="no-underline text-primary-d2" href="/Cate/Project">@AppProcessor.Messagor.GetMessage("Project_Title")</a>
            </li>
            <li class="breadcrumb-item" aria-current="page">
                <a class="no-underline text-primary-d2" href="/Cate/ProjectOverview/Index/@Model.ProductProjectModel.ProjectID">@Model.ProductProjectModel.ProjectName</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                @Model.ProductProjectModel.NameProduct
            </li>
        </ol>
    </nav>
}

<div class="dcard">
    <ul class="nav nav-tabs bgc-secondary-l3 border-y-1 brc-secondary-l3" role="tablist">
        <li class="nav-item mr-2px">
            <a id="project-tab-btn" class="d-style active btn btn-tp btn-light-secondary btn-h-white btn-a-text-dark btn-a-white text-95 px-3 px-sm-4 py-25 radius-0 border-0"
               data-toggle="tab" href="#project" role="tab" aria-controls="project" aria-selected="true">
                <span class="v-active position-tl w-100 border-t-3 brc-blue mt-n2px"></span>
                <i class="fa fa-home text-success mr-3px"></i> Tổng quát
            </a>
        </li>
        <li class="nav-item mr-2px">
            <a id="employee-tab-btn" class="d-style btn btn-tp btn-light-secondary btn-h-white btn-a-text-dark btn-a-white text-95 px-3 px-sm-4 py-25 radius-0 border-0"
               data-toggle="tab" href="#member" role="tab" aria-controls="member" aria-selected="false">
                <span class="v-active position-tl w-100 border-t-3 brc-blue mt-n2px"></span>
                <i class="fa fa-user text-info mr-3px"></i> Thành viên
                <span class="badge badge-info ml-1">@Model.TotalMember</span>
            </a>
        </li>
        <li class="nav-item mr-2px">
            <a id="product-tab-btn" class="d-style btn btn-tp btn-light-secondary btn-h-white btn-a-text-dark btn-a-white text-95 px-3 px-sm-4 py-25 radius-0 border-0"
               data-toggle="tab" href="#product" role="tab" aria-controls="product" aria-selected="false">
                <span class="v-active position-tl w-100 border-t-3 brc-blue mt-n2px"></span>
                <i class="fa fa-dollar-sign text-warning  mr-3px"></i> Chi phí
                <span class="badge badge-warning  ml-1">@Model.CountCost</span>
            </a>
        </li>
        <li class="nav-item mr-2px">
            <a id="revenue-tab-btn" class="d-style btn btn-tp btn-light-secondary btn-h-white btn-a-text-dark btn-a-white text-95 px-3 px-sm-4 py-25 radius-0 border-0"
               data-toggle="tab" href="#revenue" role="tab" aria-controls="revenue" aria-selected="false">
                <span class="v-active position-tl w-100 border-t-3 brc-blue mt-n2px"></span>
                <i class="fa fa-chart-line text-primary mr-3px"></i> Doanh thu
                <span class="badge badge-primary ml-1">@Model.CountRevenue</span>
            </a>
        </li>
        @*<li class="nav-item mr-2px">
            <a id="projecttask-tab-btn" class="d-style btn btn-tp btn-light-secondary btn-h-white btn-a-text-dark btn-a-white text-95 px-3 px-sm-4 py-25 radius-0 border-0"
               data-toggle="tab" href="#projecttask" role="tab" aria-controls="projecttask" aria-selected="false">
                <span class="v-active position-tl w-100 border-t-3 brc-blue mt-n2px"></span>
                <i class="fa fa-tasks text-success mr-3px"></i> Công việc
                <span class="badge badge-success ml-1">@Model.TotalTask</span>
            </a>
        </li>*@
        <li class="nav-item mr-2px">
            <a id="product-tab-btn" class="d-style btn btn-tp btn-light-success btn-h-white btn-a-text-dark btn-a-white text-95 px-3 px-sm-4 py-25 radius-0 border-0" data-toggle="tab" href="#contracts" role="tab" aria-controls="contracts" aria-selected="false">
                <span class="v-active position-tl w-100 border-t-3 brc-success mt-n2px"></span>
                <i class="fa fa-file-contract text-success mr-2"></i> Hợp đồng
                <span class="badge badge-success ml-1">@Model.TotalContract</span>
            </a>
        </li>
    </ul>

    <div class="tab-content bgc-white p-35 border-0">
        <div class="tab-pane fade show active text-95" id="project" role="tabpanel" aria-labelledby="project-tab-btn">
            <div id="productProjectContainer">
                @Html.Partial("_ProductProjectOverview", Model)
            </div>
        </div>
        <div class="tab-pane fade text-95" id="member" role="tabpanel" aria-labelledby="member-tab-btn">
            <div id="projectMemberContainer">
                @Html.Partial("_Member", Model.ProjectMembers, new ViewDataDictionary { { "ProductProjectID", Model.ProductProjectModel.ProductProjectID } })
            </div>
        </div>
        <div class="tab-pane fade text-95" id="product" role="tabpanel" aria-labelledby="product-tab-btn">
            <div id="productCostContainer">
                @Html.Partial("_ProductCost", Model.ProductCosts, new ViewDataDictionary { { "ProductProjectID", Model.ProductProjectModel.ProductProjectID } })
            </div>
        </div>
        <div class="tab-pane fade text-95" id="revenue" role="tabpanel" aria-labelledby="revenue-tab-btn">
            <div id="revenueReceivedContainer">
                @Html.Partial("_RevenueReceived", Model.RevenueReceiveds, new ViewDataDictionary { { "ProductProjectID", Model.ProductProjectModel.ProductProjectID } })
            </div>
        </div>
        @*<div class="tab-pane fade text-95" id="projecttask" role="tabpanel" aria-labelledby="projecttask-tab-btn">
            <div id="projectTaskContainer">
                @Html.Partial("_ProjectTask", Model.ProjectTasks,
                    new ViewDataDictionary {
                    { "ProductProjectID", Model.ProductProjectModel.ProductProjectID },
                })
            </div>
        </div>*@
        <div class="tab-pane fade show text-95" id="contracts" role="tabpanel" aria-labelledby="contracts-tab-btn">
            <div id="contractsContainer">
                @Html.Partial("_Contracts", Model.Contracts, new ViewDataDictionary { { "ProductProjectID", Model.ProductProjectModel.ProductProjectID } })
            </div>
        </div>
    </div>
</div>

@section BottomScript {
    <script src="@Url.Content("~/Areas/Cate/Views/ProductProjectOverview/ProductProjectOverview.js")"></script>
    <script>
        var _urlReloadProductCost     = '@Url.Action("ListProductCostByProductProject",     "ProductProjectOverview", new { area = "Cate" })';
        var _urlReloadRevenueReceived = '@Url.Action("ListRevenueReceivedByProductProject", "ProductProjectOverview", new { area = "Cate" })';
        var _urlReloadProjectMember   = '@Url.Action("ListProjectMemberByProductProject",   "ProductProjectOverview", new { area = "Cate" })';
        var _urlReloadProjectTask     = '@Url.Action("ListProjectTaskByProductProject",     "ProductProjectOverview", new { area = "Cate" })';
        var _urlReloadContracts       = '@Url.Action("ListContractsByProductProject",       "ProductProjectOverview", new { area = "Cate" })';
        var _urlReloadProductProject  = '@Url.Action("GetProductProjectInfo",     "ProductProjectOverview", new { area = "Cate" })';
        var _productProjectId         = @Model.ProductProjectModel.ProductProjectID;
    </script>

    <script>
        $(document).ready(function () {

            if (localStorage.getItem("openProjectTaskTab") === "1") {

                $('#projecttask-tab-btn').tab('show');

                localStorage.removeItem("openProjectTaskTab"); // reset
            }

        });

            const vnFormatter = new Intl.NumberFormat("vi-VN", {
                style: "decimal",
            currency: "VND",
        });
    </script>
}