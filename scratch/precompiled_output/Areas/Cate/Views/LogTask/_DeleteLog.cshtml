@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_LogTaskModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ContactPersonal_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "LogTask", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "LogTask_OnProcessSuccess(data, 'DeleteLogTask')"
    }, new { @class = "form-horizontal", id = "DeleteLogTask" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.LogTaskID)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}