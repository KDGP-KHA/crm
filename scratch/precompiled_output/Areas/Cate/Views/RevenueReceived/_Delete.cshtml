@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_RevenueReceivedModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("RevenueReceived_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "RevenueReceived", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "RevenueReceived_OnProcessSuccess(data, 'DeleteRevenueReceived')"
    }, new { @class = "form-horizontal", id = "DeleteRevenueReceived" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.RevenueReceivedID)
        @Html.HiddenFor(model => model.NameProduct)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}