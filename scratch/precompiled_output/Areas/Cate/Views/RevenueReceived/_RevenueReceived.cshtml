@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_RevenueReceivedModel

@Html.AntiForgeryToken()
<div id="Language">
    @Html.HiddenFor(model => model.RevenueReceivedID)
    @Html.HiddenFor(model => model.ProductProjectID)
    @Html.HiddenFor(model => model.NameProduct)

    <div class="col-12">
        <div class="row">
            <div class="col-4">
                @Html.TitleFor(model => model.ReceivedDate, new { @class = "col-form-label text-sm-right pr-0 font-bold" })
                <div class="input-group">
                    @Html.TextBoxFor(model => model.ReceivedDate, "{0:dd/MM/yyyy}", new { id = "ReceivedDate", @class = "form-control dateinput", placeholder = "dd/mm/yyyy" })
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                    </div>
                </div>
                @Html.ValidationMessageFor(model => model.ReceivedDate, "", new { @class = "text-danger" })
            </div>
            <div class="col-4">
                @Html.TitleFor(model => model.ReceivedTime, new { @class = "col-form-label text-sm-right pr-0 font-bold" })
                <div class="input-group">
                    @Html.TextBoxFor(model => model.ReceivedTime, "{0:dd/MM/yyyy}", new { id = "ReceivedTime", @class = "form-control dateinput", placeholder = "dd/mm/yyyy" })
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                    </div>
                </div>
                @Html.ValidationMessageFor(model => model.ReceivedTime, "", new { @class = "text-danger" })
            </div>
            <div class="col-4">
                @Html.TitleFor(model => model.Amount, new { @class = "col-form-label text-sm-right pr-0 font-bold" })
                @Html.TextBoxFor(model => model.Amount, "{0:0.##}", new { @class = "form-control text-right", data_format = "money", placeholder = "0" })
                @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="col-12">
        @Html.TitleFor(model => model.Note, new { @class = "col-form-label text-sm-right pr-0 font-bold" })
        @Html.TextAreaFor(model => model.Note, new { rows = "3", @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("RevenueReceived_Note_Label") })
        @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
    </div>
</div>

<script>
    (function () {
        if (typeof initFormUtils === 'undefined') {
            var s = document.createElement('script');
            s.src = '@Url.Content("~/Areas/Cate/Views/FormUtils.js")';
            s.onload = function () { initFormUtils('#Language'); };
            document.head.appendChild(s);
        } else {
            $(function () { initFormUtils('#Language'); });
        }
    })();

    $(document).ready(function () {
        $(".dateinput").datetimepicker({
            format: "DD/MM/YYYY",
            icons: {
                previous: "fa fa-chevron-left",
                next: "fa fa-chevron-right"
            },
            locale: "vi"
        });
    });
</script>
