@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ProductProjectModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ProductProject_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "ProductProject", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ProductProject_OnProcessSuccess(data, 'DeleteProductProject')"
    }, new { @class = "form-horizontal", id = "DeleteProductProject" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ProductProjectID)
        @Html.HiddenFor(model => model.NameProduct)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}