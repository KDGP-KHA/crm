@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("ProductProject_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddProductProject", Url.Action("Add", new { area = "Cate" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right" })
}

<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSProductProject" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Project_ProjectName_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("RMPS_Label_NameProduct")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ProductProject_ExpectedRevenue_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ProductProject_StartDate_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ProductProject_End_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Cate/Views/ProductProject/ProductProject.js")"></script>
}