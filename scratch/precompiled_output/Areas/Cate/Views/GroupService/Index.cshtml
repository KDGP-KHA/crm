@using TSFramework.Libs.Processors

@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("GroupService_Title");
}

@section PageTitle { @ViewBag.Title }

@section PageAction {
    @Html.Button(true,
        "AddGroupService",
        Url.Action("Add", new { area = "Cate" }),
        "<i class='fa fa-plus'></i>",
        AppProcessor.Messagor.GetMessage("Button_Add"),
        new
            {
            @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right",
            data_width = "800px"
            }
        )
}

@Html.Partial("_Search")

<div class="mt-1">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="tblGroupService"
                   class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table"
                   width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="text-left">@AppProcessor.Messagor.GetMessage("GroupService_Name_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("GroupService_Status_Label")</th>
                        <th style="width:120px">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>

                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section BottomScript {
    <script src="@Url.Content("~/Areas/Cate/Views/GroupService/GroupService.js")"></script>
}
