@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_GroupServiceModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("GroupService_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "GroupService", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "GroupService_OnProcessSuccess(data, 'DeleteGroupService')"
    }, new { @class = "form-horizontal", id = "DeleteGroupService" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.GroupServiceID)
        @Html.HiddenFor(model => model.NameGroup)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}