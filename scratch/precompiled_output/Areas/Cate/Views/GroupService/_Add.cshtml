@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("GroupService_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Add", "GroupService", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "GroupService_OnProcessSuccess(data, 'AddGroupService')"
    }, new { @class = "form-horizontal", id = "AddGroupService" }))
    {
        <div id="bodyForm">
            @Html.Partial("_GroupService")
        </div>
    }
}

