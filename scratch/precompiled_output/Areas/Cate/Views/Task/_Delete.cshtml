@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_TaskModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Task_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}
@section FormType { danger }
@section FormBody {
    @using (Ajax.BeginForm("Delete", "Task", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Task_OnProcessSuccess(data, 'DeleteTask')"
    }, new { @class = "form-horizontal", id = "DeleteTask" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.TaskID)
        @Html.HiddenFor(m => m.TaskName)
        <h5>@Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}
