@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysInstructModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Instruct_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Instruct", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Instruct_OnProcessSuccess(data, 'DeleteInstruct')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.InstructID)
        @Html.HiddenFor(model => model.InstructName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}