@using TSFramework.Libs.Processors
@using Core.Cate.Models
@model RM_StatusSearchModel

<div class="Search card dcard" id="SearchStatus">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>

    <div class="card-body p-2 d-flex align-items-end">
        <!-- Keyword -->
        <div class="Search_Box w-50 keyWord">
            <label class="font-bold text-sm-right">@AppProcessor.Messagor.GetMessage("Label_TuKhoa")</label>
            @Html.TextBoxFor(model => model.Keyword, new
            {
                @class = "form-control",
                placeholder = @AppProcessor.Messagor.GetMessage("Status_Keyword")
            })
        </div>

        <div class="Search_Box">
            <label class="font-bold">
                @AppProcessor.Messagor.GetMessage("Status_Label_Key")
            </label>
            <div class="">
                @Html.DropDownListFor(
                    x => x.SearchKey,
                    Model.ListStatusKey,
                    "-- Chọn loại trạng thái --",
                    new { @class = "form-control" }
                )
            </div>
        </div>

        <div class="Group Group_button">
            <div class="Search_button">
                <button type="button" class="btn btn-primary" style="width: max-content"  onclick="_tableStatus.ajax.reload(null, false);">
                    <i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>
        </div>
    </div>
</div>