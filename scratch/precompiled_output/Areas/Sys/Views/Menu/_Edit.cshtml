@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("Menu_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("Edit", "Menu", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Menu_OnProcessSuccess(data, 'EditMenu')"
    }, new { @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_MenuView")
        </div>
    }
}