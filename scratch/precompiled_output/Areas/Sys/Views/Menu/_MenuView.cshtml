    function _onUseModal(chbk) {
        if ($(chbk).is(":checked")) {
            $("#formModalId").removeClass("d-none");
        }
        else {
            $("#formModalId").addClass("d-none");
        }
    }

    $(function () {
        $('button[role="iconpicker"]').iconpicker()
            .iconpicker('setAlign', 'center') // Only in div tag
            .iconpicker('setArrowClass', 'btn-success')
            .iconpicker('setSearchText', 'Tìm kiếm')
            .iconpicker('setSelectedClass', 'btn-danger')
            .iconpicker('setUnselectedClass', 'btn-primary');
        //.on('change', function (e) {
