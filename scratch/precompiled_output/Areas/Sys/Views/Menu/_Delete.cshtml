@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysMenuModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Menu_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Menu", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Menu_OnProcessSuccess(data, 'DeleteMenu')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.MenuId)
        @Html.HiddenFor(model => model.Name)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}