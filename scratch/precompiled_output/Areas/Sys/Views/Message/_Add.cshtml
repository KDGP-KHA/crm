@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("Message_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("Add", "Message", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Message_OnProcessSuccess(data, 'AddMessage')"
    }, new { @class = "form-horizontal", id = "AddMessage" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Message")
        </div>
    }
}

@section ContinueForm{

}