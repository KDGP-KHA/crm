@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysMessageModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Message_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Message", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Message_OnProcessSuccess(data, 'DeleteMessage')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.LangCode)
        @Html.HiddenFor(model => model.LabelKey)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}