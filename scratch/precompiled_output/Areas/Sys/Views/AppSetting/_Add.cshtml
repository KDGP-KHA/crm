@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("AppSetting_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Add", "AppSetting", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "AppSetting_OnProcessSuccess(data, 'AddAppSetting')"
    }, new { @class = "form-horizontal", id = "AddAppSetting" }))
    {
        <div id="bodyForm">
            @Html.Partial("_AppSetting")
        </div>
    }
}

@section ContinueForm{

}