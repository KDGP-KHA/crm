@using TSFramework.Libs.Extensions
@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysConfigModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@{
    var id = string.Empty;
    var isReadonly = string.Empty;
    if (Model != null)
    {
        if (!string.IsNullOrEmpty(Model.ConfigKey) && !string.IsNullOrEmpty(Model.ConfigKey))
        {
            isReadonly = "readonly";
            id = Model.ConfigValue + Model.ConfigKey;
        }
    }
}

@Html.Hidden("ID", id)
@Html.HiddenFor(m=>m.IsFile)
<div id="SysConfig">
    <div class="form-group row">
        @Html.TitleFor(model => model.ConfigKey, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        @Html.HiddenFor(model => model.ConfigId)
        <div class="col-md-9">
            @Html.TextBoxFor(model => model.ConfigKey, new { @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("SysConfig_ConfigKey") })
            @Html.ValidationMessageFor(model => model.ConfigKey, "", new { @class = "text-danger" })
        </div>

    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.ConfigValue, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            @Html.TextAreaFor(model => model.ConfigValue, new { rows = 5, @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("SysConfig_ConfigValue") })
            @Html.ValidationMessageFor(model => model.ConfigValue, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.ConfigDesc, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            @Html.TextAreaFor(model => model.ConfigDesc, new { rows = 3, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("SysConfig_ConfigDesc") })
            @Html.ValidationMessageFor(model => model.ConfigDesc, "", new { @class = "text-danger" })
        </div>
    </div>
</div>

@Html.RenderScripts(ScriptPosition.BodyInside)

<script type="text/javascript">
    $(function () {
        var readonly = "@isReadonly";

        if (readonly.length > 0) {
            $("input[type='text'][id$='AppKey']").attr(readonly, "readonly");
        }
    });

    function _onChangeTypeValue(chk) {
        if ($(chk).is(":checked")) {
            $("#SysConfig #ForFile").removeClass("d-none");
            $("#SysConfig #ForRawValue").addClass("d-none");
        } else {
            $("#SysConfig #ForFile").addClass("d-none");
            $("#SysConfig #ForRawValue").removeClass("d-none");
        }
    }
</script>