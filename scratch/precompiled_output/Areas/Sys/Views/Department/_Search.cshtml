@using TSFramework.Libs.Processors
@model Core.Cate.Models.MN_BoPhanSearchModel

<div class="Search card dcard" id="SearchDeparment">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>

    <div class="card-body p-2 d-flex align-items-end">
        <div class="Search_Box w-50 keyWord">
            <label class="font-bold text-sm-right">@AppProcessor.Messagor.GetMessage("Label_TuKhoa")</label>
            @Html.TextBoxFor(model => model.Keyword, new { @class = "form-control", placeholder = @AppProcessor.Messagor.GetMessage("Deparment_Keyword") })
        </div>

        <div class="Group Group_button">
            <div class="Search_button">
                <button type="button" class="btn btn-primary" onclick="searchDepartment();"><i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")</button>
            </div>

            <button type="button" id="btnExportDeparment" class="btn btn-warning border-0 ml-2">
                <i class="fa fa-download"></i>
                <span>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Export_Deparment")</span>
            </button>
        </div>
    </div>
</div>