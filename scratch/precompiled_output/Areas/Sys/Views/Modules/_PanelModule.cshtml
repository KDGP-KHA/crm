@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysPanelModuleModel

@Html.HiddenFor(model => model.PanelName)

<div id="PanelModule">
    <div class="form-group">
        @Html.TitleFor(model => model.ModuleId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            @Html.DropDownListFor(model => model.ModuleId, new SelectList(Model.ActiveModules, "Value", "Text"), new { @class = "col-md-7", placeholder = AppProcessor.Messagor.GetMessage("PanelModule_Label_Module") })
            @Html.ValidationMessageFor(model => model.ModuleId, "", new { @class = "text-danger" })
        </div>
    </div>
</div>