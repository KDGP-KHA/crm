@using TSFramework.Libs.Extensions
@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("AppLayout_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddAppLayout", Url.Action("Add", new { area = "Sys" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right" })
}

<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSAppLayout" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                <tr>
                    <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                    <th>@AppProcessor.Messagor.GetMessage("AppLayout_Label_LayoutName")</th>
                    <th>@AppProcessor.Messagor.GetMessage("AppLayout_Label_LayoutView")</th>
                    <th>@AppProcessor.Messagor.GetMessage("AppLayout_Label_NumberContentPanel")</th>
                    <th>@AppProcessor.Messagor.GetMessage("AppLayout_Label_NumberCol")</th>
                    <th>@AppProcessor.Messagor.GetMessage("AppLayout_Label_Active")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Sys/Views/AppLayout/AppLayout.js")"></script>
}