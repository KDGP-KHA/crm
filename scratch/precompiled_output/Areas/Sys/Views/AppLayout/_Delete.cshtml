@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysLayoutModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("AppLayout_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "AppLayout", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "AppLayout_OnProcessSuccess(data, 'DeleteAppLayout')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.LayoutId)
        @Html.HiddenFor(model => model.LayoutName)
        @Html.HiddenFor(model => model.LayoutView)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}