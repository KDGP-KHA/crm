@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("AccessHistory_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

<div class="mt-3">
    @Html.Partial("_Search")
</div>
<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSAccessHistory" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="nls-w">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("AreaName")</th>
                        <th>@AppProcessor.Messagor.GetMessage("FunctionName")</th>
                        <th>@AppProcessor.Messagor.GetMessage("FunctionDescription")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ActionName")</th>
                        <th>@AppProcessor.Messagor.GetMessage("CreateDate")</th>
                        <th>@AppProcessor.Messagor.GetMessage("UserName")</th>

                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Sys/Views/AccessHistory/AccessHistory.js"></script>
}