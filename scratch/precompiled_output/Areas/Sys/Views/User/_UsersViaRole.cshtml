@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysRoleModel

@{
    ViewBag.Title = Html.Raw(string.Format(AppProcessor.Messagor.GetMessage("Users_Belong_Role"), $"<b>[{Model.Name}]</b>"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-user-shield"></i>
}

@section FormBody{
    <div class="modal-body row" id="bodyForm">
        <div class="col-md-12">
            @Html.Button(true, "AddUser", Url.Action("AddUser", "User", new { area = "Sys", roleId = Model.RoleId }), "<i class='fas fa-plus'></i>", $"{AppProcessor.Messagor.GetMessage("Button_Add")} {AppProcessor.Messagor.GetMessage("User_Title")}", new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right" })
        </div>
        <div class="col-sm-12">
            <div class="mt-3">
                <div class="card dcard">
                    <div class="col-sm-12 table-responsive-md">
                        <table id="UsersViaRoles" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                            <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                            <tr>
                                <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                                <th>@AppProcessor.Messagor.GetMessage("User_Label_FullName")</th>
                                <th>@AppProcessor.Messagor.GetMessage("User_Label_UserName")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">

        var _UserActionURLs = {
            UsersViaRoles: "/Sys/User/GetUsersViaRole"
        };

        var _tableUserViaRole;

        $(document).ready(function() {
            initTableUsersViaRole();
        });

        function initTableUsersViaRole() {
            if (window._tableUserViaRole != undefined) {
                $("#UsersViaRoles").dataTable().fnDestroy();
            }
            _tableUserViaRole = $("#UsersViaRoles").DataTable({
                "Responsive": true,
                "language": {
                    "processing":
                        "<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
                },
                "lengthChange": true,
                "processing": true,
                "serverSide": true,
                "ajax":
                {
                    "url": _UserActionURLs.UsersViaRoles,
                    "type": "POST",
                    "dataType": "JSON",
                    "data": {
                        "roleId": "@Html.Raw(Model.RoleId)"
                    }
                },
                "columns": [
                    {
                        "data": "",
                        "defaultContent": "1",
                        "render": function(data, type, row, meta) {
                            return meta.settings._iDisplayStart + meta.row + 1;
                        }
                    },
                    {
                        "data": "FullName",
                        "defaultContent": "",
                        "render": function(data, type, row, meta) {
                            var html = "";
                            if (type === "display") {
                                html =
                                    ' <span class="text-105 text-primary-d1">{0}</span><div class="text-95 text-danger-d3"><i class="fas fa-at"></i>&nbsp;{1}</div>'.format(data, row["Email"]);
                                return html;
                            }
                            return data;
                        }
                    },
                    {
                        "data": "UserName",
                        "defaultContent": ""
                    },
                    {
                        "data": "UserId",
                        "style": "width:100px;",
                        "orderable": false,
                        "render": function(data, type) {
                            var html = '<span class="">';

                            if (type === "display") {

                                html += _renderButton(true,
                                    "RemoveUser",
                                    "btn btn-lighter-danger mr-1",
                                    "/Sys/User/RemoveUser?roleId=" + @Model.RoleId + "&userId=" + data,
                                    '<i class="far fa-trash-alt text-danger text-120"></i>',
                                    "Xoá");
                            }
                            html += '</span>';

                            return html;
                        }
                    }
                ]
            });
        }

        function UsersViaRole_OnProcessSuccess(response, formId) {
            if (response.status != undefined) {
                $("#ModalContent #modal_" + formId).modal("hide");
                $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                    function() {
                        if (response.status != undefined) {
                            eval(response.message);
                            _tableUserViaRole.ajax.reload(null, false);
                            response.status = undefined;
                        }
                    });
            } else {
                $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
            }
        }

    </script>
}

@section SubmitControl{

}