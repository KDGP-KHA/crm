@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("User_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("AddUser", "User", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "UsersViaRole_OnProcessSuccess(data, 'AddUser')"
    }, new { @class = "form-horizontal", role = "form" }))
    {
        <div id="bodyForm">
            @Html.Partial("_UserRole")
        </div>
    }
}