@using TSFramework.Libs.Extensions
@using TSFramework.Libs.Processors
@model Modules.Sys.Areas.Sys.Data.ChangePasswordModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@*@Html.HiddenFor(model => model.FullName)*@
@*@Html.HiddenFor(model => model.Email)*@
@*@Html.HiddenFor(model => model.UserName)*@
<div id="User">
    <div class="form-group row">
        @Html.TitleFor(model => model.FullName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="far fa-user-circle"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control col-md-7", placeholder = AppProcessor.Messagor.GetMessage("User_Current_FullName"), @readonly = true })
            </div>
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.UserName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="far fa-user"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.UserName, new { @class = "form-control col-md-7", placeholder = AppProcessor.Messagor.GetMessage("User_Current_UserName"), @readonly = true })
            </div>
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.Email, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-envelope"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.Email, new { @class = "form-control col-md-7", placeholder = AppProcessor.Messagor.GetMessage("User_Current_Email"), @readonly = true })
            </div>
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.NewPassword, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-6">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                <div class="d-inline-flex align-items-center col-md-8 p-0">
                    @Html.TextBoxFor(model => model.NewPassword, new { @autocomplete = "off", @class = "form-control" })
                    <a href="javascript:void(0);" onclick="togglePasswordVisibility('NewPassword', this);" class="btn btn-sm border-0 btn-white btn-h-light-orange btn-a-light-orange ml-n5 no-underline radius-1 d-style">
                        <i class="fa fa-eye-slash d-n-active w-3"></i>
                        <i class="fa fa-eye d-active w-3"></i>
                    </a>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.ConfirmPassword, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-6">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                <div class="d-inline-flex align-items-center col-md-8 p-0">
                    @Html.TextBoxFor(model => model.ConfirmPassword, new { @autocomplete = "off", @class = "form-control" })
                    <a href="javascript:void(0);" onclick="togglePasswordVisibility('ConfirmPassword', this);" class="btn btn-sm border-0 btn-white btn-h-light-orange btn-a-light-orange ml-n5 no-underline radius-1 d-style">
                        <i class="fa fa-eye-slash d-n-active w-3"></i>
                        <i class="fa fa-eye d-active w-3"></i>
                    </a>
                </div>
            </div>

            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.Reason, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            @Html.TextAreaFor(model => model.Reason, new { rows = "3", @class = "form-control col-md-9", placeholder = AppProcessor.Messagor.GetMessage("Reason_Label") })
            @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
        </div>
    </div>
</div>


<script>
    function togglePasswordVisibility(inputId, element) {
        var passwordInput = $('#' + inputId);
        var icon = $(element).find('i');
        if (passwordInput.hasClass('key')) {
            //passwordInput.attr('type', 'text');
            passwordInput.removeClass('key');
            icon.removeClass('fa-eye-slash');
            icon.addClass('fa-eye');
        } else {
            passwordInput.addClass('key');
            //passwordInput.attr('type', 'password');
            icon.removeClass('fa-eye');
            icon.addClass('fa-eye-slash');
        }
    }
</script>