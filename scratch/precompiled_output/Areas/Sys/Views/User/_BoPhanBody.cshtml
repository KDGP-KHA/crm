@using TSFramework.Libs.Extensions
@using TSFramework.Libs.Processors
@model Modules.Sys.Areas.Sys.Data.UserBoPhanModel
@Html.AntiForgeryToken()
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(m => m.UserId)
@Html.HiddenFor(m => m.UserName)
@Html.HiddenFor(m => m.FullName)
@Html.HiddenFor(m => m.Email)
@Html.HiddenFor(m => m.MaBophans)

<style>
    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--multiple {
        border: 1px solid #ced4da;
        border-radius: 4px;
        min-height: 38px;
        padding: 2px 4px;
    }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            max-width: 98%;
            white-space: normal;
            word-break: break-word;
            height: auto;
            padding: 2px 8px 2px 6px;
            line-height: 1.5;
            margin: 2px;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__rendered {
            white-space: normal;
            padding: 2px 4px;
        }
        .select2-container--default .select2-selection--multiple .select2-selection__clear,
        .select2-container--default .select2-selection--multiple .select2-clear-button,
        .select2-selection__clear {
            display: none !important;
        }
</style>

<div id="BoPhan">
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("User_Label_HoTen")</label>
        <div class="col-md-9">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="far fa-user-circle"></i></span>
                </div>
                @Html.TextBoxFor(m => m.FullName, new { disabled = true, @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">Email</label>
        <div class="col-md-9">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                </div>
                @Html.TextBoxFor(m => m.Email, new { disabled = true, @class = "form-control" })
            </div>
        </div>
    </div>
    <hr />
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("User_Label_DonVi")</label>
        <div class="col-sm-9">
            <select id="BoPhanSelect2" class="form-control" multiple="multiple" style="width:100%">
                @foreach (var item in Model.ListBophans)
                {
                    var selected = !string.IsNullOrEmpty(Model.MaBophans) &&
                                   Model.MaBophans.Split(',').Contains(item.MaBoPhan) ? "selected" : "";
                    var label = string.IsNullOrEmpty(item.TenBoPhanView)
                        ? item.TenBoPhan
                        : item.TenBoPhanView;
                    <option value="@item.MaBoPhan" @selected>@label</option>
                }
            </select>
        </div>
    </div>
</div>

<script type="text/javascript">
    function initBoPhanSelect2() {
        if ($('#BoPhanSelect2').hasClass('select2-hidden-accessible')) {
            $('#BoPhanSelect2').select2('destroy');
        }
        $('#BoPhanSelect2').select2({
            placeholder: 'Chọn đơn vị...',
            allowClear: false,
            width: '100%',
            templateSelection: function (data) {
                return data.text;
            }
        });

        var initial = $('#BoPhanSelect2').val();
        $('input[name="MaBophans"]').val(initial ? initial.join(',') : '');

        $('#BoPhanSelect2').off('change').on('change', function () {
            var selected = $(this).val();
            $('input[name="MaBophans"]').val(selected ? selected.join(',') : '');
        });
    }

    $(document).ready(function () {
        initBoPhanSelect2();
    });
</script>