@using TSFramework.Libs.Extensions
@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.UserPermitReviewModel
@Html.AntiForgeryToken()
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(m => m.UserId)
@Html.HiddenFor(m => m.UserName)
@Html.HiddenFor(m => m.FullName)
@Html.HiddenFor(m => m.Email)

<div id="BoPhan">
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("User_Label_HoTen")</label>
        <div class="col-md-8">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="far fa-user-circle"></i></span>
                </div>
                @Html.TextBoxFor(m => m.FullName, new { disabled = true, @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">Email</label>
        <div class="col-md-8">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                </div>
                @Html.TextBoxFor(m => m.Email, new { disabled = true, @class = "form-control" })
            </div>
        </div>
    </div>
    <hr />
    <div class="form-group row">
        @Html.TitleFor(model => model.ReviewDepartment, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-8">
            @Html.DropDownListFor(model => model.ReviewDepartment, new SelectList(Model.ListBophans, "MaBoPhan", "TenBoPhanView"), "", new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.ReviewLevel, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-4">
            @Html.DropDownListFor(
                model => model.ReviewLevel,
                Model.ListLevel.Select(x => new SelectListItem
                {
                    Value = x.ToString(),
                    Text = "Cấp " + x
                }),
                "",
                new { @class = "form-control" }
            )
        </div>
    </div>
</div>