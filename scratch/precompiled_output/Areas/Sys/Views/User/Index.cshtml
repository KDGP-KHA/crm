@using TSFramework.Libs.Extensions
@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("User_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddUser", Url.Action("Add", new { area = "Sys" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "1024px" })
}
@*@Html.Partial("_Search")*@
<style>
    @@font-face {
        font-family: 'password';
        /*  font-style: normal;
        font-weight: 800;*/
        src: url(https://jsbin-user-assets.s3.amazonaws.com/rafaelcastrocouto/password.ttf);
    }

    input.key {
        font-family: 'password';
    }
</style>

<div class="card dcard">
    <div class="col-sm-12 table-responsive-md">
        <table id="DSUser" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table">
            <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                <tr>
                    <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                    <th>@AppProcessor.Messagor.GetMessage("User_Label_FullName")</th>
                    <th>@AppProcessor.Messagor.GetMessage("User_Label_UserName")</th>
                    @*<th>@AppProcessor.Messagor.GetMessage("BoPhan_Title")</th>
                    <th>@AppProcessor.Messagor.GetMessage("ChucVu_Title")</th>*@
                    <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
@section BottomScript
{
    <script src="~/Contents/Base/plugins/jquery.inputmask/jquery.inputmask.min.js"></script>
    <script src="@Url.Content("~/Areas/Sys/Views/User/User.js")"></script>
}