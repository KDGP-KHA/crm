@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysUserModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("User_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "User", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "User_OnProcessSuccess(data, 'DeleteUser')"
    }, new { @class = "form-horizontal" }))
    {
	    <div id="bodyForm">
		    @Html.Partial("_DeleteBody")
	    </div>
    }
}