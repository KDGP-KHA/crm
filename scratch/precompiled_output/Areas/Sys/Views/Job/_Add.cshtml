@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("SysJob_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    @using (Html.BeginForm("Add", "Job", new { area = "Sys" }, FormMethod.Post, new { encType = "multipart/form-data", id = "AddJob", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_SysJob")
        </div>
    }
    <script type="text/javascript" src="~/Contents/Modules/Sys/plugins/cRonstrue/require.min.js"></script>
    <script type="text/javascript" src="~/Contents/Modules/Sys/plugins/cRonstrue/cronstrue.min.js"></script>
    <script type="text/javascript" src="~/Contents/Modules/Sys/plugins/cronBuilder/jquery-cron-quartz.js"></script>
    <script type="text/javascript">
        $('form#AddJob').ajaxForm({
            success: function (response) {
                if (response.status != undefined) {
                    if ($("#ModalContent #modal_AddJob #chkNotDismissModal").is(":checked")) {
                        if (response.status != undefined) {
                            eval(response.message);
                            _tableJob.ajax.reload(null, false);
                            response.status = undefined;
                            $("#ModalContent #modal_AddJob form")[0].reset();
                        }
                    } else {
                        $("#ModalContent #modal_AddJob").modal("hide");
                        $("#ModalContent #modal_AddJob").on('hidden.bs.modal',
                            function () {
                                if (response.status != undefined) {
                                    eval(response.message);
                                    _tableJob.ajax.reload(null, false);
                                    response.status = undefined;
                                }
                            });
                    }
                } else {
                    $("#ModalContent #modal_AddJob" + " #bodyForm").html(response);
                }
            }
        });
    </script>
}

@section ContinueForm{

}