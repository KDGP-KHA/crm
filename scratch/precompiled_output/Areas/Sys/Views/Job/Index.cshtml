@using TSFramework.Libs.Extensions
@using TSFramework.Libs.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("SysJob_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddJob", Url.Action("Add", new { area = "Sys" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = 800 })
}

<div class="mt-3">
    <div class="card dcard">
        <div class="col-md-12">
            @*@Html.Partial("_CronExpression")*@
        </div>
        <div class="col-sm-12 table-responsive-md">
            <table id="DSJob" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                <tr class="text-center">
                    <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                    <th class="w-25">@AppProcessor.Messagor.GetMessage("Job_Label_JobName")</th>
                    <th class="w-25">@AppProcessor.Messagor.GetMessage("Job_Label_JobDescription")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Job_Label_CronExpression")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Job_Label_JobLibrary")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Job_Label_Status")</th>
                    <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    @*<script type="text/javascript" src="~/Contents/Modules/Sys/plugins/cRonstrue/require.min.js"></script>
    <script type="text/javascript" src="~/Contents/Modules/Sys/plugins/cRonstrue/cronstrue.min.js"></script>
    <script type="text/javascript" src="~/Contents/Modules/Sys/plugins/cronBuilder/jquery-cron-quartz.js"></script>*@
    <script src="@Url.Content("~/Areas/Sys/Views/Job/Job.js")"></script>
}