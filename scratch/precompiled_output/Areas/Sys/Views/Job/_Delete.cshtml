@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysJobModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("SysJob_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Job", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Job_OnProcessSuccess(data, 'DeleteJob')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.JobId)
        @Html.HiddenFor(model => model.JobName)
        @Html.HiddenFor(model => model.JobLibrary)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}