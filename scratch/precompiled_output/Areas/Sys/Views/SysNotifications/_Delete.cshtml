@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysNotificationsModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Notication_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "SysNotifications", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ThongBao_OnProcessSuccess(data, 'DeleteThongBao')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Sys_Notification_ID)
        @Html.HiddenFor(model => model.Notification_Title)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}