@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("Notication_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Html.BeginForm("Add", "SysNotifications", new { area = "Sys" }, FormMethod.Post, new { encType = "multipart/form-data", id = "BienSoanThongBao", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_ThongBao")
        </div>
    }

    <script type="text/javascript">
        $('.modal-footer #btnSave').attr('type', 'button');
        $('form#BienSoanThongBao').ajaxForm({
            success: function (response) {
                if (response.status != undefined) {
                    if ($("#ModalContent #modal_BienSoanThongBao #chkNotDismissModal").is(":checked")) {
                        if (response.status != undefined) {
                            eval(response.message);
                            _tableThongBao.ajax.reload(null, false);
                            response.status = undefined;
                            $("#ModalContent #modal_BienSoanThongBao form")[0].reset();
                        }
                    } else {
                        if (!response.status && response.errorCode == 1) {
                            eval(response.message);
                            response.status = undefined;
                        } else {
                            $("#ModalContent #modal_BienSoanThongBao").modal("hide");
                            $("#ModalContent #modal_BienSoanThongBao").on('hidden.bs.modal',
                                function () {
                                    if (response.status != undefined) {
                                        eval(response.message);
                                        _tableThongBao.ajax.reload(null, true);
                                        response.status = undefined;
                                    }
                                });
                        }
                    }
                } else {
                    $("#ModalContent #modal_BienSoanThongBao" + " #bodyForm").html(response);
                }
            }
        });
    </script>
    <script>
        $(document).ready(function () {
            // Nhấn lưu
            $("#btnSave").click(function () {
                for (instance in CKEDITOR.instances) {
                    CKEDITOR.instances[instance].updateElement();
                }
                $("#BienSoanThongBao").submit();
            });
        });

    </script>
    @Html.RenderScripts(ScriptPosition.BodyInside)
}

@section ContinueForm{

}