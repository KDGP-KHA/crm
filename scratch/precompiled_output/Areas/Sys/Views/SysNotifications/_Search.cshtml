@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysNotificationsSearchModel
<style>
    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-left.datepicker-orient-bottom {
        z-index: 1000 !important;
    }

    .datepicker.datepicker-dropdown.dropdown-menu.datepicker-orient-right.datepicker-orient-bottom {
        z-index: 1000 !important;
    }
</style>
<div class="card bcard border-0 shadow-sm radius-0" id="SearchThongBao">
    <div class="card-header bgc-primary-d1">
        <h5 class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </h5>
        <div class="card-toolbar">
            <a href="#" data-action="toggle" class="card-toolbar-btn text-white">
                <i class="fa fa-chevron-up"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="col-md-12 form-horizontal mt-4">
            <div class="form-group row">
                <label class="col-form-label text-sm-right pr-0 font-bold col-md-2">@AppProcessor.Messagor.GetMessage("Label_TuKhoa")</label>
                <div class="col-md-3">
                    <div class="input-group">
                        @Html.TextBoxFor(model => model.TuKhoa, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("TuKhoa_ThongBao") })
                    </div>
                </div>

                <label class="col-form-label text-sm-right pr-0 font-bold col-md-2">@AppProcessor.Messagor.GetMessage("NgayTao")</label>
                <div class="col-md-2">
                    <div class="input-group d-flex align-items-center font-bold">
                        @Html.TextBoxFor(model => model.TuNgay, new { @class = "form-control datepicker", placeholder = "Từ ngày" })
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="input-group d-flex align-items-center font-bold">
                        đến @Html.TextBoxFor(model => model.DenNgay, new { @class = "form-control datepicker ml-2", placeholder = "Đến ngày" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="col-md-12 text-center">
            <button type="button" class="btn btn-primary" onclick="Search()"><i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")</button>
        </div>
    </div>
</div>