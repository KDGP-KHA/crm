@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysRoleModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Role_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Role", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Role_OnProcessSuccess(data, 'DeleteRole')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.RoleId)
        @Html.HiddenFor(model => model.Name)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}