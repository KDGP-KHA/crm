@using TSFramework.Libs.Extensions
@model Modules.Sys.Areas.Sys.Data.SysUploadModel

@section PluginCss
{
    <link rel="stylesheet" type="text/css" href="~/Contents/Base/plugins/ace_v4/node_modules/jqtree/jqtree.css">
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{

}

<div class="row">
    <div class="col-12 col-md-6 mt-3 mt-md-0">
        <div class="card bcard h-auto border-0">
            <div class="card-header bgc-green-d3">
                <h3 class="card-title text-130 text-white">
                    Browse Files
                </h3>
            </div>

            <div class="card-body bgc-white border-1 border-t-0 brc-success-m3 table-responsive" style="height: calc(70vh);">
                <div class="jqtree tree-dotted" id="treeFolders"></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 mt-3 mt-md-0">
        @using (Html.BeginForm("UploadFile", "SysTool", new { area = "Sys" }, FormMethod.Post, new { encType = "multipart/form-data", id = "UploadFile", @class = "form-horizontal" }))
        {
            <div id="bodyForm">
                <div class="form-group row">
                    @Html.TitleFor(model => model.AbsolutePath, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                    <div class="col-md-9">
                        @Html.TextBoxFor(model => model.AbsolutePath, new { @class = "form-control col-md-12", placeholder = "AbsolutePath" })
                        @Html.ValidationMessageFor(model => model.AbsolutePath, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row">
                    @Html.TitleFor(model => model.FileUpload, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                    <div class="col-md-9">
                        @Html.FileFor(model => model.FileUpload, ".*", true, new { @class = "form-control col-md-12", placeholder = "FileUpload" })
                        @Html.ValidationMessageFor(model => model.FileUpload, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row">
	                <button type="submit" id="btnSave" class="btn px-4 btn-outline-primary mb-1"><i class="fa fa-save"></i>&nbsp;Lưu</button>
                </div>
            </div>
        }

    </div>
</div>

@section PluginJs
{
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/jqtree/tree.jquery.js")"></script>
}

@Html.RenderScripts(ScriptPosition.BodyInside)

@section BottomScript
{
    <script type="text/javascript">

        jQuery(function ($) {

            // Browse Files Tree
            //var fileData = [
            //    {
            //        id: 1,
            //        name: 'Cloud Files',
            //        icons: {
