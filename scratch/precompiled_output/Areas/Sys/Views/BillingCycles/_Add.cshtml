@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("BillingCycles_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Add", "BillingCycles", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "BillingCycles_OnProcessSuccess(data, 'AddBillingCycles')"
    }, new { @class = "form-horizontal", id = "AddBillingCycles" }))
    {
        <div id="bodyForm">
            @Html.Partial("_BillingCycles")
        </div>
    }
}

@section ContinueForm{

}