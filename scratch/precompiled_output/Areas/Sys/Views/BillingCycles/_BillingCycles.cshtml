@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_BillingCyclesModel

@Html.AntiForgeryToken()
<div id="RM_BillingCycles">
    @Html.HiddenFor(model => model.BillingCycleID)

    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.CycleName, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.CycleName, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("CycleName_Label") })
            @Html.ValidationMessageFor(model => model.CycleName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <label>
                @Html.CheckBoxFor(m => m.Islimited, new { @id = "Islimited" })
                <span class="badge bgc-blue brc-blue text-white badge-lg arrowed arrowed-in-right mb-1">
                    @Html.TitleFor(model => model.Islimited, new { @class = "" })
                </span>
            </label>
        </div>
    </div>
    <div class="form-group row" id="Islimited_setting">
        <div class="col-md-3">
            @Html.TitleFor(model => model.Quantity, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.Quantity, new { @type = "number", @min = "0", @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Quantity_Label") })
            @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-9">
            @Html.TitleFor(model => model.CycleType, new { @class = "font-bold" })
            <div class="col-form-label">
                <label class="pr-3">
                    @Html.RadioButtonFor(x => x.CycleType, "DAY")
                    Ngày
                </label>
                <label class="pr-3">
                    @Html.RadioButtonFor(x => x.CycleType, "MONTH")
                    Tháng
                </label>
                <label>
                    @Html.RadioButtonFor(x => x.CycleType, "YEAR")
                    Năm
                </label>
            </div>
            @Html.ValidationMessageFor(model => model.CycleType, "", new { @class = "text-danger" })
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#Islimited_setting').hide(); // Initially hide the div

        $('#Islimited').change(function () {
            if ($(this).is(':checked')) {
                $('#Islimited_setting').show(); // Show div when checked
            } else {
                $('#Islimited_setting').hide(); // Hide div when unchecked
            }
        });

        // Check initial state of the checkbox
        if ($('#Islimited').is(':checked')) {
            $('#Islimited_setting').show(); // Show if checked on load
        }
    });
</script>