@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_BillingCyclesModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("BillingCycles_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "BillingCycles", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "BillingCycles_OnProcessSuccess(data, 'DeleteBillingCycles')"
    }, new { @class = "form-horizontal", id = "DeleteBillingCycles" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.BillingCycleID)
        @Html.HiddenFor(model => model.CycleName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}