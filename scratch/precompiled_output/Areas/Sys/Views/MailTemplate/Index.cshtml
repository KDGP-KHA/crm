@using TSFramework.Libs.Extensions
@{
    ViewBag.Title = "Quản lý mẫu email";
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "GuideMailTemplate", Url.Action("Guide", new { area = "Sys" }), "<i class='fa fa-book'></i>", "HDSD", new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right mr-2" })
    @Html.Button(true, "AddMailTemplate", Url.Action("Add", new { area = "Sys" }), "<i class='fa fa-plus'></i>", "Thêm mẫu email", new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right" })
}

@Html.Partial("_Search", new TSFramework.Libs.Models.Base.BaseSearchModel())

<div class="mt-3">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="DSMailTemplate" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>Mã mẫu</th>
                        <th>Tên mẫu</th>
                        <th>Tiêu đề</th>
                        <th>Hoạt động</th>
                        <th>Đường dẫn file</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript {
    <script src="@Url.Content("~/Areas/Sys/Views/MailTemplate/MailTemplate.js")"></script>
}
