@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysSMSTemplateModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("SMSTemplate_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "SMSTemplate", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "SMSTemplate_OnProcessSuccess(data, 'DeleteSMSTemplate')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.SMSTemplateID)
        @Html.HiddenFor(model => model.TemplateName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}