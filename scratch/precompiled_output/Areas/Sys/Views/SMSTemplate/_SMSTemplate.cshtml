@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysSMSTemplateModel

@Html.AntiForgeryToken()
<div id="Language">
    @Html.HiddenFor(model => model.SMSTemplateID)

    <div class="form-group row">
        @Html.TitleFor(model => model.TemplateCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-8">
            @Html.TextBoxFor(model => model.TemplateCode, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("SMSTemplate_Label_Code") })
            @Html.ValidationMessageFor(model => model.TemplateCode, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.TemplateName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-8">
            @Html.TextBoxFor(model => model.TemplateName, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("SMSTemplate_Label_Name") })
            @Html.ValidationMessageFor(model => model.TemplateName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.TemplateContent, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-8">
            @Html.TextAreaFor(m => m.TemplateContent, new { @class = "form-control", rows = "3", placeholder = AppProcessor.Messagor.GetMessage("SMSTemplate_Label_Content") })
            @Html.ValidationMessageFor(model => model.TemplateContent, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.IsActive, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-8">
            @Html.CheckBoxFor(model => model.IsActive, new { @class = "mt-2" })
        </div>
    </div>
</div>
