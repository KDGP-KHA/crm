@using TSFramework.Libs.Processors
@model Core.Cate.Models.MailTemplateRenderModel
@{
    string mailTitle = AppProcessor.Messagor.GetMessage("Mail_Title") ?? AppProcessor.Messagor.GetMessage("App_Title") ?? "VNPT CRM";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@mailTitle</title>
</head>
<body style="margin:0; padding:0; font-family:Arial, Helvetica, sans-serif; background:#f5f7fb; color:#233042;">
    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f5f7fb; padding:24px 0;">
        <tr>
            <td align="center">
                <table cellpadding="0" cellspacing="0" border="0" width="720" style="max-width:720px; background:#ffffff; border-radius:8px; overflow:hidden;">
                    <tr>
                        <td style="background:#d97706; padding:20px 24px; color:#ffffff;">
                            <div style="font-size:20px; font-weight:bold;">@mailTitle</div>
                            <div style="font-size:13px; opacity:0.9; margin-top:6px;">Thông báo hợp đồng đến hạn xuất hóa đơn</div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:24px;">
                            <p style="margin:0 0 16px 0;">Kính gửi <strong>@Model.GetString("AM_FullName")</strong>,</p>
                            <p style="margin:0 0 16px 0;">Bạn có hợp đồng được nhắc đến hạn thanh toán vào hôm nay:</p>

                            <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
                                <tr>
                                    <td style="width:180px; padding:8px 0; color:#5b6778;">Mã hợp đồng</td>
                                    <td style="padding:8px 0; font-weight:bold;">@Model.GetString("ContractCode")</td>
                                </tr>
                                <tr>
                                    <td style="padding:8px 0; color:#5b6778;">Tên hợp đồng</td>
                                    <td style="padding:8px 0;">@Model.GetString("ContractName")</td>
                                </tr>
                                <tr>
                                    <td style="padding:8px 0; color:#5b6778;">Khách hàng</td>
                                    <td style="padding:8px 0;">@Model.GetString("CustomerName", "--") (Số điện thoại: @Model.GetString("CustomerPhone", "--"))</td>
                                </tr>
                                <tr>
                                    <td style="padding:8px 0; color:#5b6778;">Dịch vụ</td>
                                    <td style="padding:8px 0;">@Model.GetString("NameProduct", "--")</td>
                                </tr>
                                <tr>
                                    <td style="padding:8px 0; color:#5b6778;">Dự án</td>
                                    <td style="padding:8px 0;">@Model.GetString("ProjectName", "--")</td>
                                </tr>
                            </table>
                            <p style="margin:24px 0 0 0;">Trân trọng.</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
