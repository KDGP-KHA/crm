@using TSFramework.Libs.Processors
@model Core.Cate.Models.MailTemplateRenderModel

@{
    string mailTitle = AppProcessor.Messagor.GetMessage("Mail_Title")
        ?? AppProcessor.Messagor.GetMessage("App_Title")
        ?? "VNPT CRM";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@mailTitle</title>
</head>
<body style="margin:0; padding:0; font-family:Arial, Helvetica, sans-serif; background:#f5f7fb; color:#233042;">
    <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f5f7fb; padding:24px 0;">
        <tr>
            <td align="center">
                <table cellpadding="0" cellspacing="0" border="0" width="720" style="max-width:720px; background:#ffffff; border-radius:8px; overflow:hidden;">
                    <tr>
                        <td style="background:#dc3545; padding:20px 24px; color:#ffffff;">
                            <div style="font-size:20px; font-weight:bold;">@mailTitle</div>
                            <div style="font-size:13px; opacity:0.9; margin-top:6px;">
                                Thông báo nhắc nhở báo cáo nội dung thực hiện trong tuần
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:24px;">

                            <p style="margin:0 0 16px 0;">
                                Kính gửi <strong>@Model.GetString("FullName")</strong>,
                            </p>

                            <p style="margin:0 0 20px 0;">
                                Hệ thống chưa ghi nhận báo cáo nội dung thực hiện trong tuần đối với
                                <strong>@Model.GetString("ObjectType")</strong>
                                <a href="@Model.GetString("DetailUrl")"
                                   style="color:#0d6efd; font-weight:bold; text-decoration:none;">
                                    @Model.GetString("ObjectName")
                                </a>.
                            </p>

                            <div style="margin-top:24px; padding:16px; background:#fff8e5; border:1px solid #ffe08a; border-radius:6px; line-height:1.7;">
                                Bạn cần báo cáo nội dung thực hiện
                                <strong>@Model.GetString("ObjectType")</strong>
                                <strong>@Model.GetString("ObjectName")</strong>
                                <br />
                                Link chi tiết: 
                                <a href="@Model.GetString("DetailUrl")">
                                    @Model.GetString("DetailUrl")
                                </a>
                            </div>

                            <p style="margin-top:32px;">
                                Trân trọng.
                            </p>

                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>