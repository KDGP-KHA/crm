@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Review"), AppProcessor.Messagor.GetMessage("DigitalSales_Entity_Name"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
@using (Html.BeginForm("ReviewBatch", "ReviewBatchItem", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "ReviewBatch", @class = "form-horizontal" }))
    {
        @Html.Hidden("ContinueReview", false, new { id = "ReviewBatchContinueReview" })
        <div id="bodyForm">
            @Html.Partial("_ReviewForm")
        </div>
    }

    <script type="text/javascript">
        // Neo panel rà soát về bên phải màn hình.
        // Khởi tạo với backdrop:false ngay trước khi framework gọi modal("show")
        // để không sinh lớp phủ chặn thao tác với nội dung phía sau.
        var $reviewDock = $('#modal_ReviewBatch');
        var $reviewSplitView = $('#reviewSplitView');
        var $reviewFormPane = $('#reviewFormPane');

        // Panel rà soát là một phần của màn hình chi tiết, không cho đóng bằng
        // nút X, nút Hủy hoặc phím Escape. Người dùng vẫn có thể thu gọn panel.
        $reviewDock.find('.modal-header [data-dismiss="modal"], .modal-footer [data-dismiss="modal"]').remove();

        function resizeReviewFormPane() {
            if (!$reviewFormPane.length) return;
            var paneTop = $reviewFormPane.data('fixedTop');
            if (paneTop === undefined) {
                paneTop = Math.max($reviewFormPane[0].getBoundingClientRect().top, 8);
                $reviewFormPane.data('fixedTop', paneTop);
            }
            var availableHeight = Math.max(window.innerHeight - paneTop - 8, 180);
            $reviewFormPane.css({
                top: paneTop + 'px',
                height: availableHeight + 'px',
                maxHeight: availableHeight + 'px'
            });
        }

        if (!$reviewDock.find('.review-dock-toggle').length) {
            $reviewDock.find('.modal-header').append(
                '<button type="button" class="review-dock-toggle btn btn-outline-white btn-h-primary btn-a-primary mr-2" ' +
                'title="@Html.Raw(HttpUtility.JavaScriptStringEncode(AppProcessor.Messagor.GetMessage("ReviewDigitalSales_Collapse")))" aria-label="@Html.Raw(HttpUtility.JavaScriptStringEncode(AppProcessor.Messagor.GetMessage("ReviewDigitalSales_Collapse")))" aria-expanded="true">' +
                '<i class="fas fa-chevron-right"></i></button>'
            );
        }

        $reviewDock
            .addClass('review-dock-right')
            .removeClass('modal-lg modal-fs')
            .modal({ backdrop: false, keyboard: false, show: false })
            .on('show.bs.modal', function () {
                if ($reviewFormPane.length) {
                    $(this).appendTo($reviewFormPane);
                    $reviewSplitView.addClass('review-split-active');
                    resizeReviewFormPane();
                }
            })
            .on('shown.bs.modal', function () {
                $('body').addClass('review-dock-open');
            })
            .on('hidden.bs.modal', function () {
                $('body').removeClass('review-dock-open');
                $(this).removeClass('review-dock-collapsed');
                $reviewSplitView.removeClass('review-split-active review-split-collapsed');
                $(this).find('.review-dock-toggle')
                    .attr('title', '@Html.Raw(HttpUtility.JavaScriptStringEncode(AppProcessor.Messagor.GetMessage("ReviewDigitalSales_Collapse")))')
                    .attr('aria-label', '@Html.Raw(HttpUtility.JavaScriptStringEncode(AppProcessor.Messagor.GetMessage("ReviewDigitalSales_Collapse")))')
                    .attr('aria-expanded', 'true')
                    .find('i')
                    .removeClass('fa-chevron-left')
                    .addClass('fa-chevron-right');
            });

        $(window)
            .off('resize.reviewDockSize')
            .on('resize.reviewDockSize', resizeReviewFormPane);

        $reviewDock
            .off('click.reviewDockToggle', '.review-dock-toggle')
            .on('click.reviewDockToggle', '.review-dock-toggle', function () {
                var isCollapsed = $reviewDock.toggleClass('review-dock-collapsed')
                    .hasClass('review-dock-collapsed');
                $reviewSplitView.toggleClass('review-split-collapsed', isCollapsed);
                $(this)
                    .attr('title', isCollapsed ? '@Html.Raw(HttpUtility.JavaScriptStringEncode(AppProcessor.Messagor.GetMessage("ReviewDigitalSales_Expand")))' : '@Html.Raw(HttpUtility.JavaScriptStringEncode(AppProcessor.Messagor.GetMessage("ReviewDigitalSales_Collapse")))')
                    .attr('aria-label', isCollapsed ? '@Html.Raw(HttpUtility.JavaScriptStringEncode(AppProcessor.Messagor.GetMessage("ReviewDigitalSales_Expand")))' : '@Html.Raw(HttpUtility.JavaScriptStringEncode(AppProcessor.Messagor.GetMessage("ReviewDigitalSales_Collapse")))')
                    .attr('aria-expanded', (!isCollapsed).toString())
                    .find('i')
                    .toggleClass('fa-chevron-right', !isCollapsed)
                    .toggleClass('fa-chevron-left', isCollapsed);
            });
    </script>

    <script type="text/javascript">
        var reviewBatchSaveAndContinue = false;

        $(document)
            .off('click.reviewBatchSubmit', '#modal_ReviewBatch .js-review-batch-submit')
            .on('click.reviewBatchSubmit', '#modal_ReviewBatch .js-review-batch-submit', function () {
                reviewBatchSaveAndContinue = $(this).data('continue') === true;
                $('#ReviewBatchContinueReview').val(reviewBatchSaveAndContinue ? 'true' : 'false');
                $('#modal_ReviewBatch form#ReviewBatch').trigger('submit');
            });

        $('form#ReviewBatch').ajaxForm({
            beforeSubmit: function () {
                if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances.ReviewComment) {
                    CKEDITOR.instances.ReviewComment.updateElement();
                }
                return true;
            },
            success: function (response) {
                const formId = "ReviewBatch";
                const $modal = $("#modal_" + formId);
                // validate fail
                if (response.status === undefined) {
                    $modal.find("#bodyForm").html(response);
                    var $form = $modal.find('form#ReviewBatch');
                    if ($.validator && $.validator.unobtrusive) {
                        $form.removeData('validator').removeData('unobtrusiveValidation');
                        $.validator.unobtrusive.parse($form);
                    }
                    return;
                }
                if (response.status !== true) {
                    eval(response.message);
                    response.status = undefined;
                    return;
                }
                const processSuccess = (targetUrl) => {
                    eval(response.message);
                    window.location.href = targetUrl;
                    response.status = undefined;
                };

                // Quay lại đúng đợt khi không tiếp tục hoặc đã rà soát hết.
                const batchId = response.reviewBatchID || 0;
                const backUrl = batchId > 0
                    ? "/Cate/ReviewBatchItem/Index/" + batchId
                    : "/Cate/ReviewBatchItem";
                const targetUrl = reviewBatchSaveAndContinue && response.nextReviewUrl
                    ? response.nextReviewUrl
                    : backUrl;

                $modal.off("hidden.bs.modal")
                    .on("hidden.bs.modal", function () {
                        processSuccess(targetUrl);
                    });
                $modal.modal("hide");
            }
        });
    </script>
}

@section SubmitControl{
    <button type="button" class="js-review-batch-submit btn px-4 btn-outline-primary mb-1" data-continue="false">
        <i class="fa fa-save"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Save")
    </button>
    <button type="button" class="js-review-batch-submit btn px-4 btn-primary mb-1" data-continue="true">
        <i class="fa fa-save"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Modal_ContinueForm")
    </button>
}
