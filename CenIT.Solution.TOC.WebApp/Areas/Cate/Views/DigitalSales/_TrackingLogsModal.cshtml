@using TSFramework.Libs.Processors
@model List<Core.Cate.Models.RM_DigitalSalesActivityModel>
@{
    var task = ViewBag.Task as Core.Cate.Models.RM_DigitalSalesTrackingModel;
    var logs = Model ?? new List<Core.Cate.Models.RM_DigitalSalesActivityModel>();
}

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_TrackingLogsModal.css?v=@DateTime.Now.Ticks" />

<div class="modal fade" id="modalTrackingLogs" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white mb-0">
                    <i class="fa fa-history mr-1"></i> Log thao tác tiến trình
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @if (task != null)
                {
                    <div class="alert alert-light border-1 brc-info-m3 py-2 px-3 mb-3 text-90 radius-1 d-flex align-items-center justify-content-between flex-wrap" style="gap: 8px;">
                        <div class="d-flex align-items-center flex-wrap" style="gap: 6px;">
                            <span class="badge bgc-primary-l4 text-primary-d2 border-1 brc-primary-m3 font-bold px-2 py-1">@task.TrackingCode</span>
                            <span class="font-weight-bold text-dark text-105">@task.TaskName</span>
                        </div>
                        <span class="badge @(task.Status == 3 ? "badge-success" : (task.Status == 2 ? "badge-warning" : "badge-secondary")) font-bold px-2 py-1">
                            @(task.Status == 3 ? "Hoàn thành" : (task.Status == 2 ? "Đang làm" : (task.Status == 4 ? "Quá hạn" : "Chưa làm")))
                        </span>
                    </div>
                }

                @if (logs.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-clipboard-list fa-3x mb-2 text-secondary-m3 d-block"></i>
                        <span class="text-90 font-italic">Chưa có lịch sử log thao tác nào cho tiến trình này.</span>
                    </div>
                }
                else
                {
                    <div class="tracking-log-timeline">
                        @foreach (var log in logs)
                        {
                            <div class="tracking-log-item">
                                <div class="tracking-log-dot"></div>
                                <div class="tracking-log-card">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap mb-1" style="gap: 6px;">
                                        <div class="d-flex align-items-center">
                                            <span class="font-weight-bold text-primary-d1 mr-2 text-90">
                                                <i class="fa fa-user-circle mr-1"></i>@(string.IsNullOrEmpty(log.ActionByName) ? log.ActionBy : log.ActionByName)
                                            </span>
                                            @if (!string.IsNullOrEmpty(log.ActionByDepartment))
                                            {
                                                <span class="badge badge-light-secondary text-75 mr-2">@log.ActionByDepartment</span>
                                            }
                                        </div>
                                        <span class="text-muted text-80">
                                            <i class="far fa-clock mr-1"></i>@log.ActionDate.ToString("dd/MM/yyyy HH:mm:ss")
                                        </span>
                                    </div>
                                    <div class="text-dark text-90 log-content">
                                        @Html.Raw(log.Content)
                                    </div>
                                    @if (log.AttachmentList != null && log.AttachmentList.Count > 0)
                                    {
                                        <div class="mt-2 pt-2 border-t-1 brc-grey-l3">
                                            <div class="text-75 font-weight-bold text-secondary mb-1">
                                                <i class="fa fa-paperclip mr-1"></i> Tệp đính kèm (@log.AttachmentList.Count):
                                            </div>
                                            <div class="d-flex flex-wrap" style="gap: 6px;">
                                                @foreach (var att in log.AttachmentList)
                                                {
                                                    <a href="@Url.Action("DownloadAttachment", "DigitalSales", new { area = "Cate", filePath = att.FilePath })" target="_blank" class="badge badge-light-info border-1 brc-info-m3 text-info-d2 px-2 py-1 radius-1 text-80">
                                                        <i class="fa @(att.IsImage ? "fa-image" : "fa-file") mr-1"></i>@att.FileName
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary px-3 radius-1" data-dismiss="modal">
                    <i class="fa fa-times mr-1"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</div>
