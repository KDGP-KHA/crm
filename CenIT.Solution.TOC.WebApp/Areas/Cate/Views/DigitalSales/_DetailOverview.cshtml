@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesModel
@{
    bool canEdit = ViewBag.CanEdit == true;
}

@functions {
    public static string RenderCleanNoteHtml(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return string.Empty;
        var text = content.Trim();

        // 1. Phục hồi lỗi font Mojibake nếu dữ liệu bị double-encoding UTF-8 sang Windows-1252
        text = Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(text);

        // 2. Giải mã HTML Entities nếu bị encode (&lt;p&gt; -> <p>)
        if (text.Contains("&lt;") && text.Contains("&gt;"))
        {
            text = System.Web.HttpUtility.HtmlDecode(text);
        }

        // 3. Nếu là plain text không chứa thẻ HTML, chuyển đổi \r\n thành <p> và <br />
        if (!text.Contains("<p") && !text.Contains("<div") && !text.Contains("<br") && !text.Contains("<table") && !text.Contains("<ul") && !text.Contains("<ol"))
        {
            var paragraphs = text.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
            var sb = new System.Text.StringBuilder();
            foreach (var p in paragraphs)
            {
                sb.Append("<p>").Append(p.Replace("\r\n", "<br />").Replace("\n", "<br />")).Append("</p>");
            }
            text = sb.ToString();
        }

        return text;
    }
}

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_DetailOverview.css?v=@DateTime.Now.Ticks" />

<span id="partialOverviewHeaderInfo" class="d-none" data-title="@Model.Title" data-code="@Model.Code" data-status="@Model.StatusName" data-status-id="@Model.StatusID" data-business-type="@Model.BusinessType"></span>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card border-1 brc-grey-l2 p-3 p-lg-4 h-100 shadow-sm">
            <h6 class="text-primary font-weight-bold border-b-1 brc-grey-l2 pb-2 mb-3" style="font-size: 16px;">
                <i class="fa fa-briefcase mr-1"></i> @(Model.BusinessType == 2 ? "Thông tin Dự án" : "Thông tin Cơ hội kinh doanh")
            </h6>
            <table class="table table-sm table-borderless overview-info-table mb-0">
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="width: 145px; padding: 8px 4px;">
                        @(Model.BusinessType == 2 ? "Tên dự án:" : "Tên cơ hội:")
                    </td>
                    <td class="font-weight-bold text-dark info-title-val" style="padding: 8px 4px;">@Model.Title</td>
                </tr>
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="padding: 8px 4px;">Mã KD SPDV:</td>
                    <td style="padding: 8px 4px;">
                        <span class="badge bgc-warning-l3 text-warning-d3 border-1 brc-warning-m2 font-mono font-bold px-2 py-1 shadow-sm">
                            <i class="fa fa-hashtag mr-1 opacity-75"></i>@Model.Code
                        </span>
                    </td>
                </tr>
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="padding: 8px 4px;">Khách hàng:</td>
                    <td class="font-weight-bold text-primary info-val" style="padding: 8px 4px;"><i class="fa fa-building mr-1"></i>@Model.CustomerName</td>
                </tr>
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="padding: 8px 4px;">Loại hình:</td>
                    <td style="padding: 8px 4px;">
                        @if (Model.BusinessType == 1)
                        {
                            <span class="badge badge-primary px-2 py-1"><i class="fa fa-lightbulb mr-1"></i> Cơ hội kinh doanh</span>
                        }
                        else
                        {
                            <span class="badge badge-purple px-2 py-1"><i class="fa fa-project-diagram mr-1"></i> Dự án số</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="padding: 8px 4px;">Trạng thái:</td>
                    <td style="padding: 8px 4px;">
                        <span class="badge badge-success px-2 py-1"><i class="fa fa-check-circle mr-1"></i> @Model.StatusName</span>
                    </td>
                </tr>
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="padding: 8px 4px;">Năm áp dụng:</td>
                    <td style="padding: 8px 4px;">
                        <span class="badge bgc-danger-l4 text-danger font-bolder border-1 brc-danger-m2 px-2 py-1 shadow-sm">
                            <i class="fa fa-calendar-alt mr-1 text-danger"></i> Năm @(Model.ApplyYear.HasValue && Model.ApplyYear.Value > 0 ? Model.ApplyYear.Value : (Model.CreatedDate.Year > 1900 ? Model.CreatedDate.Year : DateTime.Now.Year))
                        </span>
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card border-1 brc-grey-l2 p-3 p-lg-4 h-100 shadow-sm">
            <h6 class="text-primary font-weight-bold border-b-1 brc-grey-l2 pb-2 mb-3" style="font-size: 16px;">
                <i class="fa fa-user-shield mr-1"></i> Phân công & Quản lý
            </h6>
            <table class="table table-sm table-borderless overview-info-table mb-0">
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="width: 145px; padding: 8px 4px;">AM chủ trì:</td>
                    <td class="font-weight-bold text-primary info-val" style="padding: 8px 4px;">
                        <i class="fa fa-user-tie mr-1 text-success"></i>@(string.IsNullOrEmpty(Model.AssignedEmployeeName) ? "Chưa chỉ định" : Model.AssignedEmployeeName)
                    </td>
                </tr>
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="padding: 8px 4px;">Bộ phận:</td>
                    <td class="info-val" style="padding: 8px 4px;">
                        <i class="fa fa-sitemap mr-1 text-secondary"></i>@(string.IsNullOrEmpty(Model.DepartmentName) ? "—" : Model.DepartmentName)
                    </td>
                </tr>
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="padding: 8px 4px;">Người tạo:</td>
                    <td class="font-weight-bold text-dark-m1 info-val" style="padding: 8px 4px;">
                        <i class="fa fa-user mr-1 text-primary"></i>@(!string.IsNullOrEmpty(Model.CreatedByName) ? $"{Model.CreatedBy} - {Model.CreatedByName}" : Model.CreatedBy)
                    </td>
                </tr>
                <tr>
                    <td class="text-secondary font-weight-bold info-label" style="padding: 8px 4px;">Thời gian tạo:</td>
                    <td class="info-val" style="padding: 8px 4px;">
                        <i class="fa fa-clock mr-1 text-muted"></i>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <!-- THÀNH VIÊN THAM GIA & VAI TRÒ (LƯỚI DẠNG CARD HIỆN ĐẠI) -->
    <div id="sectionMembers" class="col-md-12 mb-4 ds-section-overlay-container">
        @Html.Partial("_DetailMembers", Model)
    </div>

    <!-- MÔ TẢ CHI TIẾT NHU CẦU / GHI CHÚ DỊCH VỤ SỐ -->
    <div class="col-md-12 mb-4">
        <div class="card border-1 brc-grey-l2 p-3 p-lg-4 shadow-sm">
            <div class="d-flex align-items-center justify-content-between border-b-1 brc-grey-l2 pb-2 mb-3">
                <h6 class="text-primary font-weight-bold mb-0">
                    <i class="fa fa-file-alt mr-1"></i> @(AppProcessor.Messagor.GetMessage("DigitalSales_Note_Label") ?? "Mô tả chi tiết nhu cầu / Ghi chú dịch vụ số")
                </h6>
                <span class="badge bgc-blue-l3 text-blue-d2 border-1 brc-blue-m3 text-80 px-2 py-05 font-bold">
                    <i class="fa fa-info-circle mr-1"></i> Nhu cầu SPDV số
                </span>
            </div>
            @{
                var noteHtml = RenderCleanNoteHtml(Model.Note);
            }
            <div class="p-3 p-lg-4 bg-white radius-1 text-dark ds-html-note-view shadow-none" style="min-height: 80px; font-size: 14px; line-height: 1.7;">
                @if (!string.IsNullOrWhiteSpace(noteHtml))
                {
                    @Html.Raw(noteHtml)
                }
                else
                {
                    <span class="text-muted font-italic"><i class="fa fa-info-circle mr-1"></i>Chưa có nội dung mô tả chi tiết nhu cầu / ghi chú dịch vụ số.</span>
                }
            </div>
        </div>
    </div>

    <!-- TỆP ĐÍNH KÈM -->
    <div id="sectionAttachments" class="col-md-12 mb-4 ds-section-overlay-container">
        @Html.Partial("_DetailAttachments", Model)
    </div>

    <!-- THÔNG TIN HỢP ĐỒNG (CHỈ HIỂN THỊ VỚI DỰ ÁN HOẶC ĐÃ CÓ HỢP ĐỒNG) -->
    @if (Model.BusinessType == 2 || Model.ContractID.HasValue || !string.IsNullOrEmpty(Model.ContractNo))
    {
        <div class="col-md-12 mb-4">
            <div class="card border-1 brc-grey-l2 p-3 p-lg-4 shadow-sm">
                <h6 class="text-primary font-weight-bold border-b-1 brc-grey-l2 pb-2 mb-3">
                    <i class="fa fa-file-contract mr-1"></i> Thông tin Hợp đồng & Hồ sơ pháp lý
                </h6>
                <div class="row text-90">
                    <div class="col-md-4 mb-2">
                        <span class="text-secondary font-weight-bold">Số hợp đồng:</span>
                        <span class="ml-1 font-weight-bold">@(string.IsNullOrEmpty(Model.ContractNo) ? "Chưa có" : Model.ContractNo)</span>
                    </div>
                    <div class="col-md-4 mb-2">
                        <span class="text-secondary font-weight-bold">Giá trị hợp đồng:</span>
                        <span class="ml-1 font-weight-bold text-success">@(Model.ContractValue.HasValue ? (Model.ContractValue.Value >= 100000 ? ((Model.ContractValue.Value / 1000000m) % 1 == 0 ? (Model.ContractValue.Value / 1000000m).ToString("N0") : (Model.ContractValue.Value / 1000000m).ToString("#,##0.##")) + " triệu đồng" : Model.ContractValue.Value.ToString("N0") + " triệu đồng") : "—")</span>
                    </div>
                    <div class="col-md-4 mb-2">
                        <span class="text-secondary font-weight-bold">Ngày ký:</span>
                        <span class="ml-1">@(Model.ContractSignDate.HasValue ? Model.ContractSignDate.Value.ToString("dd/MM/yyyy") : "—")</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


