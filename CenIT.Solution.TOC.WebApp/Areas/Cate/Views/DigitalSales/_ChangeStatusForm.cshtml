@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesChangeStatusViewModel
@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.DigitalSalesID)
@Html.HiddenFor(m => m.Title)
@Html.HiddenFor(m => m.CurrentBusinessType)
@Html.HiddenFor(m => m.CurrentBusinessTypeName)
@Html.HiddenFor(m => m.CurrentStatusName)
<div class="card bcard border-1 brc-grey-l2 bgc-grey-l4 p-2 mb-3"><div class="text-90"><span class="text-secondary">@AppProcessor.Messagor.GetMessage("DigitalSales_Record_Label"):</span> <strong>@Model.Title</strong></div><div class="text-90"><span class="text-secondary">@AppProcessor.Messagor.GetMessage("DigitalSales_CurrentStatus_Label"):</span> <span class="badge badge-info">@Model.CurrentStatusName</span></div></div>
<div class="alert alert-warning py-2 px-3 text-85">@AppProcessor.Messagor.GetMessage("DigitalSales_ChangeStatus_ProjectRequirement")</div>
<div class="form-group">@Html.TitleFor(m => m.NewStatusID, new { @class = "text-85 text-600 mb-1 d-block" })@Html.DropDownListFor(m => m.NewStatusID, Model.AvailableStatuses, AppProcessor.Messagor.GetMessage("DigitalSales_NewStatus_Option"), new { @class = "form-control select2" })@Html.ValidationMessageFor(m => m.NewStatusID, "", new { @class = "text-danger" })</div>
<div class="form-group">@Html.TitleFor(m => m.AttachmentPath, new { @class = "text-85 text-600 mb-1 d-block" })<input type="file" name="attachmentFile" class="form-control-file border p-1 rounded" /><small class="text-muted">@AppProcessor.Messagor.GetMessage("DigitalSales_ChangeStatusAttachment_Help")</small></div>
<div class="form-group mb-0">@Html.TitleFor(m => m.Note, new { @class = "text-85 text-600 mb-1 d-block" })@Html.TextAreaFor(m => m.Note, 3, 50, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("DigitalSales_ChangeStatusNote_Placeholder") })@Html.ValidationMessageFor(m => m.Note, "", new { @class = "text-danger" })<small class="text-muted">@AppProcessor.Messagor.GetMessage("DigitalSales_ChangeStatusNote_Help")</small></div>
