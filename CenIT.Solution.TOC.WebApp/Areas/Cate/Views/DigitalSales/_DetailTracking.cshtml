                                                <a href="javascript:void(0);" class="text-primary mr-2" onclick="openEditTodoModal(@todo.TrackingID, @Model.DigitalSalesID);" title="Chá»‰nh sá»­a viá»‡c nhá»"><i class="fa fa-edit"></i></a>
                                                <a href="javascript:void(0);" class="text-danger" onclick="actionDeleteTracking(@todo.TrackingID, @Model.DigitalSalesID);" title="XÃ³a viá»‡c nhá»"><i class="fa fa-trash-alt"></i></a>
