    var allTodoTasks = allTasks.Where(t => t.ParentID.HasValue && t.ParentID.Value > 0).ToList();
    
    // TÃ­nh tá»•ng sá»‘ lÆ°á»£ng vÃ  hoÃ n thÃ nh (tÃ­nh theo Todo list náº¿u cÃ³, hoáº·c tÃ­nh theo toÃ n bá»™ task)
    int totalCount = allTasks.Count;
    int completedCount = allTasks.Count(t => t.Status == 3);
}

<span id="partialTrackingProgress" class="d-none" data-completed="@completedCount" data-total="@totalCount"></span>

