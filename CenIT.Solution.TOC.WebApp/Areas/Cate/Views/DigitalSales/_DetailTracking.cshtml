                                                <span class="tree-todo-title mr-2">@todo.TaskName</span>
                                                <span class="ds-tree-sep">-</span>
                                                <div class="ds-tree-actions">
                                                    <a href="javascript:void(0);" class="ds-tree-btn ds-tree-btn-report" onclick="openTrackingReportModal(@todo.TrackingID, @Model.DigitalSalesID);" title="BÃ¡o cÃ¡o tiáº¿n Ä‘á»™/káº¿t quáº£ thá»±c hiá»‡n">
                                                        <i class="fa fa-file-alt mr-1"></i>BÃ¡o cÃ¡o
                                                    </a>
                                                    <span class="ds-tree-sep">|</span>
                                                    <a href="javascript:void(0);" class="ds-tree-btn ds-tree-btn-confirm" onclick="actionConfirmTracking(@todo.TrackingID, @Model.DigitalSalesID);" title="XÃ¡c nháº­n hoÃ n thÃ nh háº¡ng má»¥c">
                                                        <i class="fa fa-check mr-1"></i>XÃ¡c nháº­n
                                                    </a>
                                                    <span class="ds-tree-sep">|</span>
                                                    <a href="javascript:void(0);" class="ds-tree-btn ds-tree-btn-unlock" onclick="actionUnlockTracking(@todo.TrackingID, @Model.DigitalSalesID);" title="Má»Ÿ khÃ³a Ä‘á»ƒ chá»‰nh sá»­a/lÃ m láº¡i">
                                                        <i class="fa fa-unlock-alt mr-1"></i>Má»Ÿ khÃ³a
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="text-dark">@(string.IsNullOrEmpty(todo.AssignedUserName) ? "â€”" : todo.AssignedUserName)</span></td>
                                        <td class="text-center text-85">@todo.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">
                                            <span class="@(todoOverdue ? "text-danger font-bold" : "text-dark") text-85">
                                                @(todo.Deadline.HasValue ? todo.Deadline.Value.ToString("dd/MM/yyyy") : "â€”")
                                            </span>
                                        </td>
                                        <td class="text-center text-secondary">â€”</td>
                                        <td class="text-center">
                                            @if (todo.Status == 3)
                                            {
                                                <span class="badge badge-success text-75 px-2">HoÃ n thÃ nh</span>
                                            }
                                            else if (todo.Status == 2)
                                            {
                                                <span class="badge badge-warning text-75 px-2">Äang lÃ m</span>
                                            }
                                            else if (todoOverdue)
                                            {
                                                <span class="badge badge-danger text-75 px-2">QuÃ¡ háº¡n</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary text-75 px-2">ChÆ°a lÃ m</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(todo.AttachmentFile))
                                            {
                                                <a href="@Url.Action("DownloadAttachment", "DigitalSales", new { area = "Cate", filePath = todo.AttachmentFile })" target="_blank" class="text-primary font-bold text-80" title="Táº£i file Ä‘Ã­nh kÃ¨m">
                                                    <i class="fa fa-paperclip mr-1"></i>File
                                                </a>
