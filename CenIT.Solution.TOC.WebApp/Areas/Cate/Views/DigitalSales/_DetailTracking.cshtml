                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(task.AttachmentFile))
                                    {
                                        <a href="@Url.Action("DownloadAttachment", "DigitalSales", new { area = "Cate", filePath = task.AttachmentFile })" target="_blank" class="text-primary font-bold" title="Táº£i file káº¿t quáº£">
                                            <i class="fa fa-file-download mr-1"></i>Táº£i file
                                        </a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(task.ResultNote))
                                    {
                                        <span class="text-secondary-d1 text-80" title="@task.ResultNote">
                                            <i class="fa fa-comment-alt mr-1 text-info"></i>@(task.ResultNote.Length > 15 ? task.ResultNote.Substring(0, 15) + "..." : task.ResultNote)
                                        </span>
                                    }
                                    else
                                    {
                                        <span>â€”</span>
                                    }
                                </td>
                                @if (canEdit)
                                {
                                    <td class="text-center">
                                        <a href="javascript:void(0);" class="text-primary mr-2" onclick="openEditTrackingModal(@task.TrackingID, @Model.DigitalSalesID);" title="Chá»‰nh sá»­a tiáº¿n trÃ¬nh"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:void(0);" class="text-danger" onclick="actionDeleteTracking(@task.TrackingID, @Model.DigitalSalesID);" title="XÃ³a tiáº¿n trÃ¬nh"><i class="fa fa-trash-alt"></i></a>
                                    </td>
                                }
                            </tr>

                            <!-- ========================================================================= -->
                            <!-- Cáº¤P 4: TODO LIST TRONG TIáº¾N TRÃŒNH (CÃ”NG VIá»†C NHá»Ž, DEADLINE <= START + Tá»”NG)-->
                            <!-- ========================================================================= -->
                            if (task.TodoList != null && task.TodoList.Count > 0)
                            {
                                foreach (var todo in task.TodoList)
                                {
                                    bool todoOverdue = todo.IsOverdue == 1;
                                    <tr class="tree-row tree-todo-row" data-parent="@taskNodeId" data-subparent="@procNodeId" data-root="@statusNodeId" data-level="4">
                                        <td style="padding-left: 48px;">
                                            <div class="d-flex align-items-center flex-wrap">
                                                <span class="tree-todo-branch">â””â”€</span>
                                                <input type="checkbox" class="tree-checkbox chk-todo mr-2" id="chk_todo_@todo.TrackingID"
                                                       @(todo.Status == 3 ? "checked" : "")
