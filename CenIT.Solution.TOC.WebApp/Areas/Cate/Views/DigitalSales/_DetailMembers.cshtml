@model Core.Cate.Models.RM_DigitalSalesModel
@{
    bool canEdit = ViewBag.CanEdit == true;
    var rawMembers = Model.Members ?? new List<Core.Cate.Models.RM_DigitalSalesMemberModel>();
    var displayMembers = rawMembers
        .GroupBy(m => m.UserID > 0 ? m.UserID : m.MemberID)
        .Select(g => {
            var first = g.First();
            var allRoles = g.SelectMany(x => (x.RoleTitle ?? "").Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                            .Select(r => Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(r.Trim()))
                            .Where(r => !string.IsNullOrEmpty(r))
                            .Distinct(StringComparer.OrdinalIgnoreCase)
                            .ToList();
            return new {
                MemberID = first.MemberID,
                UserID = first.UserID,
                FullName = first.FullName,
                UserName = first.UserName,
                Roles = allRoles,
                RoleTitle = string.Join(", ", allRoles),
                IsAM = g.Any(x => x.IsAM),
                Note = first.Note
            };
        }).ToList();
}

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_DetailMembers.css?v=@DateTime.Now.Ticks" />

<span id="partialMembersCount" class="d-none" data-count="@displayMembers.Count"></span>

<div class="card border-1 brc-grey-l2 p-3 p-lg-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center border-b-1 brc-grey-l2 pb-2 mb-3">
        <h6 class="text-primary font-weight-bold mb-0">
            <i class="fa fa-users mr-1"></i> Thành viên tham gia & Vai trò
            <span class="badge badge-primary badge-pill ml-1" id="badgeMemberCount">@displayMembers.Count</span>
        </h6>
        @if (canEdit)
        {
            <button type="button" class="btn btn-xs btn-outline-primary radius-1 font-bold" onclick="openAddMemberModal(@Model.DigitalSalesID);" title="Thêm thành viên">
                <i class="fa fa-user-plus mr-1"></i> Thêm thành viên
            </button>
        }
    </div>

    @if (displayMembers.Count > 0)
    {
        <div class="row">
            @foreach (var m in displayMembers)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-12 mb-3">
                    <div class="ds-member-card">
                        <div class="ds-member-top">
                            <!-- Avatar bên trái -->
                            <div class="ds-member-avatar">
                                <i class="fa fa-user"></i>
                            </div>
                            <!-- Khối thông tin bên phải (2 dòng) -->
                            <div class="ds-member-main">
                                <!-- Dòng 1: Tên thành viên + Icon AM -->
                                <div class="ds-member-name-row">
                                    <span class="ds-member-fullname" title="@m.FullName">
                                        @m.FullName
                                    </span>
                                    @if (m.IsAM)
                                    {
                                        <span class="ds-member-am-badge" title="@(TSFramework.Libs.Processors.AppProcessor.Messagor.GetMessage("DigitalSalesMember_IsAM_Label") ?? "Được phép cập nhật nội dung")" data-toggle="tooltip">
                                            <i class="fa fa-check-circle"></i>
                                        </span>
                                    }
                                </div>
                                <!-- Dòng 2: Dưới tên -> Username bên trái & 2 Icon [Sửa][Xóa] bên phải -->
                                <div class="ds-member-sub-row">
                                    <span class="ds-member-username" title="@m.UserName">
                                        @m.UserName
                                    </span>
                                    @if (canEdit)
                                    {
                                        <div class="ds-member-actions">
                                            <button type="button" class="ds-member-btn ds-member-btn-edit" title="Chỉnh sửa vai trò" onclick="openEditMemberModal(@m.MemberID, @Model.DigitalSalesID);">
                                                <i class="fa fa-pencil-alt"></i>
                                            </button>
                                            <button type="button" class="ds-member-btn ds-member-btn-delete" title="Xóa thành viên" onclick="deleteMemberItem(@m.MemberID, @Model.DigitalSalesID);">
                                                <i class="fa fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <!-- Danh sách vai trò -->
                        <div class="ds-member-roles">
                            @if (m.Roles.Count > 0)
                            {
                                foreach (var r in m.Roles)
                                {
                                    <span class="ds-member-role-badge" title="@r">
                                        <i class="fa fa-id-badge"></i>@r
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="ds-member-role-badge" title="Thành viên">
                                    <i class="fa fa-id-badge"></i>Thành viên
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted py-4">
            <i class="fa fa-user-slash fa-2x mr-1 text-secondary-l1 mb-2 d-block"></i>
            Chưa có thành viên tham gia nào.@(canEdit ? " Bấm \"Thêm thành viên\" để phân công nhân sự vào hồ sơ." : "")
        </div>
    }
</div>
