@using TSFramework.Libs.Processors
@model CenIT.Solution.TOC.WebApp.Models.LoginModel

@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.URLLink)

@{
    var accountPlaceholder = AppProcessor.Messagor.GetMessage("Login_Placeholder_Account");
    if (string.IsNullOrEmpty(accountPlaceholder)) { accountPlaceholder = "Tài khoản"; }
    var passwordPlaceholder = AppProcessor.Messagor.GetMessage("Login_Placeholder_Password");
    if (string.IsNullOrEmpty(passwordPlaceholder)) { passwordPlaceholder = "Mật khẩu"; }
    var showPasswordLabel = AppProcessor.Messagor.GetMessage("Message_ShowPassword");
    if (string.IsNullOrEmpty(showPasswordLabel)) { showPasswordLabel = "Hiển thị mật khẩu"; }
}

<div class="login-field-group">
    <div class="login-input-wrapper">
        <i class="fa fa-user login-field-icon"></i>
        @Html.TextBoxFor(model => model.UserName, new { @autocomplete = "off", @class = "login-field-control", placeholder = accountPlaceholder, id = "UserName" })
    </div>
    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "login-error-text" })
</div>

<div class="login-field-group">
    <div class="login-input-wrapper">
        <i class="fa fa-lock login-field-icon"></i>
        @Html.PasswordFor(model => model.Password, new { @autocomplete = "off", @class = "login-field-control", placeholder = passwordPlaceholder, id = "Password" })
    </div>
    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "login-error-text" })
</div>

<button type="button" class="login-submit-btn" id="btnLogin">
    <span class="btn-text">ĐĂNG NHẬP</span>
    <span class="btn-spinner"></span>
    <span class="btn-success-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    </span>
</button>

<div class="login-options-row">
    <label class="login-checkbox-label" for="showPasswordCheckbox">
        <input type="checkbox" id="showPasswordCheckbox" />
        <span>@showPasswordLabel</span>
    </label>
    <a href="javascript:void(0);" class="login-forgot-link" id="linkForgotPassword">Quên mật khẩu?</a>
</div>

<div id="loginFeedback" class="login-feedback-area">
    @if (Model?.IsShowWarning ?? false)
    {
        <p class="mb-1 text-danger">@Html.DisplayTextFor(model => model.MessageLoginFailCount)</p>
        <p class="mb-0 text-danger">@Html.DisplayTextFor(model => model.Warning)</p>
    }
</div>

<script>
    (function () {
        function attachLoginFormEvents() {
            $("#LoginForm input").off("keydown.login").on("keydown.login", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    _submitFormLogin();
                }
            });

            $("#btnLogin").off("click.login").on("click.login", function () {
                _submitFormLogin();
            });

            $("#showPasswordCheckbox").off("change.showpwd").on("change.showpwd", function () {
                var isChecked = $(this).is(":checked");
                $("#Password").attr("type", isChecked ? "text" : "password");
            });

            $("#linkForgotPassword").off("click.forgot").on("click.forgot", function (e) {
                e.preventDefault();
                if ($(this).hasClass("disabled") || $("#btnLogin").hasClass("btn-loading") || $("#btnLogin").hasClass("btn-success") || $("#loginPanel").hasClass("form-locked")) {
                    return false;
                }
                if (typeof window.showForgotPanel === "function") {
                    window.showForgotPanel();
                }
            });
        }

        window._submitFormLogin = function () {
            var userName = $.trim($("form#LoginForm #UserName").val());
            var password = $("form#LoginForm #Password").val();

            if (!userName || !password) {
                if (typeof toastr !== "undefined") {
                    toastr.warning("Vui lòng nhập đầy đủ Tài khoản và Mật khẩu.");
                }
                if (!userName) $("form#LoginForm #UserName").focus();
                else $("form#LoginForm #Password").focus();
                return;
            }

            var $btn = $("#btnLogin");
            $btn.prop("disabled", true).addClass("btn-loading");
            $("#loginPanel").addClass("form-locked");
            $("form#LoginForm input").prop("readonly", true);
            $("form#LoginForm input[type='checkbox']").prop("disabled", true);
            $("#linkForgotPassword").addClass("disabled");

            try {
                if (typeof CryptoJS !== "undefined" && typeof keyStr !== "undefined" && typeof ivStr !== "undefined" && typeof keySplit !== "undefined") {
                    var key = CryptoJS.enc.Utf8.parse(keyStr);
                    var iv = CryptoJS.enc.Utf8.parse(ivStr);

                    var encryptedlogin = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(userName), key, {
                        keySize: 128 / 8,
                        iv: iv,
                        mode: CryptoJS.mode.CBC,
                        padding: CryptoJS.pad.Pkcs7
                    });

                    var encryptedpassword = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(password), key, {
                        keySize: 128 / 8,
                        iv: iv,
                        mode: CryptoJS.mode.CBC,
                        padding: CryptoJS.pad.Pkcs7
                    });

                    $("form#LoginForm #URLLink").val(keySplit + encryptedlogin + keySplit + encryptedpassword + keySplit + keyStr + keySplit + ivStr);
                }
            } catch (err) {
                console.error("Encryption error:", err);
            }

            $("form#LoginForm").submit();
        };

        $(document).ready(function () {
            attachLoginFormEvents();
        });
    })();
</script>
