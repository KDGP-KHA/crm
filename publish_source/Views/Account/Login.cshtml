@using TSFramework.Libs.Processors
@{
    Layout = "~/Views/Shared/_Login.cshtml";
    var title = AppProcessor.Messagor.GetMessage("Login_CRM_System_Title");
    ViewBag.Title = string.IsNullOrEmpty(title) ? "Hệ thống CRM" : title;
}

@section HeadCss{
    <link rel="stylesheet" type="text/css" href="~/Views/Account/Login.css?v=@DateTime.Now.Ticks" />
}

<div class="login-viewport-container">
    <div class="login-card">
        <!-- Circular Avatar Badge -->
        <div class="login-avatar-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="7.2" r="4.2"></circle>
                <path d="M20 21v-1.5a5.5 5.5 0 0 0-5.5-5.5h-5A5.5 5.5 0 0 0 4 19.5V21"></path>
            </svg>
        </div>

        <!-- Login Form Panel -->
        <div id="loginPanel" class="login-panel-box">
            <h1 class="login-main-title">@(string.IsNullOrEmpty(title) ? "HỆ THỐNG CRM" : title.ToUpper())</h1>
            @Html.Partial("_Login")
        </div>

        <!-- Forgot Password Panel (Step 1: Enter Username & Email) -->
        <div id="forgotPanel" class="login-panel-box d-none-animated">
            <a href="javascript:void(0);" id="btnBackToLogin" class="login-back-action">
                <i class="fa fa-arrow-left"></i> Quay lại đăng nhập
            </a>
            <h2 class="login-main-title">QUÊN MẬT KHẨU</h2>
            <p class="login-sub-desc">Vui lòng nhập Tài khoản và Email để nhận mã xác thực OTP qua thư điện tử.</p>

            <div class="login-form-wrapper">
                <div class="login-field-group">
                    <div class="login-input-wrapper">
                        <i class="fa fa-user login-field-icon"></i>
                        <input type="text" id="ForgotUserName" class="login-field-control" placeholder="Tài khoản" autocomplete="off" />
                    </div>
                </div>
                <div class="login-field-group">
                    <div class="login-input-wrapper">
                        <i class="fa fa-envelope login-field-icon"></i>
                        <input type="email" id="ForgotEmail" class="login-field-control" placeholder="Email" autocomplete="off" />
                    </div>
                </div>
                <button type="button" class="login-submit-btn" id="btnSendOtp">
                    GỬI MÃ OTP
                </button>
            </div>
        </div>

        <!-- OTP Verification Panel (Step 2: Enter 6-digit OTP) -->
        <div id="otpPanel" class="login-panel-box d-none-animated">
            <a href="javascript:void(0);" id="btnBackToForgot" class="login-back-action">
                <i class="fa fa-arrow-left"></i> Quay lại
            </a>
            <h2 class="login-main-title">XÁC THỰC MÃ OTP</h2>
            <p class="login-sub-desc">Mã OTP 6 số đã được gửi tới email <strong id="lblOtpTargetEmail"></strong>. Hiệu lực trong 5 phút.<span class="login-otp-hint">Nếu không thấy trong Hộp thư đến, vui lòng kiểm tra mục <strong>Thư rác (Spam)</strong>.</span></p>

            <div class="login-form-wrapper">
                <div class="login-field-group">
                    <div class="login-input-wrapper otp-input-wrapper">
                        <input type="text" id="OtpCode" class="login-field-control otp-control" placeholder="------" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" />
                    </div>
                </div>
                <button type="button" class="login-submit-btn" id="btnVerifyOtp">
                    XÁC NHẬN OTP
                </button>
                <div class="login-options-row login-options-center">
                    <a href="javascript:void(0);" id="btnResendOtp" class="login-forgot-link">Chưa nhận được mã? Gửi lại OTP</a>
                </div>
            </div>
        </div>

        <!-- New Password Panel (Step 3: Enter New Password & Confirm) -->
        <div id="resetPasswordPanel" class="login-panel-box d-none-animated">
            <a href="javascript:void(0);" id="btnCancelReset" class="login-back-action">
                <i class="fa fa-arrow-left"></i> Hủy và về đăng nhập
            </a>
            <h2 class="login-main-title">ĐẶT LẠI MẬT KHẨU</h2>
            <p class="login-sub-desc">Nhập mật khẩu mới cho tài khoản <strong id="lblResetTargetUser"></strong>.</p>

            <div class="login-form-wrapper">
                <div class="login-field-group">
                    <div class="login-input-wrapper">
                        <i class="fa fa-lock login-field-icon"></i>
                        <input type="password" id="NewResetPassword" class="login-field-control" placeholder="Mật khẩu mới" autocomplete="off" />
                    </div>
                </div>
                <div class="login-field-group">
                    <div class="login-input-wrapper">
                        <i class="fa fa-lock login-field-icon"></i>
                        <input type="password" id="ConfirmResetPassword" class="login-field-control" placeholder="Xác nhận mật khẩu mới" autocomplete="off" />
                    </div>
                </div>
                <div class="login-options-row">
                    <label class="login-checkbox-label" for="showResetPasswordCheckbox">
                        <input type="checkbox" id="showResetPasswordCheckbox" />
                        <span>Hiển thị mật khẩu</span>
                    </label>
                </div>
                <button type="button" class="login-submit-btn" id="btnSubmitNewPassword">
                    ĐỔI MẬT KHẨU
                </button>
            </div>
        </div>
    </div>
</div>

@section BottomScript{
    <script src="~/Contents/Base/plugins/jquery.inputmask/jquery.inputmask.min.js"></script>
    <script src="~/Contents/Base/plugins/CryptoJS/rollups/aes.js"></script>
    <script src="~/Contents/Base/plugins/CryptoJS/components/enc-base64-min.js"></script>

    <script>
        var keyStr = "24aes08";
        var ivStr = "24aes08";
        var keySplit = "24aes08";

        function makeid(length) {
            var result = '';
            var characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
            var charactersLength = characters.length;
            for (var i = 0; i < length; i++) {
                result += characters.charAt(Math.floor(Math.random() * charactersLength));
            }
            return result;
        }

        function makenumberid(length) {
            var result = '';
            var characters = '0123456789';
            var charactersLength = characters.length;
            for (var i = 0; i < length; i++) {
                result += characters.charAt(Math.floor(Math.random() * charactersLength));
            }
            return result;
        }

        keyStr = makeid(16);
        ivStr = makenumberid(16);
        keySplit = makeid(16);

        window.showPanel = function (panelId) {
            $("#loginPanel, #forgotPanel, #otpPanel, #resetPasswordPanel").addClass("d-none-animated");
            $("#" + panelId).removeClass("d-none-animated");
        };

        window.showLoginPanel = function () {
            window.showPanel("loginPanel");
        };

        window.showForgotPanel = function () {
            window.showPanel("forgotPanel");
            var currentLoginUser = $.trim($("#UserName").val());
            if (currentLoginUser && !$("#ForgotUserName").val()) {
                $("#ForgotUserName").val(currentLoginUser);
            }
            setTimeout(function () {
                if (!$("#ForgotUserName").val()) $("#ForgotUserName").focus();
                else $("#ForgotEmail").focus();
            }, 100);
        };

        window.showOtpPanel = function () {
            window.showPanel("otpPanel");
            setTimeout(function () {
                $("#OtpCode").focus();
            }, 100);
        };

        window.showResetPasswordPanel = function () {
            window.showPanel("resetPasswordPanel");
            setTimeout(function () {
                $("#NewResetPassword").focus();
            }, 100);
        };

        $(document).ready(function () {
            $("body").addClass("login-body-wrapper");

            // Navigation links between panels
            $("#btnBackToLogin, #btnCancelReset").on("click", function (e) {
                e.preventDefault();
                window.showLoginPanel();
            });

            $("#btnBackToForgot").on("click", function (e) {
                e.preventDefault();
                window.showForgotPanel();
            });

            // Ajax form login
            $('form#LoginForm').ajaxForm({
                beforeSubmit: function () {
                    $('form#LoginForm input').prop('readonly', true);
                    $("#btnLogin").prop("disabled", true).html('<i class="fa fa-spinner fa-spin mr-2"></i> Đang đăng nhập...');
                    return true;
                },
                success: function (response) {
                    if (response && response.status !== undefined) {
                        if (response.status) {
                            // Khóa toàn bộ form và đổi màu nút sang xanh lá thành công
                            $('form#LoginForm input, form#LoginForm button').prop('disabled', true);
                            $("#btnLogin").prop("disabled", true)
                                .css({ 'background-color': '#16a34a', 'border-color': '#16a34a', 'color': '#ffffff' })
                                .html('<i class="fa fa-spinner fa-spin mr-2"></i> Đăng nhập thành công! Đang vào hệ thống...');

                            // Chuyển trang ngay lập tức (không chờ delay alert)
                            var targetUrl = response.returnUrl || "/Dashboard/Dashboard";
                            if (targetUrl && !targetUrl.startsWith("http://") && !targetUrl.startsWith("https://")) {
                                targetUrl = window.location.origin + (targetUrl.startsWith("/") ? "" : "/") + targetUrl;
                            }
                            window.location.replace(targetUrl);
                            return;
                        } else {
                            // Đăng nhập thất bại: Mở lại form cho người dùng nhập lại
                            $('form#LoginForm input').prop('readonly', false).prop('disabled', false);
                            $("#btnLogin").prop("disabled", false).html("ĐĂNG NHẬP");
                            if (response.message) {
                                try { eval(response.message); } catch (e) { }
                            }
                        }
                    } else {
                        $('form#LoginForm').html(response);
                        $("#btnLogin").prop("disabled", false).html("ĐĂNG NHẬP");
                    }
                },
                error: function () {
                    $('form#LoginForm input').prop('readonly', false).prop('disabled', false);
                    $("#btnLogin").prop("disabled", false).html("ĐĂNG NHẬP");
                    if (typeof toastr !== "undefined") {
                        toastr.error("Có lỗi xảy ra trong quá trình đăng nhập. Vui lòng thử lại.");
                    }
                }
            });

            // Toggle show password on login form
            $(document).off("change", "#showPasswordCheckbox").on("change", "#showPasswordCheckbox", function () {
                var isChecked = $(this).is(":checked");
                $("#Password").attr("type", isChecked ? "text" : "password");
            });

            // Toggle show password on reset password form
            $("#showResetPasswordCheckbox").on("change", function () {
                var isChecked = $(this).is(":checked");
                $("#NewResetPassword, #ConfirmResetPassword").attr("type", isChecked ? "text" : "password");
            });

            // Step 1: Send OTP
            $("#btnSendOtp").on("click", function () {
                var userName = $.trim($("#ForgotUserName").val());
                var email = $.trim($("#ForgotEmail").val());

                if (!userName) {
                    if (typeof toastr !== "undefined") toastr.warning("Vui lòng nhập Tài khoản.");
                    $("#ForgotUserName").focus();
                    return;
                }
                if (!email) {
                    if (typeof toastr !== "undefined") toastr.warning("Vui lòng nhập Email.");
                    $("#ForgotEmail").focus();
                    return;
                }

                var $btn = $("#btnSendOtp");
                $btn.prop("disabled", true).html('<i class="fa fa-spinner fa-spin mr-2"></i> Đang gửi mã OTP...');

                $.ajax({
                    url: '@Url.Action("RequestPasswordOtp", "Account")',
                    type: 'POST',
                    data: { userName: userName, email: email },
                    success: function (res) {
                        $btn.prop("disabled", false).html("GỬI MÃ OTP");
                        if (res && res.status) {
                            if (typeof toastr !== "undefined") toastr.success(res.message);
                            $("#lblOtpTargetEmail").text(res.email || email);
                            $("#lblResetTargetUser").text(res.userName || userName);
                            $("#OtpCode").val("");
                            window.showOtpPanel();
                        } else {
                            if (typeof toastr !== "undefined") toastr.error(res.message || "Gửi yêu cầu OTP không thành công.");
                        }
                    },
                    error: function () {
                        $btn.prop("disabled", false).html("GỬI MÃ OTP");
                        if (typeof toastr !== "undefined") toastr.error("Không thể kết nối máy chủ. Vui lòng thử lại sau.");
                    }
                });
            });

            // Resend OTP
            $("#btnResendOtp").on("click", function (e) {
                e.preventDefault();
                $("#btnSendOtp").click();
            });

            // Step 2: Verify OTP
            $("#btnVerifyOtp").on("click", function () {
                var otp = $.trim($("#OtpCode").val());
                if (!otp || otp.length !== 6) {
                    if (typeof toastr !== "undefined") toastr.warning("Vui lòng nhập đủ 6 chữ số mã OTP.");
                    $("#OtpCode").focus();
                    return;
                }

                var $btn = $("#btnVerifyOtp");
                $btn.prop("disabled", true).html('<i class="fa fa-spinner fa-spin mr-2"></i> Đang xác thực...');

                $.ajax({
                    url: '@Url.Action("VerifyPasswordOtp", "Account")',
                    type: 'POST',
                    data: { otp: otp },
                    success: function (res) {
                        $btn.prop("disabled", false).html("XÁC NHẬN OTP");
                        if (res && res.status) {
                            if (typeof toastr !== "undefined") toastr.success(res.message);
                            if (res.userName) $("#lblResetTargetUser").text(res.userName);
                            $("#NewResetPassword").val("");
                            $("#ConfirmResetPassword").val("");
                            $("#showResetPasswordCheckbox").prop("checked", false);
                            $("#NewResetPassword, #ConfirmResetPassword").attr("type", "password");
                            window.showResetPasswordPanel();
                        } else {
                            if (typeof toastr !== "undefined") toastr.error(res.message || "Mã OTP không đúng hoặc đã hết hạn.");
                        }
                    },
                    error: function () {
                        $btn.prop("disabled", false).html("XÁC NHẬN OTP");
                        if (typeof toastr !== "undefined") toastr.error("Có lỗi xảy ra khi xác thực OTP. Vui lòng thử lại.");
                    }
                });
            });

            // Numeric OTP only & auto verify on 6 digits
            $("#OtpCode").on("input", function () {
                var clean = this.value.replace(/[^0-9]/g, '');
                if (this.value !== clean) this.value = clean;
                if (clean.length === 6) {
                    $("#btnVerifyOtp").click();
                }
            });

            // Step 3: Submit New Password
            $("#btnSubmitNewPassword").on("click", function () {
                var newPassword = $("#NewResetPassword").val();
                var confirmPassword = $("#ConfirmResetPassword").val();

                if (!newPassword) {
                    if (typeof toastr !== "undefined") toastr.warning("Vui lòng nhập Mật khẩu mới.");
                    $("#NewResetPassword").focus();
                    return;
                }
                if (!confirmPassword) {
                    if (typeof toastr !== "undefined") toastr.warning("Vui lòng nhập Xác nhận mật khẩu mới.");
                    $("#ConfirmResetPassword").focus();
                    return;
                }
                if (newPassword !== confirmPassword) {
                    if (typeof toastr !== "undefined") toastr.warning("Mật khẩu mới và xác nhận mật khẩu không trùng khớp.");
                    $("#ConfirmResetPassword").focus();
                    return;
                }
                if (newPassword.length < 6) {
                    if (typeof toastr !== "undefined") toastr.warning("Mật khẩu phải có độ dài tối thiểu từ 6 ký tự trở lên.");
                    $("#NewResetPassword").focus();
                    return;
                }

                var $btn = $("#btnSubmitNewPassword");
                $btn.prop("disabled", true).html('<i class="fa fa-spinner fa-spin mr-2"></i> Đang đổi mật khẩu...');

                $.ajax({
                    url: '@Url.Action("ResetPasswordWithOtp", "Account")',
                    type: 'POST',
                    data: { newPassword: newPassword, confirmPassword: confirmPassword },
                    success: function (res) {
                        $btn.prop("disabled", false).html("ĐỔI MẬT KHẨU");
                        if (res && res.status) {
                            if (typeof toastr !== "undefined") toastr.success(res.message);
                            // Clear form values
                            $("#NewResetPassword, #ConfirmResetPassword, #OtpCode, #ForgotEmail").val("");
                            // Fill login username and switch back to Login panel
                            var resetUser = res.userName || $.trim($("#ForgotUserName").val());
                            if (resetUser) {
                                $("#UserName").val(resetUser);
                            }
                            $("#Password").val("").focus();
                            setTimeout(function () {
                                window.showLoginPanel();
                            }, 500);
                        } else {
                            if (typeof toastr !== "undefined") toastr.error(res.message || "Đổi mật khẩu không thành công.");
                        }
                    },
                    error: function () {
                        $btn.prop("disabled", false).html("ĐỔI MẬT KHẨU");
                        if (typeof toastr !== "undefined") toastr.error("Có lỗi xảy ra trong quá trình đổi mật khẩu. Vui lòng thử lại.");
                    }
                });
            });

            // Enter key navigation inside inputs
            $("#ForgotUserName, #ForgotEmail").on("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    $("#btnSendOtp").click();
                }
            });

            $("#OtpCode").on("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    $("#btnVerifyOtp").click();
                }
            });

            $("#NewResetPassword, #ConfirmResetPassword").on("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    $("#btnSubmitNewPassword").click();
                }
            });
        });
    </script>
}
