@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesTrackingModel

@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.TrackingID)
@Html.HiddenFor(m => m.DigitalSalesID)
@Html.HiddenFor(m => m.ProcessID)
@Html.HiddenFor(m => m.ProgressID)
@Html.HiddenFor(m => m.IsCustomTask)

<div class="row">
    <!-- 1. Mã tiến trình (readonly) -->
    <div class="col-md-4 form-group">
        <label class="text-85 text-600 mb-1 d-block">Mã tiến trình</label>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text bgc-grey-l4"><i class="fa fa-barcode text-primary"></i></span>
            </div>
            <input type="text" class="form-control readonly-field font-bold text-primary" value="@(string.IsNullOrEmpty(Model.TrackingCode) ? "(Tự động sinh)" : Model.TrackingCode)" readonly id="Tracking_TrackingCode" />
        </div>
        @Html.HiddenFor(m => m.TrackingCode)
    </div>

    <!-- 2. Quy trình (nếu có) -->
    <div class="col-md-8 form-group">
        <label class="text-85 text-600 mb-1 d-block">Quy trình</label>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text bgc-grey-l4"><i class="fa fa-project-diagram text-warning-d2"></i></span>
            </div>
            <input type="text" class="form-control readonly-field" value="@(ViewBag.ProcessName as string ?? Model.ProcessName ?? "Quy trình chung")" readonly />
        </div>
    </div>
</div>

<!-- 3. Tên tiến trình * (Textarea) -->
<div class="form-group">
    <label class="text-85 text-600 mb-1 d-block">
        Tên tiến trình <span class="text-danger">*</span>
    </label>
    @Html.TextAreaFor(m => m.TaskName, 2, 50, new { @class = "form-control", id = "txtTrackingTaskName", placeholder = "Nhập tên tiến trình..." })
    @Html.ValidationMessageFor(m => m.TaskName, "", new { @class = "text-danger text-85 font-weight-bold d-block mt-1" })
</div>

<div class="row">
    <!-- 4. Người thực hiện * (Dropdown) -->
    <div class="col-md-6 form-group">
        <label class="text-85 text-600 mb-1 d-block">
            Người thực hiện <span class="text-danger">*</span>
        </label>
        @Html.DropDownListFor(m => m.AssignedUserID, (List<SelectListItem>)ViewBag.UserList, "-- Chọn người thực hiện --", new { @class = "form-control select2", id = "Tracking_AssignedUserID" })
        @Html.ValidationMessageFor(m => m.AssignedUserID, "", new { @class = "text-danger text-85 font-weight-bold d-block mt-1" })
    </div>

    <!-- 5. Trạng thái * -->
    <div class="col-md-6 form-group">
        <label class="text-85 text-600 mb-1 d-block">
            Trạng thái <span class="text-danger">*</span>
        </label>
        @if (Model.Status == 3)
        {
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text bgc-success-l3 text-success font-bold"><i class="fa fa-check-circle mr-1"></i></span>
                </div>
                <input type="text" class="form-control font-weight-bold text-success bgc-grey-l4" value="Hoàn thành" readonly />
                <input type="hidden" id="Tracking_Status" name="Status" value="3" />
            </div>
            <small class="text-muted text-75">Tiến trình đã hoàn thành, không thể thay đổi trạng thái.</small>
        }
        else
        {
            @Html.DropDownListFor(m => m.Status, new List<SelectListItem>
            {
                new SelectListItem { Value = "1", Text = "Chưa thực hiện" },
                new SelectListItem { Value = "2", Text = "Đang thực hiện" },
                new SelectListItem { Value = "3", Text = "Hoàn thành" }
            }, new { @class = "form-control select2", id = "Tracking_Status", onchange = "onTrackingStatusChange(this);" })
            @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger text-85 font-weight-bold d-block mt-1" })
        }
    </div>
</div>

<div class="row">
    <!-- 6. Ngày bắt đầu * (Datepicker) -->
    <div class="col-md-4 form-group">
        <label class="text-85 text-600 mb-1 d-block">
            Ngày bắt đầu <span class="text-danger">*</span>
        </label>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text bgc-grey-l4"><i class="fa fa-calendar-alt text-secondary"></i></span>
            </div>
            @Html.TextBoxFor(m => m.StartDate, "{0:dd/MM/yyyy}", new { @class = "form-control date-picker", id = "Tracking_StartDate", placeholder = "dd/MM/yyyy", autocomplete = "off", onchange = "calculateTrackingDeadline();" })
        </div>
        @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger text-85 font-weight-bold d-block mt-1" })
    </div>

    <!-- 7. Số ngày xử lý * (Textinput number) -->
    <div class="col-md-4 form-group">
        <label class="text-85 text-600 mb-1 d-block">
            Số ngày xử lý <span class="text-danger">*</span>
        </label>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text bgc-grey-l4"><i class="fa fa-hourglass-half text-secondary"></i></span>
            </div>
            @Html.TextBoxFor(m => m.DurationDays, new { @class = "form-control", id = "Tracking_DurationDays", type = "number", min = "1", step = "1", placeholder = "Số ngày", oninput = "calculateTrackingDeadline();", onchange = "calculateTrackingDeadline();" })
        </div>
        @Html.ValidationMessageFor(m => m.DurationDays, "", new { @class = "text-danger text-85 font-weight-bold d-block mt-1" })
    </div>

    <!-- 8. Hạn xử lý (Readonly) -->
    <div class="col-md-4 form-group">
        <label class="text-85 text-600 mb-1 d-block">Hạn xử lý</label>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text bgc-grey-l4"><i class="fa fa-calendar-check text-secondary"></i></span>
            </div>
            @Html.TextBoxFor(m => m.Deadline, "{0:dd/MM/yyyy}", new { @class = "form-control readonly-field", id = "Tracking_Deadline", @readonly = "readonly", placeholder = "Tự động tính" })
        </div>
    </div>
</div>

<!-- 9. Ngày hoàn thành: Hiển thị khi trạng thái = Hoàn thành (3) -->
<div class="row" id="groupCompletedDate" style="@(Model.Status == 3 ? "" : "display:none;")">
    <div class="col-md-6 form-group">
        <label class="text-85 text-600 mb-1 d-block">Ngày hoàn thành</label>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text bgc-success-l3 text-success"><i class="fa fa-check-circle"></i></span>
            </div>
            <input type="text" class="form-control readonly-field" id="Tracking_CompletedDate" name="CompletedDate" value="@(Model.CompletedDate.HasValue ? Model.CompletedDate.Value.ToString("dd/MM/yyyy") : (Model.Status == 3 ? DateTime.Now.ToString("dd/MM/yyyy") : ""))" readonly placeholder="Ngày hoàn thành" />
        </div>
        <small class="text-muted text-75">Tự động ghi nhận theo thời điểm cập nhật trạng thái Hoàn thành.</small>
    </div>
</div>

<!-- 10. Nội dung thực hiện * (CKEditor) -->
<div class="form-group">
    <label class="text-85 text-600 mb-1 d-block">
        Nội dung thực hiện <span class="text-danger">*</span>
    </label>
    @Html.TextAreaFor(m => m.ResultNote, 4, 50, new { @class = "form-control ckeditor", id = "Tracking_ResultNote", placeholder = "Nhập nội dung thực hiện tiến trình..." })
    @Html.ValidationMessageFor(m => m.ResultNote, "", new { @class = "text-danger text-85 font-weight-bold d-block mt-1" })
</div>

<!-- 11. Tệp đính kèm (Cho phép upload nhiều file) -->
<div class="form-group mb-0">
    <label class="text-85 text-600 mb-1 d-block">Tệp đính kèm</label>
    @if (!string.IsNullOrEmpty(Model.AttachmentFile))
    {
        if (Model.Status != 3)
        {
            var files = Model.AttachmentFile.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
            <div class="mb-2 d-flex flex-wrap" style="gap: 6px;">
                @foreach (var f in files)
                {
                    var trimmed = f.Trim();
                    var fname = System.IO.Path.GetFileName(trimmed);
                    <span class="badge badge-light-primary border-1 brc-primary-m3 text-primary-d2 px-2 py-1 radius-1 d-inline-flex align-items-center">
                        <i class="fa fa-paperclip mr-1"></i>
                        <a href="@Url.Action("DownloadAttachment", "DigitalSales", new { area = "Cate", filePath = trimmed })" target="_blank" class="text-primary-d2 mr-1">@fname</a>
                    </span>
                }
            </div>
        }
        <input type="hidden" name="AttachmentFile" value="@Model.AttachmentFile" />
    }
    <input type="file" name="attachmentFiles" multiple class="form-control-file border p-1 rounded" id="Tracking_AttachmentFiles" />
    <small class="text-muted text-75 mt-1 d-block">
        @(Model.Status == 3 ? "Tải lên tệp bổ sung (nếu có). Các tệp đã đính kèm trước đó vẫn được lưu trữ nguyên vẹn trong lịch sử tiến trình." : "Có thể chọn nhiều tệp (hỗ trợ ảnh, PDF, Word, Excel, Zip...)")
    </small>
</div>
