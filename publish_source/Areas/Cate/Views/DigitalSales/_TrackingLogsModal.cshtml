@using TSFramework.Libs.Processors
@model List<Core.Cate.Models.RM_DigitalSalesActivityModel>
@{
    var task = ViewBag.Task as Core.Cate.Models.RM_DigitalSalesTrackingModel;
    var logs = Model ?? new List<Core.Cate.Models.RM_DigitalSalesActivityModel>();
    string creatorName = task != null ? (!string.IsNullOrEmpty(task.CreatedByName) ? task.CreatedByName : (!string.IsNullOrEmpty(task.CreatedBy) ? task.CreatedBy : "Hệ thống")) : "—";
    string assigneeName = task != null ? (!string.IsNullOrEmpty(task.AssignedUserName) ? task.AssignedUserName : "Chưa phân công") : "—";
    string modifierName = task != null ? (!string.IsNullOrEmpty(task.LastModifiedByName) ? task.LastModifiedByName : (!string.IsNullOrEmpty(task.LastModifiedBy) ? task.LastModifiedBy : "—")) : "—";
}

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_TrackingLogsModal.css?v=@DateTime.Now.Ticks" />

<div class="modal fade" id="modalTrackingLogs" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg radius-2 overflow-hidden">
            <div class="modal-header bgc-primary-d1 text-white py-25 px-3">
                <h5 class="modal-title text-white mb-0 text-105 font-bold">
                    <i class="fa fa-history mr-1"></i> Log thao tác tiến trình
                </h5>
                <button type="button" class="close text-white opacity-2" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-3 bgc-grey-l5">
                @if (task != null)
                {
                    <!-- THẺ HỒ SƠ TỔNG QUAN TIẾN TRÌNH (PROFILE SUMMARY CARD) -->
                    <div class="card bcard border-1 brc-primary-m3 shadow-sm mb-3 radius-1 bgc-white">
                        <div class="card-header bgc-primary-l4 py-2 px-3 d-flex align-items-center justify-content-between flex-wrap" style="gap: 8px;">
                            <div class="d-flex align-items-center flex-wrap" style="gap: 6px;">
                                <span class="badge bgc-primary-l1 text-white font-bold px-2 py-1 radius-1 text-85">
                                    <i class="fa fa-barcode mr-1"></i>@task.TrackingCode
                                </span>
                                <span class="font-bolder text-dark text-110">@task.TaskName</span>
                            </div>
                            <span class="badge @(task.Status == 3 ? "badge-success" : (task.Status == 2 ? "badge-warning" : (task.Status == 4 ? "badge-danger" : "badge-secondary"))) font-bold px-25 py-1 text-85">
                                @(task.Status == 3 ? "Hoàn thành" : (task.Status == 2 ? "Đang làm" : (task.Status == 4 ? "Quá hạn" : "Chưa làm")))
                            </span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row text-90" style="row-gap: 8px;">
                                <div class="col-sm-6">
                                    <span class="text-secondary text-85 d-block"><i class="fa fa-user-check text-success mr-1"></i> Người thực hiện:</span>
                                    <span class="font-bold text-dark-m1 text-95">@assigneeName</span>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-secondary text-85 d-block"><i class="fa fa-user-plus text-primary mr-1"></i> Người tạo:</span>
                                    <span class="font-bold text-dark-m1 text-95">@creatorName</span>
                                    <span class="text-muted text-80 ml-1">(@(task.CreatedDate != DateTime.MinValue ? task.CreatedDate.ToString("dd/MM/yyyy HH:mm") : "—"))</span>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-secondary text-85 d-block"><i class="fa fa-calendar-alt text-warning-d2 mr-1"></i> Kế hoạch thời gian:</span>
                                    <span class="font-bold text-dark-m1">
                                        @task.StartDate.ToString("dd/MM/yyyy") - @(task.Deadline.HasValue ? task.Deadline.Value.ToString("dd/MM/yyyy") : task.MaxDeadline.ToString("dd/MM/yyyy"))
                                        <span class="badge badge-light-secondary border-1 ml-1 text-80">@task.EffectiveDurationDays ngày</span>
                                    </span>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-secondary text-85 d-block"><i class="fa fa-project-diagram text-purple mr-1"></i> Quy trình & Giai đoạn:</span>
                                    <span class="font-bold text-dark-m1">
                                        @(string.IsNullOrEmpty(task.ProcessName) ? "Quy trình thực hiện" : task.ProcessName)
                                        @if (!string.IsNullOrEmpty(task.SalesStatusName))
                                        {
                                            <span class="text-secondary font-normal">(@task.SalesStatusName)</span>
                                        }
                                    </span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(task.LastModifiedBy))
                            {
                                <div class="text-85 text-secondary mt-2 pt-2 border-t-1 brc-grey-l3 d-flex align-items-center flex-wrap" style="gap: 4px;">
                                    <i class="fa fa-edit text-info mr-1"></i>
                                    <span>Cập nhật gần nhất bởi: <strong class="text-dark">@modifierName</strong></span>
                                    @if (task.LastModifiedDate.HasValue)
                                    {
                                        <span class="text-muted">lúc @task.LastModifiedDate.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(task.ResultNote))
                            {
                                <div class="mt-25 p-2 bgc-grey-l4 border-1 brc-grey-l2 radius-1 text-90">
                                    <div class="font-bold text-secondary-d2 mb-1">
                                        <i class="fa fa-clipboard-check text-success mr-1"></i> Báo cáo / Nội dung kết quả:
                                    </div>
                                    <div class="text-dark">
                                        @Html.Raw(task.ResultNote)
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(task.AttachmentFile))
                            {
                                var attachFiles = task.AttachmentFile.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries);
                                if (attachFiles.Length > 0)
                                {
                                    <div class="mt-2 pt-2 border-t-1 brc-grey-l3">
                                        <div class="text-80 font-bold text-secondary mb-1">
                                            <i class="fa fa-paperclip mr-1"></i> Tệp đính kèm tiến trình (@attachFiles.Length):
                                        </div>
                                        <div class="d-flex flex-wrap" style="gap: 6px;">
                                            @foreach (var f in attachFiles)
                                            {
                                                var trimmed = f.Trim();
                                                var fname = System.IO.Path.GetFileName(trimmed);
                                                <a href="@Url.Action("DownloadAttachment", "DigitalSales", new { area = "Cate", filePath = trimmed })" target="_blank" class="badge badge-light-primary border-1 brc-primary-m3 text-primary-d2 px-2 py-1 radius-1 text-80">
                                                    <i class="fa fa-paperclip mr-1"></i>@fname
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            }

                            @if (task.TodoList != null && task.TodoList.Count > 0)
                            {
                                var doneCount = task.TodoList.Count(c => c.Status == 3);
                                var totalChild = task.TodoList.Count;
                                <div class="mt-2 pt-2 border-t-1 brc-grey-l3 text-90">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="font-bold text-secondary-d2">
                                            <i class="fa fa-tasks text-primary mr-1"></i> Công việc con trong tiến trình (@doneCount/@totalChild hoàn thành):
                                        </span>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm mb-0 bgc-white text-85">
                                            <thead class="bgc-grey-l4 text-secondary">
                                                <tr>
                                                    <th class="text-center" style="width: 130px;">Mã</th>
                                                    <th>Tên công việc</th>
                                                    <th>Người thực hiện</th>
                                                    <th class="text-center" style="width: 100px;">Hạn chót</th>
                                                    <th class="text-center" style="width: 100px;">Trạng thái</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var c in task.TodoList)
                                                {
                                                    <tr>
                                                        <td class="text-center"><span class="text-secondary font-bold">@c.TrackingCode</span></td>
                                                        <td><span class="@(c.Status == 3 ? "text-success font-bold" : "text-dark")">@c.TaskName</span></td>
                                                        <td>@(string.IsNullOrEmpty(c.AssignedUserName) ? "—" : c.AssignedUserName)</td>
                                                        <td class="text-center">@(c.Deadline.HasValue ? c.Deadline.Value.ToString("dd/MM/yyyy") : "—")</td>
                                                        <td class="text-center">
                                                            @if (c.Status == 3)
                                                            {
                                                                <span class="badge badge-success text-75 px-15">Hoàn thành</span>
                                                            }
                                                            else if (c.Status == 2)
                                                            {
                                                                <span class="badge badge-warning text-75 px-15">Đang làm</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-secondary text-75 px-15">Chưa làm</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- TIÊU ĐỀ PHẦN NHẬT KÝ LỊCH SỬ THAO TÁC -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="text-secondary-d2 font-bold mb-0 text-95">
                        <i class="fa fa-stream mr-1 text-primary"></i> Nhật ký chi tiết các mốc thao tác (@(logs.Count + (task != null ? 1 : 0)) sự kiện)
                    </h6>
                </div>

                <div class="tracking-log-timeline">
                    <!-- SỰ KIỆN CỘT MỐC 1: KHỞI TẠO TIẾN TRÌNH -->
                    @if (task != null)
                    {
                        <div class="tracking-log-item">
                            <div class="tracking-log-dot bgc-primary-d1"></div>
                            <div class="tracking-log-card bgc-white border-1 brc-grey-l2 shadow-sm radius-1 p-3">
                                <div class="d-flex align-items-center justify-content-between flex-wrap mb-1" style="gap: 6px;">
                                    <div class="d-flex align-items-center">
                                        <span class="font-weight-bold text-primary-d2 mr-2 text-90">
                                            <i class="fa fa-user-circle mr-1"></i>@creatorName
                                        </span>
                                        <span class="badge badge-light-primary border-1 brc-primary-m3 text-75">
                                            @(task.ParentID.HasValue && task.ParentID.Value > 0 ? "Khởi tạo công việc con" : "Khởi tạo tiến trình")
                                        </span>
                                    </div>
                                    <span class="text-muted text-80">
                                        <i class="far fa-clock mr-1"></i>@(task.CreatedDate != DateTime.MinValue ? task.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss") : "Ban đầu")
                                    </span>
                                </div>
                                <div class="text-dark text-90 log-content">
                                    <div>Khởi tạo <b>@task.TaskName</b> trong quy trình <i>@(string.IsNullOrEmpty(task.ProcessName) ? "Quy trình thực hiện" : task.ProcessName)</i>.</div>
                                    <div class="text-secondary mt-1 text-85">
                                        <i class="fa fa-user-check text-success mr-1"></i>Phân công người thực hiện: <b>@assigneeName</b>
                                        <span class="mx-1">•</span>
                                        <i class="far fa-calendar-alt text-warning-d2 mr-1"></i>Kế hoạch: @task.StartDate.ToString("dd/MM/yyyy") đến @(task.Deadline.HasValue ? task.Deadline.Value.ToString("dd/MM/yyyy") : task.MaxDeadline.ToString("dd/MM/yyyy")) (@task.EffectiveDurationDays ngày)
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- CÁC SỰ KIỆN TIẾP THEO TRONG BẢNG LOGS -->
                    @if (logs.Count > 0)
                    {
                        foreach (var log in logs)
                        {
                            bool isChildLog = task != null && log.ReferenceID.HasValue && log.ReferenceID.Value != task.TrackingID;
                            <div class="tracking-log-item">
                                <div class="tracking-log-dot @(isChildLog ? "bgc-warning-d1" : "bgc-info-d1")"></div>
                                <div class="tracking-log-card bgc-white border-1 brc-grey-l2 shadow-sm radius-1 p-3">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap mb-1" style="gap: 6px;">
                                        <div class="d-flex align-items-center flex-wrap" style="gap: 4px;">
                                            <span class="font-weight-bold text-primary-d1 mr-1 text-90">
                                                <i class="fa fa-user-circle mr-1"></i>@(string.IsNullOrEmpty(log.ActionByName) ? log.ActionBy : log.ActionByName)
                                            </span>
                                            @if (isChildLog)
                                            {
                                                <span class="badge badge-light-warning border-1 brc-warning-m2 text-warning-d3 text-75">
                                                    <i class="fa fa-tasks mr-1"></i>Công việc con
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(log.ActionByDepartment))
                                            {
                                                <span class="badge badge-light-secondary text-75">@log.ActionByDepartment</span>
                                            }
                                        </div>
                                        <span class="text-muted text-80">
                                            <i class="far fa-clock mr-1"></i>@log.ActionDate.ToString("dd/MM/yyyy HH:mm:ss")
                                        </span>
                                    </div>
                                    <div class="text-dark text-90 log-content">
                                        @Html.Raw(log.Content)
                                    </div>
                                    @if (log.AttachmentList != null && log.AttachmentList.Count > 0)
                                    {
                                        <div class="mt-2 pt-2 border-t-1 brc-grey-l3">
                                            <div class="text-75 font-weight-bold text-secondary mb-1">
                                                <i class="fa fa-paperclip mr-1"></i> Tệp đính kèm (@log.AttachmentList.Count):
                                            </div>
                                            <div class="d-flex flex-wrap" style="gap: 6px;">
                                                @foreach (var att in log.AttachmentList)
                                                {
                                                    <a href="@Url.Action("DownloadAttachment", "DigitalSales", new { area = "Cate", filePath = att.FilePath })" target="_blank" class="badge badge-light-info border-1 brc-info-m3 text-info-d2 px-2 py-1 radius-1 text-80">
                                                        <i class="fa @(att.IsImage ? "fa-image" : "fa-file") mr-1"></i>@att.FileName
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer bgc-white py-2 px-3">
                <button type="button" class="btn btn-sm btn-secondary px-3 radius-1 font-bold" data-dismiss="modal">
                    <i class="fa fa-times mr-1"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</div>
