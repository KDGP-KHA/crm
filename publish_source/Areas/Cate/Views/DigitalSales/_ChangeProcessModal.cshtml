@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesChangeProcessViewModel

<div class="modal fade" id="changeProcessModal" tabindex="-1" role="dialog" aria-labelledby="changeProcessModalTitle" aria-hidden="true" data_width="650">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 radius-2 shadow-lg">
            <div class="modal-header bgc-primary-d1 text-white px-3 py-25">
                <h5 class="modal-title font-bold text-110" id="changeProcessModalTitle">
                    <i class="fa fa-sync-alt mr-1"></i> @AppProcessor.Messagor.GetMessage("DigitalSalesTracking_ChangeProcess_Title") - <span class="text-warning-l3">@Model.StatusName</span>
                </h5>
                <button type="button" class="close text-white opacity-2 text-130" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="frmChangeProcess" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.DigitalSalesID, new { id = "ChangeProcess_DigitalSalesID" })
                @Html.HiddenFor(m => m.StatusID, new { id = "ChangeProcess_StatusID" })

                <div class="modal-body p-3 p-md-4">
                    <div class="alert alert-info border-0 radius-1 shadow-none mb-3 text-95">
                        <i class="fa fa-info-circle mr-1 text-primary-m1"></i>
                        Tráº¡ng thÃ¡i <strong>@Model.StatusName</strong> cÃ³ <strong>@(Model.AvailableProcesses?.Count ?? 0) quy trÃ¬nh</strong> kháº£ dá»¥ng. HÃ£y chá»n quy trÃ¬nh phÃ¹ há»£p Ä‘á»ƒ Ã¡p dá»¥ng cho há»“ sÆ¡ nÃ y:
                    </div>

                    <div class="form-group mb-0">
                        <label class="font-bolder text-secondary-d2 mb-2">
                            @AppProcessor.Messagor.GetMessage("DigitalSalesTracking_SelectProcess_Label") <span class="text-danger">*</span>
                        </label>
                        <div class="list-group radius-1" id="listProcessRadioGroup">
                            @if (Model.AvailableProcesses != null && Model.AvailableProcesses.Count > 0)
                            {
                                foreach (var proc in Model.AvailableProcesses)
                                {
                                    bool isSelected = proc.ProcessID == Model.CurrentProcessID;
                                    <label class="list-group-item list-group-item-action d-flex align-items-center cursor-pointer mb-2 border-1 radius-1 p-3 @(isSelected ? "bgc-blue-l4 border-primary" : "")" style="transition: all 0.2s ease;">
                                        <div class="custom-control custom-radio mr-3">
                                            <input type="radio" id="proc_radio_@proc.ProcessID" name="SelectedProcessID" value="@proc.ProcessID" class="custom-control-input" @(isSelected ? "checked" : "") />
                                            <span class="custom-control-label font-bold text-dark text-100"></span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="font-bolder text-primary-d1 text-105">@proc.ProcessName</span>
                                                <span class="badge badge-light-primary border-1 text-80 font-bold px-2 py-1 radius-1">
                                                    MÃ£: @proc.ProcessCode
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(proc.Description))
                                            {
                                                <p class="text-secondary-m1 text-85 mb-0 mt-1">@proc.Description</p>
                                            }
                                        </div>
                                    </label>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0 radius-1">
                                    <i class="fa fa-exclamation-triangle mr-1"></i> ChÆ°a cÃ³ quy trÃ¬nh nÃ o kháº£ dá»¥ng cho tráº¡ng thÃ¡i nÃ y.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="modal-footer bgc-secondary-l4 border-t-1 brc-grey-l2 px-3 py-2">
                    <button type="button" class="btn btn-sm btn-white border-1 brc-grey-l1 text-secondary-d2 px-3 radius-1 shadow-sm font-bold" data-dismiss="modal">
                        <i class="fa fa-times mr-1"></i> @AppProcessor.Messagor.GetMessage("Button_Close")
                    </button>
                    <button type="button" class="btn btn-sm btn-primary px-4 radius-1 shadow-sm font-bold" id="btnSaveChangeProcess" onclick="submitChangeProcess();">
                        <i class="fa fa-save mr-1"></i> @AppProcessor.Messagor.GetMessage("Button_Select") & Cáº­p nháº­t
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>