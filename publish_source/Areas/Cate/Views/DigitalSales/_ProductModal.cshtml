@model Core.Cate.Models.RM_DigitalSalesProductModel
@using TSFramework.Libs.Processors

<div class="modal fade" id="modalProduct" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 680px;" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <!-- Modal Header -->
            <div class="modal-header py-3 px-4" style="background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%); border-bottom: none;">
                <h5 class="modal-title text-white font-bold mb-0" style="font-size: 1.1rem; display: flex; align-items: center;">
                    <span class="d-inline-flex align-items-center justify-content-center mr-2 rounded-circle" style="width: 32px; height: 32px; background: rgba(255,255,255,0.2);">
                        <i class="fa fa-cubes text-white" style="font-size: 15px;"></i>
                    </span>
                    @(Model.SalesProductID > 0 ? "Cập nhật Sản phẩm / Dịch vụ số" : "Thêm mới Sản phẩm / Dịch vụ số")
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="opacity: 0.85; text-shadow: none; font-size: 1.4rem;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="frmProductModal" method="post" action="/Cate/DigitalSales/SaveProduct" novalidate="novalidate">
                <div class="modal-body px-4 py-3 bgc-grey-l5">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.SalesProductID)
                    @Html.HiddenFor(m => m.DigitalSalesID)

                    <!-- Card 1: Thông tin Sản phẩm & Quy mô -->
                    <div class="bg-white p-3 mb-3 border-1 brc-grey-l2 radius-2 shadow-sm">
                        <div class="d-flex align-items-center mb-3 pb-2 border-b-1 brc-grey-l3">
                            <i class="fa fa-layer-group text-primary mr-2"></i>
                            <span class="font-bold text-dark text-90 text-uppercase tracking-wider">Thông tin sản phẩm & quy mô</span>
                        </div>

                        <!-- Sản phẩm / Dịch vụ số (*) -->
                        <div class="form-group mb-3">
                            <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="ProductServiceID">
                                @AppProcessor.Messagor.GetMessage("DigitalSalesProduct_ProductService_Label") <span class="text-danger font-bold">*</span>
                            </label>
                            @Html.DropDownListFor(m => m.ProductServiceID, (List<SelectListItem>)ViewBag.ProductList, AppProcessor.Messagor.GetMessage("DigitalSalesProduct_ProductService_Option"), new { @class = "form-control select2", id = "cboProductServiceID" })
                            @Html.ValidationMessageFor(m => m.ProductServiceID, "", new { @class = "text-danger text-85 font-weight-bold d-block mt-1" })
                        </div>

                        <!-- Gói cước & Số lượng -->
                        <div class="row">
                            <div class="col-md-8 mb-2">
                                <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="PackageName">
                                    <i class="fa fa-box-open text-secondary mr-1"></i> @AppProcessor.Messagor.GetMessage("DigitalSalesProduct_PackageName_Label")
                                </label>
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.PackageName, new { @class = "form-control form-control-sm", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesProduct_PackageName_Placeholder") })
                                </div>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="Quantity">
                                    <i class="fa fa-sort-numeric-up text-secondary mr-1"></i> @AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Quantity_Label") <span class="text-danger font-bold">*</span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <div class="input-group-prepend">
                                        <button type="button" class="btn btn-outline-secondary px-2" id="btnDecreaseQty"><i class="fa fa-minus text-75"></i></button>
                                    </div>
                                    @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control form-control-sm text-center font-bold text-primary", type = "number", min = "1", id = "prodQtyInput" })
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-secondary px-2" id="btnIncreaseQty"><i class="fa fa-plus text-75"></i></button>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger text-85 font-weight-bold d-block mt-1" })
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Doanh thu & Kế hoạch thời hạn -->
                    <div class="bg-white p-3 mb-3 border-1 brc-grey-l2 radius-2 shadow-sm">
                        <div class="d-flex align-items-center mb-3 pb-2 border-b-1 brc-grey-l3">
                            <i class="fa fa-chart-line text-success mr-2"></i>
                            <span class="font-bold text-dark text-90 text-uppercase tracking-wider">Doanh thu & Kế hoạch thời hạn</span>
                        </div>

                        <!-- Hàng Doanh thu: CÂN BẰNG HOÀN TOÀN -->
                        <div class="row mb-3">
                            <div class="col-md-6 mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1" style="min-height: 24px;">
                                    <label class="font-bold text-secondary-d2 mb-0 text-90" for="ExpectedRevenue_Display">
                                        <i class="fa fa-chart-line text-primary mr-1"></i> Doanh thu dự kiến
                                    </label>
                                    <span class="badge badge-light-primary text-75 px-15 py-05 font-600">Kế hoạch</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="ExpectedRevenue_Display" class="form-control form-control-sm text-right font-bold text-primary-d1 money-input"
                                           value="@(Model.ExpectedRevenue.HasValue && Model.ExpectedRevenue.Value > 0 ? Model.ExpectedRevenue.Value.ToString("N0") : "0")"
                                           placeholder="0" autocomplete="off" />
                                    <input type="hidden" id="ExpectedRevenue" name="ExpectedRevenue" value="@(Model.ExpectedRevenue ?? 0)" />
                                    <div class="input-group-append">
                                        <span class="input-group-text bgc-grey-l4 text-600 text-80">VNĐ</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1" style="min-height: 24px;">
                                    <label class="font-bold text-secondary-d2 mb-0 text-90" for="ActualRevenue_Display">
                                        <i class="fa fa-file-invoice-dollar text-success mr-1"></i> Doanh thu thực tế
                                    </label>
                                    <span class="badge badge-light-success text-75 px-15 py-05 font-600">Sau ký HĐ</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="ActualRevenue_Display" class="form-control form-control-sm text-right font-bold text-success-d1 money-input"
                                           value="@(Model.ActualRevenue.HasValue && Model.ActualRevenue.Value > 0 ? Model.ActualRevenue.Value.ToString("N0") : "0")"
                                           placeholder="0" autocomplete="off" />
                                    <input type="hidden" id="ActualRevenue" name="ActualRevenue" value="@(Model.ActualRevenue ?? 0)" />
                                    <div class="input-group-append">
                                        <span class="input-group-text bgc-grey-l4 text-600 text-80">VNĐ</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Hàng Thời hạn bắt đầu & Thời hạn kết thúc -->
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <div class="d-flex align-items-center mb-1" style="min-height: 24px;">
                                    <label class="font-bold text-secondary-d2 mb-0 text-90" for="ProdStartDate">
                                        <i class="fa fa-calendar-alt text-info mr-1"></i> @AppProcessor.Messagor.GetMessage("DigitalSalesProduct_StartDate_Label")
                                    </label>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="ProdStartDate" name="StartDate" class="form-control form-control-sm date-picker"
                                           value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "")"
                                           placeholder="dd/MM/yyyy" autocomplete="off" />
                                    <div class="input-group-append">
                                        <span class="input-group-text bgc-white text-secondary-m1"><i class="fa fa-calendar-alt"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <div class="d-flex align-items-center mb-1" style="min-height: 24px;">
                                    <label class="font-bold text-secondary-d2 mb-0 text-90" for="ProdEndDate">
                                        <i class="fa fa-calendar-check text-info mr-1"></i> @AppProcessor.Messagor.GetMessage("DigitalSalesProduct_EndDate_Label")
                                    </label>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="ProdEndDate" name="EndDate" class="form-control form-control-sm date-picker"
                                           value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd/MM/yyyy") : "")"
                                           placeholder="dd/MM/yyyy" autocomplete="off" />
                                    <div class="input-group-append">
                                        <span class="input-group-text bgc-white text-secondary-m1"><i class="fa fa-calendar-check"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 3: Ghi chú -->
                    <div class="bg-white p-3 border-1 brc-grey-l2 radius-2 shadow-sm">
                        <label class="font-bold text-secondary-d2 mb-1 d-block text-90" for="Note">
                            <i class="fa fa-sticky-note text-secondary mr-1"></i> @AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Note_Label")
                        </label>
                        @Html.TextAreaFor(m => m.Note, 2, 50, new { @class = "form-control form-control-sm", placeholder = "Ghi chú điều kiện triển khai, quy mô người dùng hoặc thỏa thuận gói cước..." })
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer py-2 px-4 bgc-grey-l4 border-t-1 brc-grey-l2 d-flex justify-content-between align-items-center">
                    <div class="text-muted text-85">
                        <i class="fa fa-info-circle mr-1 text-primary"></i> <span class="text-danger font-bold">*</span> Thông tin bắt buộc
                    </div>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3 radius-round mr-1" data-dismiss="modal">
                            <i class="fa fa-times mr-1"></i> Hủy
                        </button>
                        <button type="submit" class="btn btn-sm btn-primary px-4 radius-round font-bold shadow-sm">
                            <i class="fa fa-save mr-1"></i> Lưu sản phẩm
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_ProductModal.css?v=@DateTime.Now.Ticks" />

<script>
    (function () {
        var $modal = $("#modalProduct");

        // 1. Khởi tạo DatePicker
        if ($.fn.datepicker) {
            $modal.find(".date-picker").datepicker({
                format: "dd/mm/yyyy",
                autoclose: true,
                todayHighlight: true
            });
        }

        // 2. Nút tăng giảm số lượng
        $modal.find("#btnDecreaseQty").off("click").on("click", function () {
            var $input = $modal.find("#prodQtyInput");
            var val = parseInt($input.val(), 10) || 1;
            if (val > 1) {
                $input.val(val - 1).trigger("change");
            }
        });
        $modal.find("#btnIncreaseQty").off("click").on("click", function () {
            var $input = $modal.find("#prodQtyInput");
            var val = parseInt($input.val(), 10) || 0;
            $input.val(val + 1).trigger("change");
        });

        // 3. Format tiền tệ trực tiếp khi gõ
        function formatMoneyInput($display, $hidden) {
            $display.off("input.money").on("input.money", function () {
                var raw = $(this).val().replace(/[^0-9]/g, "");
                if (raw === "") {
                    $hidden.val(0);
                    $(this).val("");
                    return;
                }
                var num = parseInt(raw, 10);
                $hidden.val(num);
                $(this).val(num.toLocaleString("en-US"));
            });
            $display.off("blur.money").on("blur.money", function () {
                var raw = $(this).val().replace(/[^0-9]/g, "");
                if (raw === "") {
                    $hidden.val(0);
                    $(this).val("0");
                }
            });
        }

        formatMoneyInput($modal.find("#ExpectedRevenue_Display"), $modal.find("#ExpectedRevenue"));
        formatMoneyInput($modal.find("#ActualRevenue_Display"), $modal.find("#ActualRevenue"));

        // 4. Xử lý Unobtrusive Validation và submit form AJAX an toàn
        var $form = $("#frmProductModal");
        if ($.validator && $.validator.unobtrusive) {
            $.validator.unobtrusive.parse($form);
        }

        $form.find("#cboProductServiceID").on("change", function () {
            if ($(this).val() && $(this).val() !== "0") {
                var $valMsg = $form.find("[data-valmsg-for='ProductServiceID']");
                $valMsg.empty().removeClass("field-validation-error").addClass("field-validation-valid");
                $(this).removeClass("input-validation-error border-danger");
            }
        });

        $form.find("#prodQtyInput").on("input propertychange", function () {
            var val = parseInt($(this).val(), 10);
            if (val && val > 0) {
                var $valMsg = $form.find("[data-valmsg-for='Quantity']");
                $valMsg.empty().removeClass("field-validation-error").addClass("field-validation-valid");
                $(this).removeClass("input-validation-error border-danger");
            }
        });

        $form.off("submit").on("submit", function (e) {
            e.preventDefault();

            if (typeof $form.valid === "function" && !$form.valid()) {
                return false;
            }

            var prodId = $form.find("[name='ProductServiceID']").val();
            if (!prodId || prodId === "" || prodId === "0") {
                var msgRequired = "@Html.Raw(AppProcessor.Messagor.GetMessage("DigitalSales_Msg_ProductRequired"))" || "Vui lòng chọn sản phẩm / dịch vụ số!";
                var $valMsg = $form.find("[data-valmsg-for='ProductServiceID']");
                $valMsg.html('<span id="ProductServiceID-error">' + msgRequired + '</span>')
                       .removeClass("field-validation-valid")
                       .addClass("field-validation-error text-danger text-85 font-weight-bold d-block mt-1");
                $form.find("#cboProductServiceID").addClass("input-validation-error border-danger");
                return false;
            }

            var qtyVal = parseInt($form.find("#prodQtyInput").val(), 10);
            if (!qtyVal || qtyVal < 1) {
                var $valMsgQty = $form.find("[data-valmsg-for='Quantity']");
                $valMsgQty.html('<span id="Quantity-error">Số lượng tối thiểu là 1</span>')
                          .removeClass("field-validation-valid")
                          .addClass("field-validation-error text-danger text-85 font-weight-bold d-block mt-1");
                $form.find("#prodQtyInput").addClass("input-validation-error border-danger").focus();
                return false;
            }

            var $btn = $form.find("button[type='submit']");
            var origHtml = $btn.html();
            $btn.prop("disabled", true).html("<i class='fa fa-spinner fa-spin mr-1'></i> Đang lưu...");

            $.ajax({
                url: $form.attr("action") || "/Cate/DigitalSales/SaveProduct",
                type: "POST",
                data: $form.serialize(),
                success: function (res) {
                    $btn.prop("disabled", false).html(origHtml);
                    if (res && res.status) {
                        $modal.modal("hide");
                        $(".modal-backdrop").remove();
                        $("body").removeClass("modal-open").css("padding-right", "");
                        if (typeof toastr !== "undefined") {
                            toastr.success(res.message || "Lưu sản phẩm thành công!");
                        }
                        if (typeof reloadProductsSection === "function") {
                            reloadProductsSection(@Model.DigitalSalesID);
                        } else {
                            setTimeout(function () { location.reload(); }, 600);
                        }
                    } else {
                        var errMsg = (res && res.message) ? res.message : "Không thể lưu sản phẩm!";
                        if (typeof toastr !== "undefined") {
                            toastr.error(errMsg);
                        } else {
                            alert(errMsg);
                        }
                    }
                },
                error: function () {
                    $btn.prop("disabled", false).html(origHtml);
                    if (typeof toastr !== "undefined") {
                        toastr.error("Có lỗi xảy ra khi kết nối máy chủ!");
                    } else {
                        alert("Có lỗi xảy ra khi kết nối máy chủ!");
                    }
                }
            });

            return false;
        });
    })();
</script>
