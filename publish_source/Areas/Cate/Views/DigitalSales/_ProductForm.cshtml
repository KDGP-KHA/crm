@using System
@using System.Collections.Generic
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using TSFramework.Libs.Extensions
@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesProductModel
@{
    var productList = ViewBag.ProductList as List<SelectListItem> ?? new List<SelectListItem>();
    var costTypes = ViewBag.CostTypes as List<SelectListItem> ?? new List<SelectListItem>();
    var costs = Model.Costs ?? new List<Core.Cate.Models.RM_DigitalSalesProductCostModel>();
    var revenues = Model.Revenues ?? new List<Core.Cate.Models.RM_DigitalSalesProductRevenueModel>();
    var costTokens = ViewBag.ProductCostTokens as List<string> ?? new List<string>();
    var revenueTokens = ViewBag.ProductRevenueTokens as List<string> ?? new List<string>();
}

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.SalesProductID)
@Html.HiddenFor(model => model.DigitalSalesID)

