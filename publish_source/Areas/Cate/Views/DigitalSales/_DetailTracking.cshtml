@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesModel
@{
    bool canEdit = ViewBag.CanEdit == true;
    var allTasks = Model.TrackingTasks ?? new List<Core.Cate.Models.RM_DigitalSalesTrackingModel>();
    var parentTasks = allTasks.Where(t => !t.ParentID.HasValue || t.ParentID.Value <= 0).ToList();
    var allTodoTasks = allTasks.Where(t => t.ParentID.HasValue && t.ParentID.Value > 0).ToList();
    
    // Tính tổng số lượng và hoàn thành (chỉ tính theo các công việc thực tế, loại trừ placeholder rỗng)
    int totalCount = allTasks.Count(t => !string.IsNullOrWhiteSpace(t.TaskName));
    int completedCount = allTasks.Count(t => !string.IsNullOrWhiteSpace(t.TaskName) && t.Status == 3);
}

<span id="partialTrackingProgress" class="d-none" data-completed="@completedCount" data-total="@totalCount"></span>

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_DetailTracking.css?v=@DateTime.Now.Ticks" />

<!-- HEADER CỦA TAB CHECKLIST -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap: 10px;">
    <div class="d-flex align-items-center">
        <h6 class="text-orange font-weight-bold mb-0 text-110">
            <i class="fa fa-tasks mr-1"></i> Checklist
        </h6>
        <span class="badge badge-pill badge-warning ml-2 font-bold px-2 py-1" id="badgeChecklistSummary">@completedCount/@totalCount</span>
    </div>
    <div class="d-flex align-items-center flex-wrap" style="gap: 6px;">
        <button type="button" class="btn btn-xs btn-white border-1 brc-grey-l1 text-secondary-d1 radius-1 px-2 py-1 shadow-sm font-bold" id="btnExpandAllChecklist" onclick="toggleAllChecklistTree(true);">
            <i class="fa fa-expand-alt mr-1 text-primary"></i> Mở rộng tất cả
        </button>
        <button type="button" class="btn btn-xs btn-white border-1 brc-grey-l1 text-secondary-d1 radius-1 px-2 py-1 shadow-sm font-bold" id="btnCollapseAllChecklist" onclick="toggleAllChecklistTree(false);">
            <i class="fa fa-compress-alt mr-1 text-orange"></i> Thu gọn tất cả
        </button>
        @if (canEdit)
        {
            <button type="button" class="btn btn-sm btn-orange px-3 radius-1 shadow-sm font-bold ml-1" onclick="openAddTrackingModal(@Model.DigitalSalesID);">
                <i class="fa fa-plus mr-1"></i> Thêm công việc tùy biến
            </button>
        }
    </div>
</div>

<!-- BẢNG TREE GRID PHÂN CẤP 4 TẦNG: TRẠNG THÁI -> QUY TRÌNH -> TIẾN TRÌNH -> TODO LIST -->
<div class="table-responsive">
    <table class="table table-bordered text-90 tree-table" id="tblTracking">
        <thead class="bgc-secondary-l1 text-secondary-d2">
            <tr>
                <th style="min-width: 400px;">Tên công việc / Đầu mục tiến trình</th>
                <th style="width: 130px;" class="text-center">Mã tiến trình</th>
                <th style="width: 150px;">Người thực hiện</th>
                <th style="width: 105px;" class="text-center">Bắt đầu</th>
                <th style="width: 115px;" class="text-center">Hạn chót</th>
                <th style="width: 95px;" class="text-center">Tổng ngày</th>
                <th style="width: 115px;" class="text-center">Trạng thái</th>
                <th style="width: 100px;">Kết quả / File</th>
                @if (canEdit)
                {
                    <th style="width: 80px;" class="text-center">Thao tác</th>
                }
            </tr>
        </thead>
        <tbody id="treeTrackingBody">
            @if (parentTasks != null && parentTasks.Count > 0)
            {
                var statusGroups = parentTasks.GroupBy(t => new
                {
                    StatusID = t.StatusID ?? 0,
                    StatusName = !string.IsNullOrEmpty(t.SalesStatusName) ? t.SalesStatusName : "Trạng thái",
                    ProcessCountOfStatus = t.ProcessCountOfStatus
                }).OrderBy(g => g.Key.StatusID).ToList();

                int statusIdx = 1;
                foreach (var stGroup in statusGroups)
                {
                    string statusNodeId = "status_node_" + stGroup.Key.StatusID;
                    int statusTaskCount = stGroup.Count(t => !string.IsNullOrWhiteSpace(t.TaskName));
                    int statusTodoCount = stGroup.Where(t => !string.IsNullOrWhiteSpace(t.TaskName)).Sum(p => p.TodoList?.Count ?? 0);

                    <!-- ========================================================================= -->
                    <!-- CẤP 1: TRẠNG THÁI (BOLD ĐẬM, FONT CHỮ TO)                                 -->
                    <!-- ========================================================================= -->
                    <tr class="tree-row tree-status-row" data-node="@statusNodeId" data-level="1" data-expanded="true">
                        <td colspan="@(canEdit ? 9 : 8)" class="cursor-pointer py-25 px-3" onclick="toggleTreeNode('@statusNodeId');">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-chevron-down tree-toggle-icon text-primary mr-2" id="icon_@statusNodeId"></i>
                                    <span class="tree-status-title">@stGroup.Key.StatusName</span>
                                    <span class="badge badge-primary badge-pill ml-2 text-80 font-bold">@statusTaskCount tiến trình@(statusTodoCount > 0 ? $", {statusTodoCount} việc nhỏ" : "")</span>
                                </div>
                                <span class="text-secondary-m1 text-80 font-italic mr-2">
                                    <i class="fa fa-info-circle mr-1"></i>Bấm để thu gọn/mở rộng
                                </span>
                            </div>
                        </td>
                    </tr>

                    var procGroups = stGroup.GroupBy(t => new
                    {
                        ProcessID = t.ProcessID ?? 0,
                        ProcessName = !string.IsNullOrEmpty(t.ProcessName) ? t.ProcessName : "Quy trình thực hiện"
                    }).OrderBy(g => g.Key.ProcessID).ToList();

                    int procIdx = 1;
                    foreach (var prGroup in procGroups)
                    {
                        string procNodeId = $"{statusNodeId}_proc_{prGroup.Key.ProcessID}";
                        var realTasks = prGroup.Where(t => !string.IsNullOrWhiteSpace(t.TaskName)).ToList();
                        int realTaskCount = realTasks.Count;

                        <!-- ========================================================================= -->
                        <!-- CẤP 2: QUY TRÌNH (TIÊU ĐỀ: QUY TRÌNH ... CÓ CÂY BÚT CHÌ NẾU SỐ QT >= 2)  -->
                        <!-- ========================================================================= -->
                        <tr class="tree-row tree-process-row" data-node="@procNodeId" data-parent="@statusNodeId" data-level="2" data-expanded="true">
                            <td colspan="@(canEdit ? 9 : 8)" class="cursor-pointer py-2 px-4" onclick="toggleTreeNode('@procNodeId');">
                                <div class="d-flex align-items-center justify-content-between flex-wrap" style="gap: 6px;">
                                    <div class="d-flex align-items-center flex-wrap" style="gap: 6px;">
                                        <i class="fa fa-chevron-down tree-toggle-icon text-warning-d2 mr-1" id="icon_@procNodeId"></i>
                                        <span class="tree-process-title">QUY TRÌNH: @(prGroup.Key.ProcessName.ToUpper())</span>
                                        @if (stGroup.Key.ProcessCountOfStatus >= 2 && canEdit)
                                        {
                                            <a href="javascript:void(0);" class="btn-edit-process" onclick="event.stopPropagation(); openChangeProcessModal(@Model.DigitalSalesID, @stGroup.Key.StatusID, @prGroup.Key.ProcessID);" title="Đổi quy trình thực hiện cho trạng thái này (@stGroup.Key.ProcessCountOfStatus quy trình)">
                                                <i class="fa fa-pencil-alt"></i>
                                            </a>
                                        }
                                        <span class="badge @(realTaskCount > 0 ? "badge-light-warning text-warning-d3" : "badge-light-secondary text-secondary-d3") border-1 text-75 font-bold">
                                            @realTaskCount tiến trình
                                        </span>
                                        @if (canEdit && prGroup.Key.ProcessID > 0)
                                        {
                                            <button type="button" class="btn btn-xs btn-success font-weight-bold px-2 py-05 ml-1 radius-1 shadow-sm btn-add-progress-header" onclick="event.stopPropagation(); openAddProgressToProcessModal(@Model.DigitalSalesID, @prGroup.Key.ProcessID, '@Html.Raw(HttpUtility.JavaScriptStringEncode(prGroup.Key.ProcessName))');" title="Thêm tiến trình mới vào quy trình này">
                                                <i class="fa fa-plus mr-1"></i> Thêm tiến trình
                                            </button>
                                        }
                                    </div>
                                    @if (stGroup.Key.ProcessCountOfStatus >= 2)
                                    {
                                        <span class="badge badge-light-secondary text-secondary-d3 border-1 text-75">
                                            <i class="fa fa-exchange-alt mr-1"></i>Có thể đổi quy trình
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>

                        @if (realTaskCount == 0)
                        {
                            <!-- DÒNG THÔNG BÁO KHI QUY TRÌNH CHƯA CÓ TIẾN TRÌNH NÀO -->
                            <tr class="tree-row tree-empty-progress-row" data-parent="@procNodeId" data-root="@statusNodeId" data-level="3">
                                <td colspan="@(canEdit ? 9 : 8)" class="py-3 px-4 text-center bgc-white border-1 brc-grey-l3">
                                    <div class="tree-empty-progress-box">
                                        <i class="fa fa-info-circle text-primary text-105"></i>
                                        <span>Quy trình <strong>@prGroup.Key.ProcessName</strong> chưa có tiến trình nào.</span>
                                        @if (canEdit && prGroup.Key.ProcessID > 0)
                                        {
                                            <button type="button" class="btn btn-xs btn-success font-weight-bold px-25 py-1 radius-1 shadow-sm ml-2" onclick="openAddProgressToProcessModal(@Model.DigitalSalesID, @prGroup.Key.ProcessID, '@Html.Raw(HttpUtility.JavaScriptStringEncode(prGroup.Key.ProcessName))');">
                                                <i class="fa fa-plus mr-1"></i> Thêm tiến trình ngay
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int taskIdx = 1;
                            foreach (var task in realTasks.OrderBy(p => p.SortOrder).ThenBy(p => p.TrackingID))
                            {
                            string taskNodeId = $"{procNodeId}_task_{task.TrackingID}";
                            bool isOverdue = task.IsOverdue == 1;

                            <!-- ========================================================================= -->
                            <!-- CẤP 3: TIẾN TRÌNH (CÓ NGÀY BẮT ĐẦU, TỔNG NGÀY VÀ DẤU (+) SAU TÊN)        -->
                            <!-- ========================================================================= -->
                            <tr class="tree-row tree-progress-row" data-node="@taskNodeId" data-parent="@procNodeId" data-root="@statusNodeId" data-level="3" data-expanded="true">
                                <td class="pl-4">
                                    <div class="d-flex align-items-center flex-wrap">
                                        <input type="checkbox" class="tree-checkbox chk-task mr-2" id="chk_task_@task.TrackingID"
                                               @(task.Status == 3 ? "checked" : "")
                                               onchange="actionConfirmTracking(@task.TrackingID, @Model.DigitalSalesID);"
                                               title="Đánh dấu hoàn thành tiến trình" />
                                        <span class="tree-progress-title">@taskIdx. @task.TaskName</span>

                                        @if (canEdit)
                                        {
                                            <!-- DẤU (+) PHÍA SAU TÊN TIẾN TRÌNH: THÊM TODO LIST -->
                                            <a href="javascript:void(0);" class="btn-add-todo" onclick="openAddTodoModal(@task.TrackingID, @Model.DigitalSalesID);" title="Thêm công việc con (Todo list)">
                                                <i class="fa fa-plus"></i>
                                            </a>
                                        }

                                        @if (task.TodoList != null && task.TodoList.Count > 0)
                                        {
                                            <span class="badge badge-secondary badge-pill text-75 font-bold ml-2 cursor-pointer" onclick="toggleTreeNode('@taskNodeId');">
                                                <i class="fa fa-list-ul mr-1"></i>@task.TodoList.Count việc
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center"><span class="badge bgc-primary-l4 text-primary-d2 border-1 brc-primary-m3 font-bold px-2 py-1 text-80">@task.TrackingCode</span></td>
                                <td><span class="text-dark">@(string.IsNullOrEmpty(task.AssignedUserName) ? "—" : task.AssignedUserName)</span></td>
                                <td class="text-center">@task.StartDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center"><span class="@(isOverdue ? "text-danger font-bold" : "text-dark")">@task.MaxDeadline.ToString("dd/MM/yyyy")</span></td>
                                <td class="text-center"><span class="badge badge-light-secondary font-bold">@task.EffectiveDurationDays ngày</span></td>
                                <td class="text-center">
                                    @if (task.Status == 3)
                                    {
                                        <span class="badge badge-success px-2 font-bold">Hoàn thành</span>
                                    }
                                    else if (task.Status == 2)
                                    {
                                        <span class="badge badge-warning px-2 font-bold">Đang làm</span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="badge badge-danger px-2 font-bold">Quá hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2">Chưa làm</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(task.AttachmentFile))
                                    {
                                        <a href="@Url.Action("DownloadAttachment", "DigitalSales", new { area = "Cate", filePath = task.AttachmentFile })" target="_blank" class="text-primary font-bold" title="Tải file kết quả">
                                            <i class="fa fa-file-download mr-1"></i>Tải file
                                        </a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(task.ResultNote))
                                    {
                                        <span class="text-secondary-d1 text-80" title="@task.ResultNote">
                                            <i class="fa fa-comment-alt mr-1 text-info"></i>@(task.ResultNote.Length > 15 ? task.ResultNote.Substring(0, 15) + "..." : task.ResultNote)
                                        </span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                @if (canEdit)
                                {
                                    <td class="text-center">
                                        <a href="javascript:void(0);" class="text-primary mr-2" onclick="openEditTrackingModal(@task.TrackingID, @Model.DigitalSalesID);" title="Chỉnh sửa tiến trình"><i class="fa fa-edit"></i></a>
                                        <a href="javascript:void(0);" class="text-danger" onclick="actionDeleteTracking(@task.TrackingID, @Model.DigitalSalesID);" title="Xóa tiến trình"><i class="fa fa-trash-alt"></i></a>
                                    </td>
                                }
                            </tr>

                            <!-- ========================================================================= -->
                            <!-- CẤP 4: TODO LIST TRONG TIẾN TRÌNH (CÔNG VIỆC NHỎ, DEADLINE <= START + TỔNG)-->
                            <!-- ========================================================================= -->
                            if (task.TodoList != null && task.TodoList.Count > 0)
                            {
                                foreach (var todo in task.TodoList)
                                {
                                    bool todoOverdue = todo.IsOverdue == 1;
                                    <tr class="tree-row tree-todo-row" data-parent="@taskNodeId" data-subparent="@procNodeId" data-root="@statusNodeId" data-level="4">
                                        <td style="padding-left: 48px;">
                                            <div class="d-flex align-items-center flex-wrap">
                                                <span class="tree-todo-branch">└─</span>
                                                <input type="checkbox" class="tree-checkbox chk-todo mr-2" id="chk_todo_@todo.TrackingID"
                                                       @(todo.Status == 3 ? "checked" : "")
                                                       onchange="actionConfirmTracking(@todo.TrackingID, @Model.DigitalSalesID);"
                                                       title="Đánh dấu hoàn thành việc nhỏ" />
                                                <span class="tree-todo-title mr-2">@todo.TaskName</span>
                                                <span class="ds-tree-sep">-</span>
                                                <div class="ds-tree-actions">
                                                    <a href="javascript:void(0);" class="ds-tree-btn ds-tree-btn-report" onclick="openTrackingReportModal(@todo.TrackingID, @Model.DigitalSalesID);" title="Báo cáo tiến độ/kết quả thực hiện">
                                                        <i class="fa fa-file-alt mr-1"></i>Báo cáo
                                                    </a>
                                                    <span class="ds-tree-sep">|</span>
                                                    <a href="javascript:void(0);" class="ds-tree-btn ds-tree-btn-confirm" onclick="actionConfirmTracking(@todo.TrackingID, @Model.DigitalSalesID);" title="Xác nhận hoàn thành hạng mục">
                                                        <i class="fa fa-check mr-1"></i>Xác nhận
                                                    </a>
                                                    <span class="ds-tree-sep">|</span>
                                                    <a href="javascript:void(0);" class="ds-tree-btn ds-tree-btn-unlock" onclick="actionUnlockTracking(@todo.TrackingID, @Model.DigitalSalesID);" title="Mở khóa để chỉnh sửa/làm lại">
                                                        <i class="fa fa-unlock-alt mr-1"></i>Mở khóa
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center"><span class="text-secondary-d1 text-75">@todo.TrackingCode</span></td>
                                        <td><span class="text-dark">@(string.IsNullOrEmpty(todo.AssignedUserName) ? "—" : todo.AssignedUserName)</span></td>
                                        <td class="text-center text-85">@todo.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">
                                            <span class="@(todoOverdue ? "text-danger font-bold" : "text-dark") text-85">
                                                @(todo.Deadline.HasValue ? todo.Deadline.Value.ToString("dd/MM/yyyy") : "—")
                                            </span>
                                        </td>
                                        <td class="text-center text-secondary">—</td>
                                        <td class="text-center">
                                            @if (todo.Status == 3)
                                            {
                                                <span class="badge badge-success text-75 px-2">Hoàn thành</span>
                                            }
                                            else if (todo.Status == 2)
                                            {
                                                <span class="badge badge-warning text-75 px-2">Đang làm</span>
                                            }
                                            else if (todoOverdue)
                                            {
                                                <span class="badge badge-danger text-75 px-2">Quá hạn</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary text-75 px-2">Chưa làm</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(todo.AttachmentFile))
                                            {
                                                <a href="@Url.Action("DownloadAttachment", "DigitalSales", new { area = "Cate", filePath = todo.AttachmentFile })" target="_blank" class="text-primary font-bold text-80" title="Tải file đính kèm">
                                                    <i class="fa fa-paperclip mr-1"></i>File
                                                </a>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(todo.ResultNote))
                                            {
                                                <span class="text-secondary-d1 text-75" title="@todo.ResultNote">
                                                    <i class="fa fa-comment-alt mr-1 text-info"></i>@(todo.ResultNote.Length > 12 ? todo.ResultNote.Substring(0, 12) + "..." : todo.ResultNote)
                                                </span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        @if (canEdit)
                                        {
                                            <td class="text-center">
                                                <a href="javascript:void(0);" class="text-primary mr-2" onclick="openEditTodoModal(@todo.TrackingID, @Model.DigitalSalesID);" title="Chỉnh sửa việc nhỏ"><i class="fa fa-edit"></i></a>
                                                <a href="javascript:void(0);" class="text-danger" onclick="actionDeleteTracking(@todo.TrackingID, @Model.DigitalSalesID);" title="Xóa việc nhỏ"><i class="fa fa-trash-alt"></i></a>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            taskIdx++;
                        }
                        }
                        procIdx++;
                    }
                    statusIdx++;
                }
            }
            else
            {
                <tr>
                    <td colspan="@(canEdit ? 9 : 8)" class="text-center py-4 text-secondary-m1">
                        <i class="fa fa-clipboard-list text-180 text-secondary-l1 mb-2 d-block"></i>
                        <span>Chưa có tiến trình / checklist nào được khởi tạo cho hồ sơ này.</span>
                        @if (canEdit)
                        {
                            <div class="mt-2">
                                <button type="button" class="btn btn-xs btn-orange px-3 radius-1 font-bold" onclick="openAddTrackingModal(@Model.DigitalSalesID);">
                                    <i class="fa fa-plus mr-1"></i> Thêm công việc đầu tiên
                                </button>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    // Logic tương tác Đóng/Mở cây Checklist (Tree Fold/Unfold)
    function toggleTreeNode(nodeId) {
        var $row = $('tr[data-node="' + nodeId + '"]');
        if ($row.length === 0) return;
        var isExpanded = $row.attr('data-expanded') === 'true';
        var newExpanded = !isExpanded;
        $row.attr('data-expanded', newExpanded ? 'true' : 'false');

        var $icon = $('#icon_' + nodeId);
        if (newExpanded) {
            $icon.removeClass('collapsed');
        } else {
            $icon.addClass('collapsed');
        }

        // Tầng 1: Đóng/mở toàn bộ con thuộc nhánh Status
        if ($row.hasClass('tree-status-row')) {
            var $descendants = $('#treeTrackingBody tr[data-parent="' + nodeId + '"], #treeTrackingBody tr[data-root="' + nodeId + '"]');
            if (newExpanded) {
                $descendants.show();
                $descendants.each(function () {
                    var nId = $(this).attr('data-node');
                    if (nId) {
                        $(this).attr('data-expanded', 'true');
                        $('#icon_' + nId).removeClass('collapsed');
                    }
                });
            } else {
                $descendants.hide();
            }
        }
        // Tầng 2: Đóng/mở các tiến trình con của quy trình
        else if ($row.hasClass('tree-process-row')) {
            var $children = $('#treeTrackingBody tr[data-parent="' + nodeId + '"], #treeTrackingBody tr[data-subparent="' + nodeId + '"]');
            if (newExpanded) {
                $children.show();
                $children.each(function () {
                    var nId = $(this).attr('data-node');
                    if (nId) {
                        $(this).attr('data-expanded', 'true');
                        $('#icon_' + nId).removeClass('collapsed');
                    }
                });
            } else {
                $children.hide();
            }
        }
        // Tầng 3: Đóng/mở các Todo list con của tiến trình
        else if ($row.hasClass('tree-progress-row')) {
            var $items = $('#treeTrackingBody tr[data-parent="' + nodeId + '"]');
            if (newExpanded) {
                $items.show();
            } else {
                $items.hide();
            }
        }
    }

    // Nút mở rộng tất cả / thu gọn tất cả
    function toggleAllChecklistTree(expandAll) {
        var $body = $('#treeTrackingBody');
        if (expandAll) {
            $body.find('tr').show();
            $body.find('.tree-toggle-icon').removeClass('collapsed');
            $body.find('tr[data-node]').attr('data-expanded', 'true');
        } else {
            // Chỉ giữ lại tầng 1 (Trạng thái)
            $body.find('tr.tree-process-row, tr.tree-progress-row, tr.tree-todo-row').hide();
            $body.find('.tree-toggle-icon').addClass('collapsed');
            $body.find('tr[data-node]').attr('data-expanded', 'false');
        }
    }
</script>