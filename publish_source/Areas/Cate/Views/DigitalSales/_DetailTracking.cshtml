<script>
    // Logic tương tác Đóng/Mở cây Checklist (Tree Fold/Unfold)
    function toggleTreeNode(nodeId) {
        var $row = $('tr[data-node="' + nodeId + '"]');
        if ($row.length === 0) return;
        var isExpanded = $row.attr('data-expanded') === 'true';
        var newExpanded = !isExpanded;
        $row.attr('data-expanded', newExpanded ? 'true' : 'false');

        var $icon = $('#icon_' + nodeId);
        if (newExpanded) {
            $icon.removeClass('collapsed');
        } else {
            $icon.addClass('collapsed');
        }

        // Tầng 1: Đóng/mở toàn bộ con thuộc nhánh node_A hoặc node_B
        if ($row.hasClass('tree-level-1')) {
            var $descendants = $('#treeTrackingBody tr[data-parent="' + nodeId + '"], #treeTrackingBody tr[data-root="' + nodeId + '"]');
            if (newExpanded) {
                $descendants.show();
                $descendants.each(function () {
                    var nId = $(this).attr('data-node');
                    if (nId) {
                        $(this).attr('data-expanded', 'true');
                        $('#icon_' + nId).removeClass('collapsed');
                    }
                });
            } else {
                $descendants.hide();
            }
        }
        // Tầng 2: Đóng/mở các quy trình và tiến trình con của trạng thái
        else if ($row.hasClass('tree-level-2')) {
            var $children = $('#treeTrackingBody tr[data-parent="' + nodeId + '"], #treeTrackingBody tr[data-subparent="' + nodeId + '"]');
            if (newExpanded) {
                $children.show();
                $children.each(function () {
                    var nId = $(this).attr('data-node');
                    if (nId) {
                        $(this).attr('data-expanded', 'true');
                        $('#icon_' + nId).removeClass('collapsed');
                    }
                });
            } else {
                $children.hide();
            }
        }
        // Tầng 3: Đóng/mở các tiến trình con của quy trình
        else if ($row.hasClass('tree-level-3')) {
            var $items = $('#treeTrackingBody tr[data-parent="' + nodeId + '"]');
            if (newExpanded) {
                $items.show();
            } else {
                $items.hide();
            }
        }
    }

    // Nút mở rộng tất cả / thu gọn tất cả
    function toggleAllChecklistTree(expandAll) {
        var $body = $('#treeTrackingBody');
        if (expandAll) {
            $body.find('tr').show();
            $body.find('.tree-toggle-icon').removeClass('collapsed');
            $body.find('tr[data-node]').attr('data-expanded', 'true');
        } else {
            // Chỉ giữ lại tầng 1 (A. Cơ hội & A. Dự án)
            $body.find('tr.tree-level-2, tr.tree-level-3, tr.tree-level-4').hide();
            $body.find('.tree-toggle-icon').addClass('collapsed');
            $body.find('tr[data-node]').attr('data-expanded', 'false');
        }
    }

    // Các hàm placeholder cho hành động UI (Khoan code chức năng theo yêu cầu)
    function actionTreeReport(name) {
        if (typeof toastr !== "undefined") {
            toastr.info("Mở form Báo cáo cho: " + name);
        } else {
            alert("Báo cáo: " + name);
        }
    }

    function actionTreeConfirm(name) {
        if (typeof toastr !== "undefined") {
            toastr.success("Xác nhận hoàn thành cho: " + name);
        } else {
            alert("Xác nhận hoàn thành: " + name);
        }
    }

    function actionTreeUnlock(name) {
        if (typeof toastr !== "undefined") {
            toastr.warning("Mở khóa xác nhận cho: " + name);
        } else {
            alert("Mở khóa xác nhận: " + name);
        }
    }
</script>

