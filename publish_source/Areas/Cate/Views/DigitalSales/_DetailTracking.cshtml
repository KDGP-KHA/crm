@model Core.Cate.Models.RM_DigitalSalesModel
@{
    bool canEdit = ViewBag.CanEdit == true;
    var totalTasks = Model.TrackingTasks?.Count ?? 0;
    var completedTasks = Model.TrackingTasks?.Count(t => t.Status == 3) ?? 0;
}

<span id="partialTrackingProgress" class="d-none" data-completed="@completedTasks" data-total="@totalTasks"></span>

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_DetailTracking.css?v=@DateTime.Now.Ticks" />

<!-- HEADER CỦA TAB CHECKLIST -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap: 10px;">
    <div class="d-flex align-items-center">
        <h6 class="text-orange font-weight-bold mb-0 text-110">
            <i class="fa fa-tasks mr-1"></i> Checklist
        </h6>
        <span class="badge badge-pill badge-warning ml-2 font-bold px-2 py-1" id="badgeChecklistSummary">@completedTasks/@(totalTasks > 0 ? totalTasks : 12)</span>
    </div>
    <div class="d-flex align-items-center flex-wrap" style="gap: 6px;">
        <button type="button" class="btn btn-xs btn-white border-1 brc-grey-l1 text-secondary-d1 radius-1 px-2 py-1 shadow-sm font-bold" id="btnExpandAllChecklist" onclick="toggleAllChecklistTree(true);">
            <i class="fa fa-expand-alt mr-1 text-primary"></i> Mở rộng tất cả
        </button>
        <button type="button" class="btn btn-xs btn-white border-1 brc-grey-l1 text-secondary-d1 radius-1 px-2 py-1 shadow-sm font-bold" id="btnCollapseAllChecklist" onclick="toggleAllChecklistTree(false);">
            <i class="fa fa-compress-alt mr-1 text-orange"></i> Thu gọn tất cả
        </button>
        @if (canEdit)
        {
            <button type="button" class="btn btn-sm btn-orange px-3 radius-1 shadow-sm font-bold ml-1" onclick="openAddTrackingModal(@Model.DigitalSalesID);">
                <i class="fa fa-plus mr-1"></i> Thêm công việc tùy biến
            </button>
        }
    </div>
</div>

<!-- BẢNG TREE GRID PHÂN CẤP 4 TẦNG -->
<div class="table-responsive">
    <table class="table table-bordered text-90 tree-table" id="tblTracking">
        <thead class="bgc-secondary-l1 text-secondary-d2">
            <tr>
                <th style="min-width: 480px;">Tên công việc / Đầu mục tiến trình</th>
                <th style="width: 150px;">Người thực hiện</th>
                <th style="width: 105px;" class="text-center">Bắt đầu</th>
                <th style="width: 115px;" class="text-center">Hạn chót</th>
                <th style="width: 120px;" class="text-center">Trạng thái</th>
                <th style="width: 100px;">Kết quả / File</th>
                @if (canEdit)
                {
                    <th style="width: 80px;" class="text-center">Thao tác</th>
                }
            </tr>
        </thead>
        <tbody id="treeTrackingBody">

            <!-- ========================================================================================= -->
            <!-- A. CƠ HỘI -->
            <!-- ========================================================================================= -->
            <tr class="tree-row tree-level-1" data-node="node_A" data-level="1" data-expanded="true">
                <td colspan="@(canEdit ? 7 : 6)" class="tree-node-clickable" onclick="toggleTreeNode('node_A');">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center indent-l1">
                            <i class="fa fa-chevron-down tree-toggle-icon text-primary mr-2" id="icon_node_A"></i>
                            <span class="font-bolder text-105 text-primary-d2">A. Cơ hội</span>
                            <span class="badge badge-primary badge-pill ml-2 text-75 font-bold">2 Trạng thái</span>
                        </div>
                        <span class="text-secondary-m1 text-80 font-italic mr-2"><i class="fa fa-info-circle mr-1"></i>Bấm để thu gọn/mở rộng</span>
                    </div>
                </td>
            </tr>

            <!-- A -> I. Trạng thái 1 -->
            <tr class="tree-row tree-level-2" data-node="node_A_I" data-parent="node_A" data-level="2" data-expanded="true">
