@using TSFramework.Libs.Processors
@model Core.Cate.Models.DashboardSearchModel
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Project_Title") + " theo nhóm dịch vụ";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-cubes"></i>
}

@section FormBody{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-b-1 brc-default-l2">
        <div>
            <span class="badge badge-info text-95 py-15 px-25">
                <i class="fa fa-calendar-alt mr-1"></i>@Model.FromDate.ToString("dd/MM/yyyy") - @Model.ToDate.ToString("dd/MM/yyyy")
            </span>
        </div>
        <div>
            <a href="/Dashboard/Dashboard/ExportProjectByGroupService?fromDate=@Model.FromDate.ToString("dd/MM/yyyy")&toDate=@Model.ToDate.ToString("dd/MM/yyyy")&groupServiceId=@Model.GroupServiceID"
               class="btn btn-sm btn-warning font-bold text-white shadow-sm px-3 py-1 radius-1 db-btn-export-card"
               title="Tải danh sách Excel">
                <i class="fa fa-download mr-1"></i>Tải danh sách
            </a>
        </div>
    </div>
    <div class="mt-2">
        <div class="card dcard">
            <div class="col-sm-12 table-responsive-md">
                <table id="DSProjectByGroupService" class="d-style w-100 table text-dark-m1 text-100 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                    <thead class="sticky-nav text-secondary-m1 text-uppercase text-95 bgc-secondary-l1">
                        <tr>
                            <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Info_Project_Label")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Project_Cost_Label")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Project_Revenue_Label")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Members_Title")</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        var _tablePrjByGroupService;
        $(document).ready(function () {
            $('#modal_ProjectByGroupService').addClass('modal-fs').removeClass('modal-lg');
            initTablePrjByGroupService();
        });

        function initTablePrjByGroupService() {
            _tablePrjByGroupService = $("#DSProjectByGroupService").DataTable({
                "responsive": true,
                "lengthChange": true,
                "processing": true,
                "serverSide": false,
                "ordering": true,
                "order": [[1, "desc"]],
                "ajax": {
                    "url": "/Dashboard/Dashboard/GetProjectByGroupService",
                    "type": "POST",
                    "dataType": "JSON",
                    "data": {
                        FromDate: '@Model.FromDate.ToString("dd/MM/yyyy")',
                        ToDate: '@Model.ToDate.ToString("dd/MM/yyyy")',
                        GroupServiceId: '@Model.GroupServiceID'
                    }
                },
                "columns": [
                    {
                        "data": null,
                        "orderable": false,
                        "render": function (data, type, row, meta) {
                            return meta.row + 1 + meta.settings._iDisplayStart;
                        }
                    },
                    {
                        "data": null,
                        "className": "text-left",
                        "render": function (data, type, row) {
                            let startDate = "";
                            if (row.StartDate) {
                                let m = moment(row.StartDate);
                                startDate = m.format("DD/MM/YYYY");
                            }

                            return `
                                <div>
                                    <span class="badge ${row.StatusClass}">${row.StatusName}</span>
                                </div>

                                <div class="font-weight-bold text-primary mt-1">
                                    <a href="/Cate/ProjectOverview/Index/${row.ProjectID}" class="db-modal-item-title">
                                        ${row.ProjectName}
                                    </a>
                                </div>

                                <div class="text-muted small mt-1">
                                    <i class="fa fa-building mr-1"></i> ${row.CustomerName || ""}
                                </div>

                                <div class="small text-muted mt-1">
                                    <i class="far fa-clock mr-1"></i> ${startDate}
                                </div>
                            `;
                        }
                    },
                    {
                        "data": "TotalCost",
                        "className": "text-right text-danger font-weight-bold",
                        "render": function (data) {
                            return data ? Number(data).toLocaleString() : "0";
                        }
                    },
                    {
                        "data": "TotalRevenue",
                        "className": "text-right text-success font-weight-bold",
                        "render": function (data) {
                            return data ? Number(data).toLocaleString() : "0";
                        }
                    },
                    {
                        "data": "Members",
                        "orderable": false,
                        "render": function (data, type, row, meta) {
                            if (!data) return "";

                            let members = data.split(';')
                                .map(x => x.trim())
                                .filter(x => x)
                                .sort((a, b) => {
                                    const isAM_a = a.includes("(AM") || a.includes(", AM") || a.endsWith("AM)");
                                    const isAM_b = b.includes("(AM") || b.includes(", AM") || b.endsWith("AM)");
                                    return isAM_b - isAM_a;
                                });

                            const renderMember = (text) => {
                                const isAM = text.includes("(AM") || text.includes(", AM") || text.endsWith("AM)");
                                return `
                                    <div>
                                        - ${isAM ? `<span class="text-danger font-weight-bold">${text}</span>` : text}
                                    </div>
                                `;
                            };

                            if (members.length <= 3) {
                                return members.map(renderMember).join("");
                            }

                            const id = `gs_prj_member_${meta.row}`;
                            const remainCount = members.length - 3;

                            return `
                                ${members.slice(0, 3).map(renderMember).join("")}
                                <div id="${id}" style="display:none">
                                    ${members.slice(3).map(renderMember).join("")}
                                </div>
                                <a href="javascript:void(0)"
                                   data-remain="${remainCount}"
                                   onclick="toggleMembers('${id}', this)">
                                    Xem thêm (${remainCount})
                                </a>
                            `;
                        }
                    }
                ]
            });
        }

        window.toggleMembers = window.toggleMembers || function (id, element) {
            const target = document.getElementById(id);
            if (!target) return;
            const remainCount = target.children.length;
            if (target.style.display === "none") {
                target.style.display = "block";
                element.innerText = "Thu gọn";
            } else {
                target.style.display = "none";
                element.innerText = `Xem thêm (${remainCount})`;
            }
        };
    </script>
}

@section SubmitControl {

}
