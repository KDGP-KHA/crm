@model Core.Cate.Models.DigitalSalesDashboardOverviewModel
@{
    ViewBag.Title = "Dashboard";
    int currentYear = DateTime.Now.Year;
    int selectedYear = Model.ApplyYear > 0 ? Model.ApplyYear : currentYear;
}
@section PageTitle {}
@section PageAction {}

<link rel="stylesheet" href="~/Areas/Dashboard/Views/Dashboard/Chart.css?v=@DateTime.Now.Ticks" />

<div class="dashboard-chart-wrapper">
    <!-- 1. Thanh tiêu đề & Bộ lọc Năm áp dụng -->
    <div class="db-header-bar d-flex flex-wrap align-items-center">
        <div class="db-page-title mr-4 my-1">
            <i class="fa fa-tachometer-alt"></i>
            Dashboard Kinh doanh Sản phẩm Dịch vụ số
        </div>

        <div class="db-filter-group my-1">
            <label class="db-filter-label mr-2" for="ApplyYear">
                <i class="fa fa-calendar-alt text-primary mr-1"></i>Năm áp dụng:
            </label>
            <select id="ApplyYear" name="ApplyYear" class="db-filter-select" onchange="onDashboardYearChange(this.value);">
                @for (int y = currentYear + 3; y >= currentYear - 5; y--)
                {
                    <option value="@y" @(y == selectedYear ? "selected" : "")>Năm @y</option>
                }
            </select>
        </div>
    </div>

    <!-- 2. Nội dung Dashboard -->
    <div id="overview-content-container" class="db-overview-container">
        @Html.Partial("_ChartOverview", Model)
    </div>

    <!-- Hidden element phục vụ kích hoạt Modal hệ thống -->
    <div class="d-none">
        <a data-modal="true" data-modal-id="OpportunityByGroupService" class="d-none" href="#"></a>
        <a data-modal="true" data-modal-id="DigitalSalesByStatus" class="d-none" href="#"></a>
    </div>
</div>

@section BottomScript {
    <script src="~/Contents/Base/plugins/apexcharts/apexcharts.min.js"></script>
    <script>
        window._dashboardChartUrls = {
            getOverview: '@Url.Action("GetChartOverviewData", "Dashboard", new { area = "Dashboard" })',
            digitalSalesByStatus: '@Url.Action("DigitalSalesByStatus", "Dashboard", new { area = "Dashboard" })',
            getGroupServiceChart: '@Url.Action("GetGroupServiceChart", "Dashboard", new { area = "Dashboard" })',
            opportunityByGroupService: '@Url.Action("OpportunityByGroupService", "Dashboard", new { area = "Dashboard" })',
            export: '@Url.Action("Export", "DigitalSales", new { area = "Cate" })'
        };
    </script>
    <script src="~/Areas/Dashboard/Views/Dashboard/Chart.js?v=@DateTime.Now.Ticks"></script>
}
