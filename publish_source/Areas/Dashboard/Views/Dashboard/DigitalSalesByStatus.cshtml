@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesSearchModel
@{
    ViewBag.Title = "Danh sách Cơ hội kinh doanh - " + (ViewBag.StatusName as string) + " (Năm " + ViewBag.ApplyYear + ")";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType {
    primary
}

@section FormIcon {
    <i class="fa fa-briefcase"></i>
}

@section FormBody {
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-b-1 brc-default-l2">
        <div class="mb-1 mb-sm-0">
            <span class="badge badge-info text-90 mr-2 py-1 px-2">
                <i class="fa fa-calendar-alt mr-1"></i>Năm @ViewBag.ApplyYear
            </span>
            <span class="badge badge-primary text-90 mr-2 py-1 px-2">
                <i class="fa fa-tag mr-1"></i>@ViewBag.StatusName
            </span>
        </div>
        <div>
            <a href="/Cate/DigitalSales?applyYear=@ViewBag.ApplyYear@(ViewBag.StatusID > 0 ? "&statusId=" + ViewBag.StatusID : "")"
               target="_blank"
               class="btn btn-xs btn-outline-primary radius-2 px-2">
                <i class="fa fa-external-link-alt mr-1"></i>Mở trên trang Quản lý
            </a>
        </div>
    </div>

    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md p-0">
            <table id="DSDigitalSalesByStatus" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="text-center align-middle">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th class="align-middle">Thông tin cơ hội / dự án</th>
                        <th class="align-middle">Doanh thu</th>
                        <th class="align-middle">Thời gian</th>
                        <th class="align-middle">Phụ trách</th>
                        <th class="text-center align-middle text-nowrap">Thao tác</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>

    <script type="text/javascript">
        var _tableDigitalSalesByStatus;

        function formatMoney(val) {
            if (val === null || val === undefined || val === "") return "—";
            var num = parseFloat(val);
            if (isNaN(num)) return "—";
            if (num === 0) return "0 tr đ";
            var mil = num / 1000000;
            var formatted = (mil % 1 === 0)
                ? mil.toLocaleString('vi-VN')
                : mil.toLocaleString('vi-VN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
            return formatted + " tr đ";
        }

        function formatDate(val) {
            if (!val) return "";
            if (typeof moment !== "undefined") {
                var m = moment(val);
                return m.isValid() ? m.format("DD/MM/YYYY") : "";
            }
            return "";
        }

        $(document).ready(function () {
            // Thiết lập kích thước modal toàn màn hình linh hoạt
            $('#modal_DigitalSalesByStatus').addClass('modal-fs').removeClass('modal-lg');
            initTableDigitalSalesByStatus();
        });

        function initTableDigitalSalesByStatus() {
            _tableDigitalSalesByStatus = $("#DSDigitalSalesByStatus").DataTable({
                responsive: true,
                lengthChange: true,
                processing: true,
                serverSide: false,
                ordering: true,
                order: [[1, "asc"]],
                ajax: {
                    url: "/Dashboard/Dashboard/GetDigitalSalesByStatus",
                    type: "POST",
                    dataType: "JSON",
                    data: {
                        applyYear: '@Model.ApplyYear',
                        statusId: '@Model.StatusID',
                        keyword: '@(Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Keyword ?? "")))'
                    }
                },
                columnDefs: [
                    { targets: 0, width: "45px", className: "text-center align-middle", orderable: false },
                    { targets: 1, minWidth: "260px", className: "align-middle" },
                    { targets: 2, minWidth: "170px", className: "align-middle" },
                    { targets: 3, minWidth: "130px", className: "align-middle" },
                    { targets: 4, minWidth: "150px", className: "align-middle" },
                    { targets: 5, width: "115px", className: "text-center align-middle text-nowrap", orderable: false }
                ],
                columns: [
                    {
                        data: null,
                        orderable: false,
                        className: "text-center align-middle",
                        render: function (data, type, row, meta) {
                            return meta.row + 1 + meta.settings._iDisplayStart;
                        }
                    },
                    {
                        data: null,
                        className: "align-middle",
                        render: function (data, type, row) {
                            var typeBadge = row.BusinessType === 2
                                ? '<span class="badge badge-success px-2 py-1 mr-1 text-80"><i class="fa fa-project-diagram mr-1"></i>Dự án</span>'
                                : '<span class="badge badge-primary px-2 py-1 mr-1 text-80"><i class="fa fa-lightbulb mr-1"></i>Cơ hội</span>';

                            var statusBadge = row.StatusName
                                ? '<span class="badge badge-secondary px-2 py-1 mr-1 text-80">' + row.StatusName + '</span>'
                                : '';

                            var codeBadge = row.Code
                                ? '<span class="badge bgc-warning-l3 text-warning-d3 border-1 brc-warning-m2 mr-1 font-mono font-bold px-15 py-05 radius-1 text-80"><i class="fa fa-hashtag mr-1 opacity-75"></i>' + row.Code + '</span>'
                                : '';

                            var specialBadges = '';
                            if (row.IsKeyProject) {
                                specialBadges += '<span class="badge bgc-orange-l3 text-orange-d3 border-1 brc-orange-m2 mr-1 font-bold px-15 py-05 radius-1 text-80" title="Dự án trọng điểm"><i class="fa fa-star text-warning mr-1"></i>Trọng điểm</span>';
                            }
                            if (row.IsFollowed) {
                                specialBadges += '<span class="badge bgc-pink-l3 text-pink-d2 border-1 brc-pink-m3 mr-1 font-bold px-15 py-05 radius-1 text-80" title="Cơ hội/dự án quan tâm"><i class="fa fa-bookmark text-danger mr-1"></i>Quan tâm</span>';
                            }

                            var titleHtml = '<a href="/Cate/DigitalSales/Detail?id=' + row.DigitalSalesID + '" target="_blank" class="font-weight-bold text-primary text-95 d-block mt-1" title="Xem chi tiết 360 độ">'
                                + (row.Title || '—') + '</a>';

                            var customerHtml = row.CustomerName
                                ? '<div class="text-secondary text-85 mt-1"><i class="fa fa-building mr-1 text-primary"></i>' + row.CustomerName + '</div>'
                                : '';

                            var productsHtml = row.ProductServiceNames
                                ? '<div class="text-secondary text-85 mt-1"><i class="fa fa-tags mr-1 text-purple"></i>' + row.ProductServiceNames + '</div>'
                                : '';

                            return '<div class="d-flex align-items-center flex-wrap mb-1">' + typeBadge + statusBadge + codeBadge + specialBadges + '</div>' + titleHtml + customerHtml + productsHtml;
                        }
                    },
                    {
                        data: null,
                        className: "align-middle",
                        render: function (data, type, row) {
                            var exp = row.TotalExpectedRevenue != null ? formatMoney(row.TotalExpectedRevenue) : '—';
                            var act = row.TotalActualRevenue != null ? formatMoney(row.TotalActualRevenue) : '—';
                            var prob = (row.ClosingProbability != null && row.ClosingProbability > 0)
                                ? ' <span class="badge badge-warning text-dark ml-1" title="Xác suất chốt">' + row.ClosingProbability + '%</span>'
                                : '';

                            return '<div class="text-90"><b>DT Dự kiến:</b> <span class="text-primary font-weight-bold">' + exp + '</span>' + prob + '</div>'
                                 + '<div class="text-90 mt-1"><b>DT Thực tế:</b> <span class="text-success font-weight-bold">' + act + '</span></div>';
                        }
                    },
                    {
                        data: null,
                        className: "align-middle",
                        render: function (data, type, row) {
                            var yearHtml = '<div class="text-90"><b>Năm:</b> ' + (row.ApplyYear || '@Model.ApplyYear') + '</div>';
                            var expDate = formatDate(row.ExpectedDate);
                            var dateHtml = expDate
                                ? '<div class="text-85 text-muted mt-1"><i class="far fa-calendar-alt mr-1"></i>Dự kiến: ' + expDate + '</div>'
                                : '';
                            return yearHtml + dateHtml;
                        }
                    },
                    {
                        data: null,
                        className: "align-middle",
                        render: function (data, type, row) {
                            var leader = row.AssignedEmployeeName || row.LeaderEmployeeName || '—';
                            var dept = row.DepartmentName
                                ? '<div class="text-85 text-muted mt-1"><i class="fa fa-sitemap mr-1"></i>' + row.DepartmentName + '</div>'
                                : '';
                            var contact = row.ContactPersonName
                                ? '<div class="text-85 text-secondary mt-1"><i class="fa fa-phone mr-1"></i>' + row.ContactPersonName + (row.ContactPersonPhone ? ' (' + row.ContactPersonPhone + ')' : '') + '</div>'
                                : '';
                            return '<div class="text-90 font-weight-bold text-dark-m1"><i class="fa fa-user-tie mr-1 text-success"></i>' + leader + '</div>' + dept + contact;
                        }
                    },
                    {
                        data: null,
                        className: "text-center align-middle text-nowrap",
                        orderable: false,
                        render: function (data, type, row) {
                            return '<a href="/Cate/DigitalSales/Detail?id=' + row.DigitalSalesID + '" target="_blank" class="btn btn-xs btn-outline-primary btn-h-light-primary radius-1 px-2 py-1 text-nowrap font-bolder shadow-sm" title="Xem chi tiết 360 độ">'
                                 + '<i class="fa fa-eye mr-1"></i>Chi tiết</a>';
                        }
                    }
                ],
                language: {
                    processing: "Đang tải dữ liệu...",
                    emptyTable: "Không có dữ liệu phù hợp",
                    info: "Hiển thị từ _START_ đến _END_ trong tổng số _TOTAL_ hồ sơ",
                    infoEmpty: "Không có hồ sơ nào",
                    infoFiltered: "(lọc từ _MAX_ hồ sơ)",
                    lengthMenu: "Hiển thị _MENU_ hồ sơ",
                    paginate: {
                        first: "Đầu",
                        previous: "Trước",
                        next: "Sau",
                        last: "Cuối"
                    }
                },
                initComplete: function () {
                    $('#DSDigitalSalesByStatus_wrapper .dataTables_length select').addClass('none-select2');
                }
            });
        }
    </script>
}

@section SubmitControl {
}
