@using TSFramework.Libs.Processors
@using TSFramework.Libs.Extensions
@model Core.Sys.Models.SharedDocumentModel

@Html.AntiForgeryToken()

<div class="form-group row">
    @Html.TitleFor(m => m.DocumentName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-sm-9">
        @Html.TextBoxFor(m => m.DocumentName, new { id = "DocumentName_Add", @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("SharedDoc_Placeholder_Name") })
        @Html.ValidationMessageFor(m => m.DocumentName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(m => m.CategoryId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-sm-9">
        @Html.DropDownListFor(
            m => m.CategoryId,
            Model.Categories,
            new { id = "CategoryId_Add", @class = "form-control" }
        )
        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(m => m.Description, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-sm-9">
        @Html.TextAreaFor(m => m.Description, new { id = "Description_Add", @class = "form-control", rows = 3, placeholder = AppProcessor.Messagor.GetMessage("SharedDoc_Placeholder_Description") })
        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(m => m.FileUpload, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-sm-9">
        @Html.FileFor(m => m.FileUpload, ".doc,.docx,.xls,.xlsx,.pdf,.ppt,.pptx", false, new { id = "FileUpload_Add", @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("SharedDoc_Placeholder_ChooseFile") })
        @Html.ValidationMessageFor(m => m.FileUpload, "", new { @class = "text-danger" })
        <small class="text-secondary mt-1 d-block">
            <i class="fa fa-info-circle mr-1"></i> @AppProcessor.Messagor.GetMessage("SharedDoc_Placeholder_ChooseFile")
        </small>
    </div>
</div>