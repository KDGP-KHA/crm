@using TSFramework.Libs.Processors
@model Core.Sys.Models.Sys.SysInstructModel

@Html.AntiForgeryToken()
<div id="Language">
    @Html.HiddenFor(model => model.InstructID)

    <!-- InstructName -->
    <div class="form-group">
        @Html.TitleFor(model => model.InstructName, new { @class = "font-bold" })
        @Html.TextBoxFor(model => model.InstructName,
                                              new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Instruct_Label_Name") })
        @Html.ValidationMessageFor(model => model.InstructName, "", new { @class = "text-danger" })
    </div>

    <!-- InstructParent -->
    <div class="form-group">
        @Html.TitleFor(model => model.InstructParentID, new { @class = "font-bold" })
        @Html.DropDownListFor(
                m => m.InstructParentID,
                ViewBag.ParentList as List<SelectListItem>,
                "-- Chọn nhóm cha --",
                new { @class = "form-control" }
            )
    </div>

    <!-- InstructPosition & display-->
    <div class="form-group row">
        <div class="form-group col-sm-6">
            @Html.TitleFor(model => model.PositionShow, new { @class = "font-bold" })
            @Html.TextBoxFor(model => model.PositionShow,
                                                new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Instruct_Label_Name") })
            @Html.ValidationMessageFor(model => model.PositionShow, "", new { @class = "text-danger" })
        </div>

        <div class="form-group d-flex align-items-end pb-2 pl-4">
            @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input" })

            @Html.LabelFor(model => model.IsActive,
                    new { @class = "form-check-label font-bold ml-1" })
        </div>
    </div>

    <!-- Content -->
    <div class="form-group">
        @Html.TitleFor(model => model.Content, new { @class = "font-bold" })
        @Html.TextAreaFor(model => model.Content,
                        new
                        {
                            @class = "form-control",
                            placeholder = AppProcessor.Messagor.GetMessage("Instruct_Label_Content"),
                            id = "ContentInstructEditor"
                        })
        @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })
    </div>

</div>

<script type="text/javascript">
    (function () {
        function initLogCKEditor() {
            if (typeof CKEDITOR === 'undefined') return;
            var ex = CKEDITOR.instances['ContentInstructEditor'];
            if (ex) ex.destroy(true);
            var editor = CKEDITOR.replace('ContentInstructEditor', {
                height: 400,
                allowedContent: true,
                extraAllowedContent: 'img[width,height,style];div[*](*);span[*](*);table[*](*);thead[*](*);tbody[*](*);tr[*](*);th[*](*);td[*](*)',
                toolbar: [
                    { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline'] },
                    { name: 'paragraph', items: ['NumberedList', 'BulletedList'] },
                    { name: 'insert', items: ['Image', 'Table', 'Link'] },
                    { name: 'styles', items: ['Format'] },
                    { name: 'tools', items: ['Maximize'] }
                ]
            });
            if (editor) {
                editor.on('change', function () {
                    editor.updateElement();
                });
            }
        }

        function loadCKEditorThenInit() {
            if (typeof CKEDITOR !== 'undefined') { initLogCKEditor(); return; }
            var s = document.createElement('script');
            s.src = '/Contents/Modules/Major/ckeditor4/ckeditor.js';
            s.onload = function () {
                var s2 = document.createElement('script');
                s2.src = '/Contents/Modules/Major/ckfinder/ckfinder.js';
                s2.onload = function () { initLogCKEditor(); };
                s2.onerror = function () { initLogCKEditor(); };
                document.head.appendChild(s2);
            };
            document.head.appendChild(s);
        }

        $(document).off('submit.instructCkSync').on('submit.instructCkSync', '#AddInstruct, #EditInstruct, form', function () {
            if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['ContentInstructEditor']) {
                CKEDITOR.instances['ContentInstructEditor'].updateElement();
            }
        });

        loadCKEditorThenInit();
    })();
</script>
