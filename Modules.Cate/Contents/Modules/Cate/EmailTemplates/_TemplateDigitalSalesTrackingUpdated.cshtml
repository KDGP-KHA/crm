@model Core.Cate.Models.MailTemplateRenderModel
@using TSFramework.Libs.Processors
@{ var title = AppProcessor.Messagor.GetMessage("Mail_Title") ?? "VNPT CRM"; }
<!DOCTYPE html>
<html><head><meta charset="utf-8" /><title>@title</title></head>
<body style="margin:0;background:#f3f6fb;font-family:Arial,Helvetica,sans-serif;color:#24324a;">
<table width="100%" cellpadding="0" cellspacing="0" style="padding:28px 12px;"><tr><td align="center">
<table width="680" cellpadding="0" cellspacing="0" style="max-width:680px;background:#fff;border-radius:12px;overflow:hidden;">
<tr><td style="padding:22px 28px;background:#6f42c1;color:#fff;"><div style="font-size:12px;opacity:.85;">@title</div><div style="margin-top:7px;font-size:21px;font-weight:bold;">Cập nhật tiến trình / công việc</div></td></tr>
<tr><td style="padding:26px 28px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#24324a;"><p style="margin:0 0 16px;font-size:14px;line-height:1.6;">Kính gửi <strong>@Model.GetString("FullName")</strong>,</p>
<div style="padding:15px 18px;background:#faf8ff;border-left:4px solid #6f42c1;font-size:14px;line-height:1.6;"><div style="font-size:14px;color:#6b7a90;">@Model.GetString("DigitalSalesCode")</div><div style="margin-top:2px;font-size:14px;font-weight:bold;">@Model.GetString("DigitalSalesName")</div><div style="margin-top:5px;font-size:14px;">@Model.GetString("CustomerName")</div></div>
<table width="100%" cellpadding="0" cellspacing="0" style="margin-top:18px;border-collapse:collapse;font-size:14px;line-height:1.6;"><tr><td style="padding:9px 0;color:#6b7a90;font-size:14px;">Nội dung cập nhật</td><td style="padding:9px 0;font-size:14px;font-weight:bold;">@Model.GetString("ActionLabel")</td></tr><tr><td style="padding:9px 0;color:#6b7a90;font-size:14px;">AM chủ trì</td><td style="padding:9px 0;font-size:14px;">@Model.GetString("AssignedEmployeeName", "--")</td></tr><tr><td style="padding:9px 0;color:#6b7a90;font-size:14px;">Người cập nhật</td><td style="padding:9px 0;font-size:14px;">@Model.GetString("ActionByFullName", "--")</td></tr></table>
@if (!string.IsNullOrWhiteSpace(Model.GetString("Description"))) { <div style="margin-top:16px;padding:16px;background:#f7f9fc;border:1px solid #e4eaf3;border-radius:6px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#24324a;">@Raw(Model.GetString("Description"))</div> }
<p style="margin-top:22px;color:#6b7a90;font-size:12px;">Email tự động từ @title.</p></td></tr></table>
</td></tr></table></body></html>
