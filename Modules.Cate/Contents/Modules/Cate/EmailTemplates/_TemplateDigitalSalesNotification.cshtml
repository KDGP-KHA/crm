@model Core.Cate.Models.MailTemplateRenderModel
@using TSFramework.Libs.Processors
@{ var title = AppProcessor.Messagor.GetMessage("Mail_Title") ?? AppProcessor.Messagor.GetMessage("App_Title") ?? "VNPT CRM"; }
<!DOCTYPE html>
<html><head><meta charset="utf-8" /><title>@title</title></head>
<body style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;background:#f5f7fb;color:#233042;">
<table width="100%" cellpadding="0" cellspacing="0" style="padding:24px 0;background:#f5f7fb;"><tr><td align="center">
<table width="720" cellpadding="0" cellspacing="0" style="max-width:720px;background:#fff;border-radius:8px;overflow:hidden;">
<tr><td style="padding:20px 24px;background:#0d6efd;color:#fff;"><div style="font-size:20px;font-weight:bold;">@title</div><div style="margin-top:6px;font-size:13px;">Thông báo Hồ sơ KD sản phẩm / dịch vụ số</div></td></tr>
<tr><td style="padding:24px;"><p>Kính gửi <strong>@Model.GetString("FullName")</strong>,</p>
<p>@Model.GetString("ActionLabel") Hồ sơ KD sản phẩm / dịch vụ số.</p>
<table width="100%" style="border-collapse:collapse;">
<tr><td style="width:180px;padding:7px 0;color:#5b6778;">Mã hồ sơ</td><td style="padding:7px 0;font-weight:bold;">@Model.GetString("DigitalSalesCode", "--")</td></tr>
<tr><td style="padding:7px 0;color:#5b6778;">Tên hồ sơ</td><td style="padding:7px 0;font-weight:bold;">@Model.GetString("DigitalSalesName")</td></tr>
<tr><td style="padding:7px 0;color:#5b6778;">Khách hàng</td><td style="padding:7px 0;">@Model.GetString("CustomerName", "--")</td></tr>
<tr><td style="padding:7px 0;color:#5b6778;">Trạng thái</td><td style="padding:7px 0;">@Model.GetString("StatusName", "--")</td></tr>
@if (!string.IsNullOrWhiteSpace(Model.GetString("RoleNames"))) { <tr><td style="padding:7px 0;color:#5b6778;">Vai trò</td><td style="padding:7px 0;">@Model.GetString("RoleNames")</td></tr> }
<tr><td style="padding:7px 0;color:#5b6778;">Người thực hiện</td><td style="padding:7px 0;">@Model.GetString("ActionByFullName", "--")</td></tr>
</table><p style="margin-top:24px;">Trân trọng.</p></td></tr></table>
</td></tr></table></body></html>
