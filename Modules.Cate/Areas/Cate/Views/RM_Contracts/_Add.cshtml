@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("Contracts_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    success
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{
    @using (Html.BeginForm("Add", "RM_Contracts", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "AddContracts", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Contract")
        </div>
    }

    <script type="text/javascript">
        (function () {
            var $form = $('form#AddContracts');
            var $modal = $form.closest('.modal');
            $modal.find('#btnSave').off('click.digitalSalesContract').on('click.digitalSalesContract', function (e) {
                e.preventDefault();
                $form.submit();
            });

            $form.ajaxForm({
            beforeSubmit: function () {
                if ($form.valid && !$form.valid()) return false;
                $modal.find('#btnSave').prop('disabled', true);
                return true;
            },
            success: function (response) {
                $modal.find('#btnSave').prop('disabled', false);
                if (response.status != undefined) {
                    if (response.status == false) {
                        eval(response.message);
                        response.status = undefined;
                    } else {
                        if ($('#DigitalSalesProductID').val() && typeof DigitalSalesContract_OnProcessSuccess === 'function') {
                            DigitalSalesContract_OnProcessSuccess(response, "AddContracts");
                        } else if (typeof Contracts_OnProcessSuccess === 'function') {
                            Contracts_OnProcessSuccess(response, "AddContracts");
                        }
                    }
                }
                else {

                    if ($('#DigitalSalesProductID').val() && typeof DigitalSalesContract_OnProcessSuccess === 'function') {
                        DigitalSalesContract_OnProcessSuccess(response, "AddContracts");
                    } else if (typeof Contracts_OnProcessSuccess === 'function') {
                        Contracts_OnProcessSuccess(response, "AddContracts");
                    }
                }
            },
            error: function () {
                $modal.find('#btnSave').prop('disabled', false);
            }
            });
        })();
    </script>
}
