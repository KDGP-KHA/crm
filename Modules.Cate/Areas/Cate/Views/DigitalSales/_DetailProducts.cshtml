@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesModel
@{
    var canEdit = ViewBag.CanEdit == true;
    var products = Model.Products ?? new List<Core.Cate.Models.RM_DigitalSalesProductModel>();
}

<span id="partialProductsCount" class="d-none" data-count="@products.Count"></span>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="text-purple font-weight-bold mb-0"><i class="fa fa-cubes mr-1"></i>@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_List_Title")</h6>
    @if (canEdit)
    {
        <button type="button" class="btn btn-sm btn-purple px-3" onclick="openAddProductModal(@Model.DigitalSalesID);"><i class="fa fa-plus mr-1"></i>@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Add_Button")</button>
    }
</div>

@if (products.Count > 0)
{
    <div class="row">
        @foreach (var product in products)
        {
            <div class="col-xl-6 col-lg-12 mb-3">
                <div class="card bcard border-1 brc-purple-m3 shadow-sm h-100">
                    <div class="card-header bgc-purple-l4 py-2 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="font-bolder text-purple-d2 text-105">@product.ProductServiceName</div>
                            @if (!string.IsNullOrWhiteSpace(product.ProductServiceCode))
                            {
                                <span class="text-secondary text-85 font-mono">@product.ProductServiceCode.Trim()</span>
                            }
                        </div>
                        @if (canEdit)
                        {
                            <div class="card-toolbar">
                                <button type="button" class="btn btn-xs btn-white btn-h-light-blue text-blue-d2 border-0 mr-1" title="@AppProcessor.Messagor.GetMessage("Button_Edit")" onclick="openEditProductModal(@product.SalesProductID, @Model.DigitalSalesID);"><i class="fa fa-edit"></i></button>
                                <button type="button" class="btn btn-xs btn-white btn-h-light-red text-danger border-0" title="@AppProcessor.Messagor.GetMessage("Button_Delete")" onclick="deleteProductItem(@product.SalesProductID, @Model.DigitalSalesID);"><i class="fa fa-trash-alt"></i></button>
                            </div>
                        }
                    </div>
                    <div class="card-body p-3">
                        <div class="row text-90 mb-2">
                            <div class="col-sm-7"><span class="text-secondary">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Column_Package"):</span> <span class="font-weight-bold">@(string.IsNullOrWhiteSpace(product.PackageName) ? "—" : product.PackageName)</span></div>
                            <div class="col-sm-5"><span class="text-secondary">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Column_Quantity"):</span> <span class="font-weight-bold">@product.Quantity</span></div>
                        </div>
                        <div class="text-90 mb-3"><span class="text-secondary">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_DateRange_Label"):</span> <span class="font-weight-bold">@(product.StartDate.HasValue ? product.StartDate.Value.ToString("dd/MM/yyyy") : "—") - @(product.EndDate.HasValue ? product.EndDate.Value.ToString("dd/MM/yyyy") : "—")</span></div>
                        <div class="row text-center border-y-1 brc-grey-l2 py-2">
                            <div class="col-6 col-sm-3"><div class="text-secondary text-80">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_ExpectedRevenue_Summary")</div><div class="text-primary font-bolder">@product.ExpectedRevenueMillion.GetValueOrDefault().ToString("N2")</div></div>
                            <div class="col-6 col-sm-3"><div class="text-secondary text-80">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_ActualRevenue_Summary")</div><div class="text-success font-bolder">@product.ActualRevenueMillion.ToString("N2")</div></div>
                            <div class="col-6 col-sm-3"><div class="text-secondary text-80">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_TotalCost_Summary")</div><div class="text-orange-d2 font-bolder">@product.TotalCostMillion.ToString("N2")</div></div>
                            <div class="col-6 col-sm-3"><div class="text-secondary text-80">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Profit_Summary")</div><div class="font-bolder @(product.ProfitMillion < 0 ? "text-danger" : "text-purple-d2")">@product.ProfitMillion.ToString("N2")</div></div>
                        </div>
                        <div class="text-right text-secondary text-80 mt-1">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Unit_Million")</div>
                        @if (!string.IsNullOrWhiteSpace(product.Note))
                        {
                            <div class="mt-2 text-90"><i class="fa fa-sticky-note text-secondary mr-1"></i>@product.Note</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card bcard border-1 brc-grey-l2 shadow-sm">
        <div class="card-body text-center py-5 text-secondary-m2">
            <i class="fa fa-cubes fa-3x mb-3 d-block opacity-2"></i>
            <div class="font-bolder text-105">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Empty_Title")</div>
            <div class="text-90 mt-1">@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Empty_Description")</div>
            @if (canEdit)
            {
                <button type="button" class="btn btn-sm btn-purple px-3 mt-3" onclick="openAddProductModal(@Model.DigitalSalesID);"><i class="fa fa-plus mr-1"></i>@AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Add_Button")</button>
            }
        </div>
    </div>
}
