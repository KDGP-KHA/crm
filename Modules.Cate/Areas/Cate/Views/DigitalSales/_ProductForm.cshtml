@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesProductModel
@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.SalesProductID)
@Html.HiddenFor(m => m.DigitalSalesID)
<div class="card bcard border-1 brc-grey-l2 shadow-sm mb-0"><div class="card-body p-3">
    <div class="form-group">@Html.TitleFor(m => m.ProductServiceID, new { @class = "text-85 text-600 mb-1 d-block" })@Html.DropDownListFor(m => m.ProductServiceID, (List<SelectListItem>)ViewBag.ProductList, AppProcessor.Messagor.GetMessage("DigitalSalesProduct_ProductService_Option"), new { @class = "form-control select2" })@Html.ValidationMessageFor(m => m.ProductServiceID, "", new { @class = "text-danger" })</div>
    <div class="row"><div class="col-md-8 form-group">@Html.TitleFor(m => m.PackageName, new { @class = "text-85 text-600 mb-1 d-block" })@Html.TextBoxFor(m => m.PackageName, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesProduct_PackageName_Placeholder") })@Html.ValidationMessageFor(m => m.PackageName, "", new { @class = "text-danger" })</div><div class="col-md-4 form-group">@Html.TitleFor(m => m.Quantity, new { @class = "text-85 text-600 mb-1 d-block" })@Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", type = "number", min = "1" })@Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger" })</div></div>
    <div class="row"><div class="col-md-6 form-group">@Html.TitleFor(m => m.ExpectedRevenue, new { @class = "text-85 text-600 mb-1 d-block" })@Html.TextBoxFor(m => m.ExpectedRevenue, new { @class = "form-control text-right", type = "number", min = "0", step = "1000", placeholder = AppProcessor.Messagor.GetMessage("DigitalSales_Amount_Placeholder") })@Html.ValidationMessageFor(m => m.ExpectedRevenue, "", new { @class = "text-danger" })</div><div class="col-md-6 form-group">@Html.TitleFor(m => m.ActualRevenue, new { @class = "text-85 text-600 mb-1 d-block" })@Html.TextBoxFor(m => m.ActualRevenue, new { @class = "form-control text-right", type = "number", min = "0", step = "1000", placeholder = AppProcessor.Messagor.GetMessage("DigitalSales_Amount_Placeholder") })@Html.ValidationMessageFor(m => m.ActualRevenue, "", new { @class = "text-danger" })</div></div>
    <div class="row"><div class="col-md-6 form-group">@Html.TitleFor(m => m.StartDate, new { @class = "text-85 text-600 mb-1 d-block" })@Html.TextBoxFor(m => m.StartDate, "{0:dd/MM/yyyy}", new { @class = "form-control date-picker", placeholder = AppProcessor.Messagor.GetMessage("DigitalSales_Date_Placeholder"), autocomplete = "off" })@Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })</div><div class="col-md-6 form-group">@Html.TitleFor(m => m.EndDate, new { @class = "text-85 text-600 mb-1 d-block" })@Html.TextBoxFor(m => m.EndDate, "{0:dd/MM/yyyy}", new { @class = "form-control date-picker", placeholder = AppProcessor.Messagor.GetMessage("DigitalSales_Date_Placeholder"), autocomplete = "off" })@Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })</div></div>
    <div class="form-group mb-0">@Html.TitleFor(m => m.Note, new { @class = "text-85 text-600 mb-1 d-block" })@Html.TextAreaFor(m => m.Note, 2, 50, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesProduct_Note_Placeholder") })@Html.ValidationMessageFor(m => m.Note, "", new { @class = "text-danger" })</div>
</div></div>
