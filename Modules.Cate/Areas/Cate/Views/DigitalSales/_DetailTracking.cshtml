                                            <span class="badge bgc-primary-l4 text-primary-d2 border-1 brc-primary-m3 font-bold px-2 py-1">@todo.TrackingCode</span>
                                        </td>
                                        <td class="font-progress-cell">
                                            <span class="text-dark">@(string.IsNullOrEmpty(todo.AssignedUserName) ? "—" : Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(todo.AssignedUserName))</span>
                                        </td>
                                        <td class="text-center font-progress-cell">@todo.StartDate.ToString("dd/MM/yyyy")</td>
