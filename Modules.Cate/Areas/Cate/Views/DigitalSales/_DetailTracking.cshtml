                                                       title="@(todo.Status == 3 ? "Công việc đã hoàn thành" : "Công việc chưa hoàn thành")" />
                                                <span class="tree-todo-title @(todo.Status == 3 ? "text-line-through text-secondary-m1" : "")">@(todo.SortOrder > 0 ? $"{todo.SortOrder}. " : "")@Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(todo.TaskName)</span>

                                                @if (canEdit && isCurrentStatus && todo.Status != 3)
                                                {
                                                    <!-- DẤU (+) PHÍA SAU TÊN CÔNG VIỆC: THÊM CÔNG VIỆC CON (CẤP 5) -->
