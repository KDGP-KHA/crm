                                                    }
                                                </td>
                                                @if (canEdit)
                                                {
                                                    bool canReportSub = canEdit && sub.Status != 3 && (isQTHT || string.Equals(sub.CreatedBy, currentUserName, StringComparison.OrdinalIgnoreCase) || (sub.AssignedUserID.HasValue && sub.AssignedUserID.Value == currentUserId));
                                                    var subActions = new List<Core.Cate.Models.RM_DigitalSalesActionItem>();

                                                    if (canReportSub)
                                                    {
                                                        subActions.Add(new Core.Cate.Models.RM_DigitalSalesActionItem
                                                        {
                                                            Name = "Báo cáo tiến độ",
                                                            Icon = "fa fa-clipboard-check",
                                                            ItemClass = "item-report",
                                                            BtnClass = "ds-action-btn-report",
                                                            OnClick = $"openTrackingReportModal({sub.TrackingID}, {Model.DigitalSalesID});"
                                                        });
                                                    }

                                                    bool canEditSub = isQTHT || string.Equals(sub.CreatedBy, currentUserName, StringComparison.OrdinalIgnoreCase);
                                                    if (canEdit && isCurrentStatus && sub.Status != 3 && canEditSub)
                                                    {
                                                        subActions.Add(new Core.Cate.Models.RM_DigitalSalesActionItem
                                                        {
                                                            Name = "Chỉnh sửa công việc",
                                                            Icon = "fa fa-pencil-alt",
                                                            ItemClass = "item-edit",
                                                            BtnClass = "ds-action-btn-edit",
                                                            OnClick = $"openEditTodoModal({sub.TrackingID}, {Model.DigitalSalesID});"
