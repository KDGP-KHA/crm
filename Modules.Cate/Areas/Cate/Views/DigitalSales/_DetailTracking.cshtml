@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesModel
@{
    bool canEdit = ViewBag.CanEdit == true;
    bool isQTHT = ViewBag.IsQTHT == true;
    string currentUserName = User != null ? (User.UserName ?? "") : "";
    int currentUserId = User != null ? User.UserId : 0;
    var allTasks = Model.TrackingTasks ?? new List<Core.Cate.Models.RM_DigitalSalesTrackingModel>();
    var parentTasks = allTasks.Where(t => !t.ParentID.HasValue || t.ParentID.Value <= 0).ToList();
    var allTodoTasks = allTasks.Where(t => t.ParentID.HasValue && t.ParentID.Value > 0).ToList();
    
    // Tính tổng số lượng và hoàn thành (chỉ tính theo các công việc thực tế, loại trừ placeholder rỗng)
    int totalCount = allTasks.Count(t => !string.IsNullOrWhiteSpace(t.TaskName));
    int completedCount = allTasks.Count(t => !string.IsNullOrWhiteSpace(t.TaskName) && t.Status == 3);
}

<span id="partialTrackingProgress" class="d-none" data-completed="@completedCount" data-total="@totalCount"></span>

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_DetailTracking.css?v=@DateTime.Now.Ticks" />

<!-- HEADER CỦA TAB CHECKLIST -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap" style="gap: 10px;">
    <div class="d-flex align-items-center">
        <h6 class="text-orange font-weight-bold mb-0 text-110">
            <i class="fa fa-tasks mr-1"></i> Checklist
        </h6>
        <span class="badge badge-pill badge-warning ml-2 font-bold px-2 py-1" id="badgeChecklistSummary">@completedCount/@totalCount</span>
        <button type="button" class="btn btn-xs btn-white border-1 brc-primary-m2 text-primary-d2 radius-1 px-2 py-1 ml-2 shadow-sm font-bold btn-view-timeline" onclick="openStatusTimelineModal(@Model.DigitalSalesID);" title="Xem timeline cập nhật chuyển trạng thái">
            <i class="fa fa-stream mr-1 text-primary"></i> Xem timeline
        </button>
        <a href="@Url.Action("ExportChecklistExcel", "DigitalSales", new { area = "Cate", digitalSalesId = Model.DigitalSalesID })"
           class="btn btn-xs btn-white border-1 brc-green-m2 text-green-d2 radius-1 px-2 py-1 ml-2 shadow-sm font-bold btn-export-checklist"
           title="Tải toàn bộ cây Checklist (3 Sheet) về file Excel">
            <i class="fa fa-file-excel mr-1 text-success"></i> Tải checklist
        </a>
    </div>
    <div class="d-flex align-items-center flex-wrap" style="gap: 6px;">
        <button type="button" class="btn btn-xs btn-white border-1 brc-grey-l1 text-secondary-d1 radius-1 px-2 py-1 shadow-sm font-bold" id="btnExpandAllChecklist" onclick="toggleAllChecklistTree(true);">
            <i class="fa fa-expand-alt mr-1 text-primary"></i> Mở rộng tất cả
        </button>
        <button type="button" class="btn btn-xs btn-white border-1 brc-grey-l1 text-secondary-d1 radius-1 px-2 py-1 shadow-sm font-bold" id="btnCollapseAllChecklist" onclick="toggleAllChecklistTree(false);">
            <i class="fa fa-compress-alt mr-1 text-orange"></i> Thu gọn tất cả
        </button>
    </div>
</div>

<!-- BẢNG TREE GRID PHÂN CẤP 4 TẦNG: TRẠNG THÁI -> QUY TRÌNH -> TIẾN TRÌNH -> TODO LIST -->
<div class="table-responsive ds-tracking-responsive-wrapper">
    <table class="table table-bordered text-90 tree-table" id="tblTracking">
        <thead class="bgc-secondary-l1 text-secondary-d2">
            <tr>
                <th style="min-width: 400px;">Tên công việc / Đầu mục tiến trình</th>
                <th style="width: 130px;" class="text-center">Mã tiến trình</th>
                <th style="width: 150px;">Người thực hiện</th>
                <th style="width: 105px;" class="text-center">Bắt đầu</th>
                <th style="width: 115px;" class="text-center">Hạn chót</th>
                <th style="width: 95px;" class="text-center">Tổng ngày</th>
                <th style="width: 115px;" class="text-center">Trạng thái</th>
                <th style="width: 160px;" class="text-center">Hoàn thành</th>
                @if (canEdit)
                {
                    <th style="width: 105px;" class="text-center">Thao tác</th>
                }
            </tr>
        </thead>
        <tbody id="treeTrackingBody">
            @if (parentTasks != null && parentTasks.Count > 0)
            {
                var workflowCache = new Core.Cate.Caches.RM_DigitalSalesWorkflowCache();
                var allConfigStatuses = workflowCache.GetAllStatuses() ?? new List<Core.Cate.Models.RM_DigitalSalesStatusModel>();
                var statusConfigDict = allConfigStatuses.GroupBy(s => s.StatusID).ToDictionary(g => g.Key, g => g.First());

                var rawStatusGroups = parentTasks.GroupBy(t => new
                {
                    TimelineID = t.TimelineID ?? (t.StatusID ?? 0),
                    StatusID = t.StatusID ?? 0,
                    StatusName = !string.IsNullOrEmpty(t.SalesStatusName) ? t.SalesStatusName : "Trạng thái",
                    ProcessCountOfStatus = t.ProcessCountOfStatus
                }).ToList();

                var statusGroups = rawStatusGroups
                    .OrderBy(g => statusConfigDict.ContainsKey(g.Key.StatusID) ? statusConfigDict[g.Key.StatusID].BusinessType : (byte)255)
                    .ThenBy(g => statusConfigDict.ContainsKey(g.Key.StatusID) ? statusConfigDict[g.Key.StatusID].SortOrder : 999)
                    .ThenBy(g => {
                        var tl = Model.Timelines?.FirstOrDefault(x => x.TimelineID == g.Key.TimelineID);
                        return tl != null ? tl.ActionDate : DateTime.MinValue;
                    })
                    .ThenBy(g => g.Key.TimelineID)
                    .ToList();

                var latestCurrentStatusGroup = statusGroups.LastOrDefault(g => g.Key.StatusID == Model.StatusID);

                int statusIdx = 1;
                foreach (var stGroup in statusGroups)
                {
                    bool isCurrentStatus = (latestCurrentStatusGroup != null && stGroup.Key.TimelineID == latestCurrentStatusGroup.Key.TimelineID);
                    string statusNodeId = $"status_node_{stGroup.Key.StatusID}_{stGroup.Key.TimelineID}";
                    int statusTaskCount = stGroup.Count(t => !string.IsNullOrWhiteSpace(t.TaskName));
                    int statusTodoCount = stGroup.Where(t => !string.IsNullOrWhiteSpace(t.TaskName)).Sum(p => p.TodoList?.Count ?? 0);

                    // Xác định xem trạng thái này có xuất hiện nhiều lần không (1 trạng thái có thể xuất hiện nhiều lần)
                    var occurrencesOfThisStatus = statusGroups.Where(g => g.Key.StatusID == stGroup.Key.StatusID).ToList();
                    int occurrenceIndex = occurrencesOfThisStatus.IndexOf(stGroup) + 1;
                    string occurrenceSuffix = occurrencesOfThisStatus.Count > 1 ? $" (Lần {occurrenceIndex})" : "";

                    // Thông tin người chuyển trạng thái và thời gian chuyển
                    var timeline = Model.Timelines?.FirstOrDefault(tl => tl.TimelineID == stGroup.Key.TimelineID);
                    if (timeline == null && stGroup.Key.StatusID > 0)
                    {
                        timeline = Model.Timelines?.OrderBy(tl => tl.ActionDate).ThenBy(tl => tl.TimelineID)
                            .Skip(occurrenceIndex - 1)
                            .FirstOrDefault(tl => tl.ToStatusID == stGroup.Key.StatusID)
                            ?? Model.Timelines?.LastOrDefault(tl => tl.ToStatusID == stGroup.Key.StatusID);
                    }

                    string transitionUser = timeline != null 
                        ? (!string.IsNullOrEmpty(timeline.ActionByName) ? timeline.ActionByName : timeline.ActionBy) 
                        : (!string.IsNullOrEmpty(Model.CreatedByName) ? Model.CreatedByName : Model.CreatedBy);
                    DateTime? transitionDate = timeline != null ? (DateTime?)timeline.ActionDate : (DateTime?)Model.CreatedDate;

                    <!-- ========================================================================= -->
                    <!-- CẤP 1: TRẠNG THÁI (BOLD ĐẬM, FONT CHỮ TO)                                 -->
                    <!-- ========================================================================= -->
                    <tr class="tree-row tree-status-row" data-node="@statusNodeId" data-level="1" data-expanded="true">
                        <td colspan="@(canEdit ? 9 : 8)" class="cursor-pointer py-25 px-3" onclick="toggleTreeNode('@statusNodeId');">
                            <div class="d-flex align-items-center justify-content-between flex-wrap" style="gap: 8px;">
                                <div class="d-flex align-items-center flex-wrap" style="gap: 6px;">
                                    <i class="fa fa-chevron-down tree-toggle-icon text-primary mr-2" id="icon_@statusNodeId"></i>
                                    <span class="tree-status-title">@Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(stGroup.Key.StatusName)@occurrenceSuffix</span>
                                    <span class="badge badge-primary badge-pill ml-1 tree-status-task-count font-bold">@statusTaskCount tiến trình@(statusTodoCount > 0 ? $", {statusTodoCount} việc nhỏ" : "")</span>
                                    @if (!string.IsNullOrEmpty(transitionUser) || transitionDate.HasValue)
                                    {
                                        <span class="badge bgc-white text-dark-m1 border-1 brc-grey-m3 px-2 py-1 ml-2 font-normal text-85 shadow-none d-inline-flex align-items-center" title="Người chuyển trạng thái và thời gian chuyển">
                                            @if (!string.IsNullOrEmpty(transitionUser))
                                            {
                                                <span class="text-dark font-bold mr-2">
                                                    <i class="fa fa-user-circle text-primary mr-1"></i>@Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(transitionUser)
                                                </span>
                                            }
                                            @if (transitionDate.HasValue)
                                            {
                                                <span class="text-secondary">
                                                    <i class="far fa-clock text-success mr-1"></i>@transitionDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            }
                                        </span>
                                    }
                                </div>
                                <span class="text-secondary-m1 text-80 font-italic mr-2">
                                    <i class="fa fa-info-circle mr-1"></i>Bấm để thu gọn/mở rộng
                                </span>
                            </div>
                        </td>
                    </tr>

                    var procGroups = stGroup.GroupBy(t => new
                    {
                        ProcessID = t.ProcessID ?? 0,
                        ProcessName = !string.IsNullOrEmpty(t.ProcessName) ? t.ProcessName : "Quy trình thực hiện"
                    }).OrderBy(g => g.Key.ProcessID).ToList();

                    int procIdx = 1;
                    foreach (var prGroup in procGroups)
                    {
                        string procNodeId = $"{statusNodeId}_proc_{prGroup.Key.ProcessID}";
                        var realTasks = prGroup.Where(t => !string.IsNullOrWhiteSpace(t.TaskName)).ToList();
                        int realTaskCount = realTasks.Count;

                        <!-- ========================================================================= -->
                        <!-- CẤP 2: QUY TRÌNH (TIÊU ĐỀ: QUY TRÌNH ... CÓ CÂY BÚT CHÌ NẾU SỐ QT >= 2)  -->
                        <!-- ========================================================================= -->
                        <tr class="tree-row tree-process-row" data-node="@procNodeId" data-parent="@statusNodeId" data-level="2" data-expanded="true">
                            <td colspan="@(canEdit ? 9 : 8)" class="cursor-pointer py-2 px-4" onclick="toggleTreeNode('@procNodeId');">
                                <div class="d-flex align-items-center justify-content-between flex-wrap" style="gap: 6px;">
                                    <div class="d-flex align-items-center flex-wrap" style="gap: 6px;">
                                        <i class="fa fa-chevron-down tree-toggle-icon text-warning-d2 mr-1" id="icon_@procNodeId"></i>
                                        <span class="tree-process-title">QUY TRÌNH: @(Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(prGroup.Key.ProcessName).ToUpper())</span>
                                        @if (stGroup.Key.ProcessCountOfStatus >= 2 && canEdit && isCurrentStatus)
                                        {
                                            <a href="javascript:void(0);" class="btn-edit-process" onclick="event.stopPropagation(); openChangeProcessModal(@Model.DigitalSalesID, @stGroup.Key.StatusID, @prGroup.Key.ProcessID);" title="Đổi quy trình thực hiện cho trạng thái này (@stGroup.Key.ProcessCountOfStatus quy trình)">
                                                <i class="fa fa-pencil-alt"></i>
                                            </a>
                                        }
                                        <span class="badge @(realTaskCount > 0 ? "badge-light-warning text-warning-d3" : "badge-light-secondary text-secondary-d3") border-1 font-bold tree-process-task-count">
                                            @realTaskCount tiến trình
                                        </span>
                                        @if (stGroup.Key.ProcessCountOfStatus >= 2 && isCurrentStatus)
                                        {
                                            if (canEdit)
                                             {
                                                <a href="javascript:void(0);" class="badge badge-can-change-process ml-1" onclick="event.stopPropagation(); openChangeProcessModal(@Model.DigitalSalesID, @stGroup.Key.StatusID, @prGroup.Key.ProcessID);" title="Bấm để đổi quy trình thực hiện cho trạng thái này (@stGroup.Key.ProcessCountOfStatus quy trình)">
                                                    <i class="fa fa-exchange-alt mr-1"></i>Có thể đổi quy trình
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge badge-can-change-process ml-1">
                                                    <i class="fa fa-exchange-alt mr-1"></i>Có thể đổi quy trình
                                                </span>
                                            }
                                        }
                                    </div>
                                    <div class="d-flex align-items-center flex-wrap ml-auto" style="gap: 6px;">
                                        @if (canEdit && isCurrentStatus && prGroup.Key.ProcessID > 0)
                                        {
                                            <button type="button" class="btn btn-xs btn-success font-weight-bold px-2 py-05 ml-1 radius-1 shadow-sm btn-add-progress-header" onclick="event.stopPropagation(); openAddProgressToProcessModal(@Model.DigitalSalesID, @prGroup.Key.ProcessID, '@Html.Raw(HttpUtility.JavaScriptStringEncode(prGroup.Key.ProcessName))', @stGroup.Key.TimelineID);" title="Thêm tiến trình mới vào quy trình này">
                                                <i class="fa fa-plus mr-1"></i> Thêm tiến trình
                                            </button>
                                            <button type="button" class="btn btn-xs btn-primary font-weight-bold px-2 py-05 ml-1 radius-1 shadow-sm btn-import-progress-header" onclick="event.stopPropagation(); openImportProgressModal(@Model.DigitalSalesID, @prGroup.Key.ProcessID, @stGroup.Key.TimelineID);" title="Import danh sách tiến trình vào quy trình này">
                                                <i class="fa fa-file-import mr-1"></i> Import tiến trình
                                            </button>
                                            if (realTaskCount > 0)
                                            {
                                                <button type="button" class="btn btn-xs btn-info font-weight-bold px-2 py-05 ml-1 radius-1 shadow-sm btn-import-todo-header" onclick="event.stopPropagation(); openImportTodoModal(@Model.DigitalSalesID, @prGroup.Key.ProcessID, @stGroup.Key.TimelineID);" title="Import danh sách công việc con vào tiến trình của quy trình này">
                                                    <i class="fa fa-file-excel mr-1"></i> Import công việc
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>

                        if (realTaskCount > 0)
                        {
                            int taskIdx = 1;
                            foreach (var task in realTasks.OrderBy(p => p.SortOrder).ThenBy(p => p.StartDate).ThenBy(p => p.TrackingID))
                            {
                            string taskNodeId = $"{procNodeId}_task_{task.TrackingID}";
                            bool isOverdue = task.IsOverdue == 1;

                            <!-- ========================================================================= -->
                            <!-- CẤP 3: TIẾN TRÌNH (CÓ NGÀY BẮT ĐẦU, TỔNG NGÀY VÀ DẤU (+) SAU TÊN)        -->
                            <!-- ========================================================================= -->
                            <tr class="tree-row tree-progress-row" data-node="@taskNodeId" data-parent="@procNodeId" data-root="@statusNodeId" data-level="3" data-expanded="true">
                                <td class="pl-4 font-progress-cell">
                                    <div class="d-flex align-items-center flex-wrap">
                                        <input type="checkbox" class="tree-checkbox chk-task mr-2" id="chk_task_@task.TrackingID"
                                               @(task.Status == 3 ? "checked" : "")
                                               onclick="return false;" onkeydown="return false;" tabindex="-1"
                                               title="@(task.Status == 3 ? "Tiến trình đã hoàn thành" : "Tiến trình chưa hoàn thành")" />
                                        <span class="tree-progress-title">@(task.SortOrder > 0 ? $"{task.SortOrder}." : $"{taskIdx}.") @Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(task.TaskName)</span>

                                        @if (canEdit && isCurrentStatus && task.Status != 3)
                                        {
                                            <!-- DẤU (+) PHÍA SAU TÊN TIẾN TRÌNH: THÊM TODO LIST -->
                                            <a href="javascript:void(0);" class="btn-add-todo ml-1" onclick="openAddTodoModal(@task.TrackingID, @Model.DigitalSalesID);" title="Thêm công việc con (Todo list)">
                                                <i class="fa fa-plus"></i>
                                            </a>
                                        }

                                        @if (task.TodoList != null && task.TodoList.Count > 0)
                                        {
                                            <span class="badge badge-secondary badge-pill text-75 font-bold ml-2 cursor-pointer" onclick="toggleTreeNode('@taskNodeId');">
                                                <i class="fa fa-list-ul mr-1"></i>@task.TodoList.Count việc
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center font-progress-cell"><span class="badge bgc-primary-l4 text-primary-d2 border-1 brc-primary-m3 font-bold px-2 py-1">@task.TrackingCode</span></td>
                                <td class="font-progress-cell"><span class="text-dark">@(string.IsNullOrEmpty(task.AssignedUserName) ? "—" : Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(task.AssignedUserName))</span></td>
                                <td class="text-center font-progress-cell">@task.StartDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center font-progress-cell"><span class="@(isOverdue ? "text-danger font-bold" : "text-dark")">@task.MaxDeadline.ToString("dd/MM/yyyy")</span></td>
                                <td class="text-center font-progress-cell"><span class="badge badge-light-secondary font-bold">@task.EffectiveDurationDays ngày</span></td>
                                <td class="text-center font-progress-cell">
                                    @if (task.Status == 3)
                                    {
                                        <span class="badge badge-success px-2 font-bold">Hoàn thành</span>
                                    }
                                    else if (task.Status == 2)
                                    {
                                        <span class="badge badge-warning px-2 font-bold">Đang làm</span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="badge badge-danger px-2 font-bold">Quá hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2">Chưa làm</span>
                                    }
                                </td>
                                <td class="text-center font-progress-cell">
                                    @if (task.Status == 3)
                                    {
                                        string completedUser = !string.IsNullOrEmpty(task.CompletedByName) ? Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(task.CompletedByName) : (!string.IsNullOrEmpty(task.LastModifiedByName) ? Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(task.LastModifiedByName) : (!string.IsNullOrEmpty(task.CreatedByName) ? Core.Cate.Biz.RM_DigitalSalesBiz.FixVietnameseMojibake(task.CreatedByName) : "—"));
                                        DateTime? completedAt = task.CompletedDate.HasValue ? task.CompletedDate : (task.LastModifiedDate.HasValue ? task.LastModifiedDate : (DateTime?)task.CreatedDate);
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="text-dark font-weight-bold text-85">@completedUser</span>
                                            <span class="text-secondary text-80">
                                                <i class="fa fa-clock text-success mr-1"></i>@(completedAt.HasValue ? completedAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </td>
                                @if (canEdit)
                                {
                                    bool canReportTask = canEdit && task.Status != 3 && (isQTHT || string.Equals(task.CreatedBy, currentUserName, StringComparison.OrdinalIgnoreCase) || (task.AssignedUserID.HasValue && task.AssignedUserID.Value == currentUserId));
                                    var taskActions = new List<Core.Cate.Models.RM_DigitalSalesActionItem>();

                                    if (canReportTask)
                                    {
                                        taskActions.Add(new Core.Cate.Models.RM_DigitalSalesActionItem
                                        {
                                            Name = "Báo cáo tiến độ",
                                            Icon = "fa fa-clipboard-check",
                                            ItemClass = "item-report",
                                            BtnClass = "ds-action-btn-report",
                                            OnClick = $"openTrackingReportModal({task.TrackingID}, {Model.DigitalSalesID});"
                                        });
                                    }

                                    if (canEdit && isCurrentStatus && task.Status != 3)
                                    {
                                        taskActions.Add(new Core.Cate.Models.RM_DigitalSalesActionItem
                                        {
                                            Name = "Thêm công việc con",
                                            Icon = "fa fa-plus",
                                            ItemClass = "item-add",
                                            BtnClass = "ds-action-btn-add",
                                            OnClick = $"openAddTodoModal({task.TrackingID}, {Model.DigitalSalesID});"
                                        });

                                        bool canEditTask = isQTHT || string.Equals(task.CreatedBy, currentUserName, StringComparison.OrdinalIgnoreCase);
                                        if (canEditTask)
                                        {
                                            taskActions.Add(new Core.Cate.Models.RM_DigitalSalesActionItem
                                            {
                                                Name = "Chỉnh sửa tiến trình",
                                                Icon = "fa fa-pencil-alt",
                                                ItemClass = "item-edit",
                                                BtnClass = "ds-action-btn-edit",
                                                OnClick = $"openEditTrackingModal({task.TrackingID}, {Model.DigitalSalesID});"
                                            });
                                        }
                                    }

                                    if (canEdit && task.Status == 3)
                                    {
                                        taskActions.Add(new Core.Cate.Models.RM_DigitalSalesActionItem
                                        {
                                            Name = "Mở khóa tiến trình",
                                            Icon = "fa fa-unlock-alt",
                                            ItemClass = "item-unlock",
                                            BtnClass = "ds-action-btn-unlock",
                                            OnClick = $"openUnlockProgressModal({task.TrackingID}, {Model.DigitalSalesID});"
                                        });
                                    }

                                    if (canEdit)
                                    {
                                        taskActions.Add(new Core.Cate.Models.RM_DigitalSalesActionItem
                                        {
                                            Name = "Xem lịch sử log",
                                            Icon = "fa fa-history",
                                            ItemClass = "item-log",
                                            BtnClass = "ds-action-btn-log",
                                            OnClick = $"openTrackingLogsModal({task.TrackingID}, {Model.DigitalSalesID});"
                                        });
                                    }

                                    bool canDeleteTask = (isQTHT || (task.Status != 3 && string.Equals(task.CreatedBy, currentUserName, StringComparison.OrdinalIgnoreCase))) && isCurrentStatus;
                                    if (canDeleteTask)
                                    {
                                        taskActions.Add(new Core.Cate.Models.RM_DigitalSalesActionItem
                                        {
                                            Name = "Xóa tiến trình",
                                            Icon = "fa fa-trash-alt",
                                            ItemClass = "item-delete",
                                            BtnClass = "ds-action-btn-delete",
                                            OnClick = $"actionDeleteTracking({task.TrackingID}, {Model.DigitalSalesID});"
                                        });
                                    }

                                    <td class="text-center text-nowrap font-progress-cell">
                                        @if (taskActions.Count == 1)
                                        {
                                            <div class="ds-action-group">
                                                <a href="javascript:void(0);" class="ds-action-btn @taskActions[0].BtnClass" onclick="@taskActions[0].OnClick" title="@taskActions[0].Name">
                                                    <i class="@taskActions[0].Icon"></i>
                                                </a>
                                            </div>
                                        }
                                        else if (taskActions.Count >= 2)
                                        {
                                            <div class="dropdown ds-action-dropdown">
                                                <button type="button" class="btn btn-xs btn-white border-1 brc-grey-m2 text-secondary-d2 dropdown-toggle radius-round ds-action-dropdown-btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Thao tác (@taskActions.Count chức năng)">
                                                    <i class="fa fa-ellipsis-v"></i>
                                                </button>
                                                <div class="dropdown-menu dropdown-menu-right ds-action-dropdown-menu">
                                                    @foreach (var act in taskActions)
                                                    {
                                                        <a class="dropdown-item ds-action-dropdown-item @act.ItemClass" href="javascript:void(0);" onclick="@act.OnClick">
                                                            <i class="@act.Icon"></i>
                                                            <span>@act.Name</span>
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">—</span>
                                        }
                                    </td>
                                }
                            </tr>

                            <!-- ========================================================================= -->
                            <!-- CẤP 4: TODO LIST TRONG TIẾN TRÌNH (CÔNG VIỆC NHỎ, DEADLINE <= START + TỔNG)-->
                            <!-- ========================================================================= -->
                            if (task.TodoList != null && task.TodoList.Count > 0)
                            {
                                foreach (var todo in task.TodoList.OrderBy(c => c.SortOrder).ThenBy(c => c.StartDate).ThenBy(c => c.TrackingID))
                                {
                                    string todoNodeId = $"{taskNodeId}_todo_{todo.TrackingID}";
                                    bool todoOverdue = todo.IsOverdue == 1;
                                    <tr class="tree-row tree-todo-row" data-node="@todoNodeId" data-parent="@taskNodeId" data-subparent="@procNodeId" data-root="@statusNodeId" data-level="4" data-expanded="true">
                                        <td style="padding-left: 48px;" class="font-progress-cell">
                                            <div class="d-flex align-items-center flex-wrap">
                                                <span class="tree-todo-branch mr-2">└─</span>
                                                <input type="checkbox" class="tree-checkbox chk-todo mr-2" id="chk_todo_@todo.TrackingID"
                                                       @(todo.Status == 3 ? "checked" : "")
