@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_DigitalSalesSearchModel

@{
    var excludedStatusIds = Model.ExcludedStatusIDs ?? new List<int>();
    var statusItems = Model.StatusItems ?? new List<Core.Cate.Models.RM_DigitalSalesStatusModel>();

    var checkedCount = statusItems.Count(x => !excludedStatusIds.Contains(x.StatusID));
    var totalCount = statusItems.Count;

    var defaultText = checkedCount == totalCount
        ? "Tất cả"
        : (checkedCount == 0 ? "Chưa chọn trạng thái" : $"{checkedCount} trạng thái được chọn");
}

<div class="Search search-opportunity card mb-3" id="SearchDigitalSales">
    <div class="card-header bgc-primary-d1">
        <div class="card-title text-white">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Search")
        </div>
    </div>
    <div class="card-body p-2 d-flex align-items-end flex-wrap">
        @Html.HiddenFor(model => model.CustomerID, new { id = "CustomerID" })

        <div class="Search_Box keyWord" style="flex: 1 1 280px; max-width: 420px;">
            @Html.TitleFor(model => model.Keyword, new { @class = "font-bold text-sm-right" })
            @Html.TextBoxFor(model => model.Keyword, new { @class = "form-control", id = "Keyword", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Keyword_Placeholder") })
        </div>

        <div class="Search_Box" style="min-width: 140px;">
            @Html.TitleFor(model => model.BusinessType, new { @class = "font-bold text-sm-right" })
            <div>
                <select id="BusinessType" name="BusinessType" class="form-control" onchange="filterStatusListByBusinessType(this.value);">
                    <option value="">@AppProcessor.Messagor.GetMessage("DigitalSalesSearch_BusinessType_AllOption")</option>
                    <option value="1" @(Model.BusinessType == 1 ? "selected" : "")>@AppProcessor.Messagor.GetMessage("DigitalSales_BusinessType_Opportunity")</option>
                    <option value="2" @(Model.BusinessType == 2 ? "selected" : "")>@AppProcessor.Messagor.GetMessage("DigitalSales_BusinessType_Project")</option>
                </select>
            </div>
        </div>

        <div class="position-relative status-filter-wrapper Search_Box" style="min-width: 200px;">
            <label class="font-bold text-sm-right status-label">
                @AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Status_Label", "Trạng thái")
            </label>

            <!-- BUTTON -->
            <div id="statusDropdownButton"
                 class="form-control d-flex justify-content-between align-items-center cursor-pointer">
                <span id="statusDropdownText" class="text-truncate">
                    @defaultText
                </span>
                <i class="fas fa-caret-down ml-2"></i>
            </div>

            <!-- DROPDOWN -->
            <div id="statusDropdownMenu"
                 class="border bg-white shadow-sm rounded p-2">
                <!-- CHECK ALL -->
                <div class="mb-2 border-bottom pb-2">
                    <label class="mb-0 w-100 cursor-pointer">
                        <input type="checkbox"
                               id="checkAllStatus"
                               @(checkedCount == totalCount ? "checked" : "") />
                        <span class="ml-1 font-weight-bold">
                            Tất cả
                        </span>
                    </label>
                </div>

                <!-- ITEMS -->
                @foreach (var item in statusItems)
                {
                    var isChecked = !excludedStatusIds.Contains(item.StatusID);
                    var typePrefix = item.BusinessType == 1 ? "[Cơ hội]" : "[Dự án]";

                    <div class="mb-1 status-item-row" data-businesstype="@item.BusinessType">
                        <label class="mb-0 w-100 cursor-pointer text-nowrap">
                            <input type="checkbox"
                                   class="status-item"
                                   value="@item.StatusID"
                                   data-businesstype="@item.BusinessType"
                                   @(isChecked ? "checked" : "") />
                            <span class="ml-1 text-85">
                                <span class="text-secondary opacity-75 font-bold mr-1">@typePrefix</span>@item.StatusName
                            </span>
                        </label>
                    </div>
                }
            </div>
        </div>

        <!-- 1. Toggle: Trọng điểm (Tách riêng biệt, switch to hơn, text đen, không icon) -->
        <div class="Search_Box" style="min-width: 140px;">
            <label class="font-bold d-block text-sm-right" style="visibility: hidden; font-size: 13px; margin: 0; height: 18px;">&nbsp;</label>
            <div class="d-flex align-items-center" style="height: 32px;">
                <div class="custom-control custom-switch custom-switch-lg" title="Lọc các dự án trọng điểm">
                    <input type="checkbox" class="custom-control-input cursor-pointer" id="chkFilterKeyProject">
                    <label class="custom-control-label font-bold text-dark cursor-pointer select-none mb-0" for="chkFilterKeyProject" id="lblFilterKeyProject">
                        Trọng điểm
                    </label>
                </div>
            </div>
        </div>

        <!-- 2. Toggle: Đang quan tâm (Tách riêng biệt, switch to hơn, text đen, không icon) -->
        <div class="Search_Box" style="min-width: 160px;">
            <label class="font-bold d-block text-sm-right" style="visibility: hidden; font-size: 13px; margin: 0; height: 18px;">&nbsp;</label>
            <div class="d-flex align-items-center" style="height: 32px;">
                <div class="custom-control custom-switch custom-switch-lg" title="Lọc các cơ hội/dự án bạn đang quan tâm">
                    <input type="checkbox" class="custom-control-input cursor-pointer" id="chkFilterFollowed">
                    <label class="custom-control-label font-bold text-dark cursor-pointer select-none mb-0" for="chkFilterFollowed" id="lblFilterFollowed">
                        Đang quan tâm
                    </label>
                </div>
            </div>
        </div>

        <!-- Vạch phân tách hàng chuẩn giao diện: Hàng 1 (Tìm kiếm & Tiêu chí) và Hàng 2 (Đơn vị & Thời gian & Nút bấm) -->
        <div class="w-100 d-none d-lg-block my-1"></div>

        <div class="Search_Box Dropdown">
            @Html.TitleFor(model => model.DepartmentID, new { @class = "font-bold" })
            @Html.DropDownListFor(model => model.DepartmentID, Model.ListDepartment, AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Department_Option"), new { @class = "form-control", id = "DepartmentID" })
        </div>

        <div class="Search_Box Dropdown">
            @Html.TitleFor(model => model.EmployeeID, new { @class = "font-bold" })
            @Html.DropDownListFor(model => model.EmployeeID, Model.ListEmployee, AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Employee_Option"), new { @class = "form-control", id = "EmployeeID" })
        </div>

        <div class="d-flex">
            <div class="Search_Box">
                @Html.TitleFor(model => model.FromDate, new { @class = "font-bold text-sm-right" })
                <div class="input-group date" id="dpFromDate" style="width: 135px">
                    @Html.TextBoxFor(model => model.FromDate, new { @class = "form-control", id = "FromDate", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Date_Placeholder"), autocomplete = "off" })
                    <div class="input-group-append">
                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    </div>
                </div>
            </div>

            <div class="Search_Box">
                @Html.TitleFor(model => model.ToDate, new { @class = "font-bold text-sm-right" })
                <div class="input-group date" id="dpToDate" style="width: 135px">
                    @Html.TextBoxFor(model => model.ToDate, new { @class = "form-control", id = "ToDate", placeholder = AppProcessor.Messagor.GetMessage("DigitalSalesSearch_Date_Placeholder"), autocomplete = "off" })
                    <div class="input-group-append">
                        <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="Group Group_button d-inline-flex align-items-center flex-nowrap" style="padding-top: 10px; padding-left: 5px; flex-shrink: 0;">
            <div class="Search_button mr-2">
                <button type="button" class="btn btn-primary text-nowrap" onclick="reloadSalesTable();" style="min-width: 105px; width: auto; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="fa fa-search-plus mr-1"></i>@AppProcessor.Messagor.GetMessage("Label_Search")
                </button>
            </div>

            <div class="Search_button mr-2">
                <button type="button" class="btn btn-default btn-outline-secondary text-nowrap" onclick="resetSalesSearch();" style="min-width: 95px; width: auto; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="fa fa-undo mr-1"></i>Đặt lại
                </button>
            </div>

            <div class="Search_button">
                <button type="button" class="btn btn-warning font-bold text-nowrap shadow-sm" id="btnExportDigitalSales" onclick="exportDigitalSales();" style="min-width: 140px; width: auto; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; padding: 2px 14px;" title="Tải danh sách theo điều kiện tìm kiếm">
                    <i class="fa fa-download mr-1"></i>Tải danh sách
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    window._excludedStatusIds = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(excludedStatusIds));

    $(document).ready(function () {
        if (typeof updateStatusDropdownText === 'function') {
            updateStatusDropdownText();
        }

        if ($.fn.datepicker) {
            $('#dpFromDate').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'vi'
            });
            $('#dpToDate').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true,
                language: 'vi'
            });
        }

        $('#SearchDigitalSales').on('keydown', 'input, select', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (typeof reloadSalesTable === 'function') {
                    reloadSalesTable();
                }
            }
        });

        $('#SearchDigitalSales').on('change', 'select:not(#DepartmentID):not(#BusinessType)', function () {
            if (typeof reloadSalesTable === 'function') {
                reloadSalesTable();
            }
        });

        // Lọc danh sách checkbox trạng thái theo Loại hình (Cơ hội / Dự án)
        $('#BusinessType').change(function () {
            var businessType = $(this).val();
            if (typeof filterStatusListByBusinessType === 'function') {
                filterStatusListByBusinessType(businessType);
            }
        });

        // Load danh sách nhân sự phụ trách (AM) theo phòng ban thuộc TTKDGP
        $('#DepartmentID').change(function () {
            var departmentId = $(this).val();
            var $employee = $('#EmployeeID');

            $employee.empty().append('<option value="">-- Chọn nhân viên --</option>');

            $.get('/Cate/DigitalSales/GetEmployeesByDepartment', {
                departmentId: departmentId ? departmentId : 0
            }, function (data) {
                if (data && data.length > 0) {
                    $.each(data, function (i, item) {
                        $employee.append(
                            $('<option>').val(item.Value).text(item.Text)
                        );
                    });
                }
                $employee.trigger("chosen:updated");
                if ($.fn.select2) {
                    $employee.trigger("change.select2");
                }
                if (typeof reloadSalesTable === 'function') {
                    reloadSalesTable();
                }
            });
        });
    });
</script>

<link rel="stylesheet" href="~/Areas/Cate/Views/DigitalSales/_Search.css?v=@DateTime.Now.Ticks" />
