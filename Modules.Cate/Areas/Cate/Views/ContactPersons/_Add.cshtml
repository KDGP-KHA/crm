@using TSFramework.Libs.Processors
@model Core.Cate.Models.RM_ContactPersonsModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("ContactPersonal_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}
@section FormType{
    primary
}
@section FormIcon{
    <i class="fa fa-plus"></i>
}
@section FormBody{
    @using (Ajax.BeginForm("Add", "ContactPersons", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ContactPersons_OnProcessSuccess(data, 'AddContactPersons')"
    }, new { @class = "form-horizontal", id = "AddContactPersons" }))
    {
        <div id="bodyForm">
            @Html.Partial("_ContactPersons", Model)
        </div>
    }
}
@section ContinueForm{
}