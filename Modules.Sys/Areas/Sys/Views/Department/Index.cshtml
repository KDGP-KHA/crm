@using TSFramework.Libs.Extensions
@using TSFramework.Libs.Processors
@{
    ViewBag.Title = Title = AppProcessor.Messagor.GetMessage("Department_Title") ?? "PhÃ²ng ban";
}

@section PageTitle
{
    @Title
}

@section PageAction
{
    @Html.Button(true,
    "AddDepartment",
    Url.Action("Add", new { area = "Sys" }),
    "<i class='fa fa-plus'></i>",
    AppProcessor.Messagor.GetMessage("Button_Add") ?? "ThÃªm",
    new {
        data_width = "800px",
        @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right"
    })
}

@Html.Partial("_Search")

<div class="mt-1">
    <div class="card dcard">
        <div class="col-sm-12 table-responsive-md">
            <table id="tblDepartment"
                   class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table"
                   width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Deparment_Name_Label")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Deparment_Code_Label")</th>
                        <th class="text-center">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>

                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Sys/Views/Department/Department.js?v=" + DateTime.Now.Ticks)"></script>
}