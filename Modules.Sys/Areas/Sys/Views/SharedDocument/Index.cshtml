@using TSFramework.Libs.Processors
@using TSFramework.Libs.Extensions
@model Core.Sys.Models.SharedDocumentSearchModel
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("SharedDoc_Title");
}

@section PageTitle {
    @ViewBag.Title
}

@section PageAction {
    <span class="badge badge-lg bgc-primary-l3 text-primary-d2 border-1 brc-primary-m3 mr-2">
        <i class="fa fa-folder-open mr-1"></i> @AppProcessor.Messagor.GetMessage("SharedDoc_Badge_Title")
    </span>
    @Html.Button(
        true,
        "AddSharedDocument",
        Url.Action("Add", new { area = "Sys" }),
        "<i class='fa fa-upload mr-1'></i>",
        AppProcessor.Messagor.GetMessage("SharedDoc_Upload_Button"),
        new
        {
            @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90",
            data_width = "800px"
        }
    )
}

<div class="mt-1">
    @Html.Partial("_Search", Model)
</div>

<div class="mt-3">
    <div class="card dcard">
        <div class="card-header bgc-transparent pb-0 border-0">
            <h5 class="card-title text-110 font-bold text-primary-d2 mb-0">
                <i class="fa fa-list-alt mr-1"></i> @AppProcessor.Messagor.GetMessage("SharedDoc_List_Title")
            </h5>
        </div>
        <div class="card-body p-2 table-responsive-md">
            <table id="DSSharedDocument" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="text-center th-stt">@AppProcessor.Messagor.GetMessage("SharedDoc_Col_No")</th>
                        <th class="th-docname">@AppProcessor.Messagor.GetMessage("SharedDoc_Col_Name")</th>
                        <th class="th-category">@AppProcessor.Messagor.GetMessage("SharedDoc_Col_Category")</th>
                        <th class="th-fileinfo">@AppProcessor.Messagor.GetMessage("SharedDoc_Col_FileInfo")</th>
                        <th class="text-center th-downloadcount">@AppProcessor.Messagor.GetMessage("SharedDoc_Col_Downloads")</th>
                        <th class="th-uploader">@AppProcessor.Messagor.GetMessage("SharedDoc_Col_CreatedBy")</th>
                        <th class="text-center th-actions">@AppProcessor.Messagor.GetMessage("SharedDoc_Col_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript {
    <link rel="stylesheet" href="~/Areas/Sys/Views/SharedDocument/SharedDocument.css?v=@DateTime.Now.Ticks" />
    <link rel="stylesheet" href="~/Contents/SharedDocument.css?v=@DateTime.Now.Ticks" />
    <script src="~/Areas/Sys/Views/SharedDocument/SharedDocument.js?v=@DateTime.Now.Ticks"></script>
}