@using TSFramework.Libs.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit") ?? "Cập nhật {0}", AppProcessor.Messagor.GetMessage("Position_Title") ?? "Chức vụ");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("Edit", "Position", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Position_OnProcessSuccess(data, 'EditPosition')"
    }, new { @class = "form-horizontal", id = "EditPosition" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Position")
        </div>
    }
}
